---
// Bouton WhatsApp premium - Élégant avec bulle d'accroche subtile
const whatsappNumber = "33660152737";
const whatsappMessage = encodeURIComponent("Bonjour, je souhaite réserver un VTC");
// Par défaut wa.me (excellent pour mobile)
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<!-- Container WhatsApp avec bulle -->
<div class="whatsapp-container" id="whatsapp-container">
  <!-- Bulle d'accroche -->
  <div class="whatsapp-bubble" id="whatsapp-bubble">
    <button class="bubble-close" id="bubble-close" aria-label="Fermer" type="button">×</button>
    <span class="bubble-icon">💬</span>
    <p class="bubble-text">
      <strong>Besoin d'un VTC ?</strong><br>
      <span class="bubble-highlight">Réponse en 5 min</span>
    </p>
  </div>
  
  <!-- Bouton WhatsApp principal -->
  <a 
    href={whatsappUrl}
    id="main-whatsapp-btn"
    class="whatsapp-button"
    aria-label="Contacter ECOFUNDRIVE par WhatsApp"
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="pulse-ring"></span>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" fill="currentColor"/>
    </svg>
    <span class="whatsapp-text">Réserver</span>
  </a>
</div>

<style>
  .whatsapp-container {
    position: fixed;
    bottom: 100px;
    right: 24px;
    z-index: 9998;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }
  
  /* Bulle d'accroche */
  .whatsapp-bubble {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: white;
    padding: 14px 18px;
    border-radius: 16px;
    border-bottom-right-radius: 4px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 220px;
    position: relative;
    animation: bubbleFadeIn 0.5s ease-out 2s both;
    border: 1px solid rgba(212, 175, 55, 0.2);
  }
  
  .whatsapp-bubble.hidden {
    display: none;
  }
  
  .bubble-close {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #333;
    border: none;
    color: #fff;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    line-height: 1;
  }
  
  .bubble-close:hover {
    background: #d4af37;
    transform: scale(1.1);
  }
  
  .bubble-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  
  .bubble-text {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.4;
  }
  
  .bubble-text strong {
    color: #d4af37;
    font-weight: 600;
  }
  
  .bubble-highlight {
    opacity: 0.9;
    font-size: 0.8rem;
  }
  
  @keyframes bubbleFadeIn {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  
  /* Bouton principal */
  .whatsapp-button {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    color: white;
    padding: 0.875rem 1.25rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.35);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .whatsapp-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(37, 211, 102, 0.45);
  }
  
  .whatsapp-button:active {
    transform: translateY(0);
  }
  
  /* Animation pulse subtile */
  .pulse-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    border-radius: 50px;
    transform: translate(-50%, -50%);
    animation: pulse 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    background: rgba(37, 211, 102, 0.4);
    z-index: -1;
  }
  
  @keyframes pulse {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.6;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.15);
      opacity: 0;
    }
    100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0;
    }
  }
  
  .whatsapp-text {
    letter-spacing: 0.02em;
  }
  
  @media (max-width: 768px) {
    .whatsapp-container {
      bottom: 85px;
      right: 16px;
    }
    
    .whatsapp-bubble {
      max-width: 180px;
      padding: 10px 14px;
    }
    
    .bubble-text {
      font-size: 0.8rem;
    }
    
    .whatsapp-button {
      padding: 0.875rem;
      border-radius: 50%;
    }
    
    .whatsapp-text {
      display: none;
    }
    
    .pulse-ring {
      border-radius: 50%;
    }
  }
</style>

<script is:inline>
  // Gestion de la plateforme WhatsApp
  document.addEventListener('DOMContentLoaded', () => {
    const bubble = document.getElementById('whatsapp-bubble');
    const closeBtn = document.getElementById('bubble-close');
    const mainBtn = document.getElementById('main-whatsapp-btn');
    
    // 1. Fermeture de la bulle
    if (sessionStorage.getItem('whatsappBubbleClosed') === 'true') {
      bubble?.classList.add('hidden');
    }
    
    closeBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      bubble?.classList.add('hidden');
      sessionStorage.setItem('whatsappBubbleClosed', 'true');
    });

    // 2. Détection Desktop pour forcer api.whatsapp.com (plus fiable sur PC)
    const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    
    if (!isMobile && mainBtn) {
      const currentHref = mainBtn.getAttribute('href');
      // On remplace wa.me par api.whatsapp.com/send?phone= pour PC
      const desktopHref = currentHref.replace('wa.me/', 'api.whatsapp.com/send?phone=');
      mainBtn.setAttribute('href', desktopHref);
      
      console.log('Mode Desktop : Lien WhatsApp optimisé pour PC');
    }
  });
</script>
