---
// Footer multilingue
interface Props {
  lang?: string;
}

const { lang = 'fr' } = Astro.props;
const currentYear = new Date().getFullYear();

// Traductions
const t = {
  fr: {
    navigation: "Navigation",
    home: "Accueil",
    services: "Services",
    reviews: "Avis clients",
    quote: "Demander un devis",
    about: "À propos",
    contact: "Contact",
    legal: "Mentions légales & RGPD",
    sitemap: "Plan du site",
    servicesTitle: "Services VTC",
    airportTransfers: "Transferts aéroport Nice (NCE) & Cannes-Mandelieu, gares",
    businessDriver: "Chauffeur privé business & événements",
    weddings: "Mariages & soirées privées",
    tours: "Circuits Côte d'Azur (Nice, Cannes, Monaco, Saint-Tropez, Fréjus, Sainte-Maxime)",
    disposal: "Mise à disposition demi-journée / journée",
    trustindex: "Avis Trustindex",
    allRights: "Tous droits réservés",
    optimized: "Site optimisé Core Web Vitals & SEO local",
    lastUpdate: "Dernière mise à jour",
    areasServed: "Zones desservies : Nice, Cannes, Antibes, Monaco, Saint-Tropez, Fréjus, Sainte-Maxime, aéroport Nice (NCE) et aéroport de Cannes-Mandelieu."
  },
  en: {
    navigation: "Navigation",
    home: "Home",
    services: "Services",
    reviews: "Customer Reviews",
    quote: "Request a Quote",
    about: "About Us",
    contact: "Contact",
    legal: "Legal Notice & Privacy",
    sitemap: "Sitemap",
    servicesTitle: "VTC Services",
    airportTransfers: "Nice Airport (NCE) & Cannes-Mandelieu transfers, train stations",
    businessDriver: "Private business driver & events",
    weddings: "Weddings & private parties",
    tours: "French Riviera tours (Nice, Cannes, Monaco, Saint-Tropez, Fréjus, Sainte-Maxime)",
    disposal: "Half-day / full-day chauffeur service",
    trustindex: "Trustindex Reviews",
    allRights: "All rights reserved",
    optimized: "Core Web Vitals & Local SEO optimized",
    lastUpdate: "Last update",
    areasServed: "Areas served: Nice, Cannes, Antibes, Monaco, Saint-Tropez, Fréjus, Sainte-Maxime, Nice Airport (NCE) and Cannes-Mandelieu Airport."
  },
  it: {
    navigation: "Navigazione",
    home: "Home",
    services: "Servizi",
    reviews: "Recensioni clienti",
    quote: "Richiedi preventivo",
    about: "Chi siamo",
    contact: "Contatti",
    legal: "Note legali & Privacy",
    sitemap: "Mappa del sito",
    servicesTitle: "Servizi NCC",
    airportTransfers: "Trasferimenti aeroporto Nizza (NCE) & Cannes-Mandelieu, stazioni",
    businessDriver: "Autista privato business & eventi",
    weddings: "Matrimoni & feste private",
    tours: "Tour Costa Azzurra (Nizza, Cannes, Monaco, Saint-Tropez, Fréjus, Sainte-Maxime)",
    disposal: "Noleggio con conducente mezza giornata / giornata",
    trustindex: "Recensioni Trustindex",
    allRights: "Tutti i diritti riservati",
    optimized: "Sito ottimizzato Core Web Vitals & SEO locale",
    lastUpdate: "Ultimo aggiornamento",
    areasServed: "Zone servite: Nizza, Cannes, Antibes, Monaco, Saint-Tropez, Fréjus, Sainte-Maxime, aeroporto di Nizza (NCE) e aeroporto di Cannes-Mandelieu."
  },
  ru: {
    navigation: "Навигация",
    home: "Главная",
    services: "Услуги",
    reviews: "Отзывы клиентов",
    quote: "Запросить цену",
    about: "О нас",
    contact: "Контакты",
    legal: "Правовая информация",
    sitemap: "Карта сайта",
    servicesTitle: "VTC услуги",
    airportTransfers: "Трансферы аэропорт Ницца (NCE) & Канны-Мандельё, вокзалы",
    businessDriver: "Личный водитель для бизнеса и мероприятий",
    weddings: "Свадьбы и частные вечеринки",
    tours: "Туры по Лазурному Побережью (Ницца, Канны, Монако, Сен-Тропе, Фрежюс, Сент-Максим)",
