const tr = t[lang as keyof typeof t] || t.fr;

// URLs selon la langue
const basePath = lang === 'fr' ? '' : `/${lang}`;
---

<footer class="site-footer" role="contentinfo" aria-label={lang === 'en' ? 'Footer' : lang === 'it' ? 'Piè di pagina' : lang === 'ru' ? 'Подвал' : 'Pied de page'}>
  <div class="container">
    <div class="footer-grid">
      <div>
        <strong>ECOFUNDRIVE – VTC</strong><br>
        Société par actions simplifiée · NAF 4932Z<br>
        SIREN 912 244 696 · TVA FR59912244696<br>
        1001 AVENUE DE LA BATTERIE, MARINA BAIE DES ANGES – LE DUCAL – APP<br>
        06270 VILLENEUVE-LOUBET<br>
        Tél. : <a href="tel:+33616552811">06 16 55 28 11</a><br>
        {tr.areasServed}
        <div class="badge-update">{tr.lastUpdate} : <span class="js-last-updated">{currentYear}</span></div>
        <div class="footer-badges" aria-label={lang === 'en' ? 'Legal and professional information' : 'Informations légales et professionnelles'}>
          <span class="footer-badge">ECOFUNDRIVE · SASU</span>
          <span class="footer-badge">SIREN 912 244 696</span>
          <span class="footer-badge">NAF 4932Z</span>
          <span class="footer-badge">TVA FR59912244696</span>
        </div>
      </div>
      <nav class="footer-nav" aria-label={lang === 'en' ? 'Footer navigation' : 'Navigation du pied de page'}>
        <strong>{tr.navigation}</strong>
        <a href={basePath || '/'}>{tr.home}</a>
        <a href={`${basePath}/services`}>{tr.services}</a>
        {lang === 'fr' && (
          <>
            <a href="/vtc-nice">VTC Nice</a>
            <a href="/vtc-saint-tropez">VTC Saint-Tropez</a>
            <a href="/vtc-cannes">VTC Cannes</a>
            <a href="/vtc-monaco">VTC Monaco</a>
          </>
        )}
        <a href={`${basePath}/avis-clients`}>{tr.reviews}</a>
        <a href={`${basePath}/contact`}>{tr.quote}</a>
        <a href={`${basePath}/a-propos`}>{tr.about}</a>
        <a href={`${basePath}/contact`}>{tr.contact}</a>
        <a href="/mentions-legales-rgpd">{tr.legal}</a>
        <a href="/plan-du-site">{tr.sitemap}</a>
      </nav>
      <div>
        <strong>{tr.servicesTitle}</strong><br>
        {tr.airportTransfers}<br>
        {tr.businessDriver}<br>
        {tr.weddings}<br>
        {tr.tours}<br>
        {tr.disposal}<br>
        <div class="footer-social">
          <a href="https://www.trustindex.io/reviews/ecofundrive.com" target="_blank" rel="noopener noreferrer" aria-label={lang === 'en' ? 'See our reviews on Trustindex' : 'Voir nos avis sur Trustindex'}>
            ⭐ {tr.trustindex}
          </a>
          <a href="https://www.facebook.com/ecofundrive/" target="_blank" rel="noopener noreferrer" aria-label={lang === 'en' ? 'Follow us on Facebook' : 'Suivez-nous sur Facebook'}>
            📘 Facebook
          </a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>ECOFUNDRIVE. {tr.allRights}. © {currentYear}</span>
      <span>{tr.optimized}</span>
    </div>
  </div>
</footer>
