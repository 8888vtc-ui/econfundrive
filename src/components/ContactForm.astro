---
/**
 * Formulaire de réservation VTC - Version simplifiée
 * Moins de champs = Plus de conversions
 */
---
<div class="form-wrapper fade-in-section" id="formulaire">
  <div class="form-header">
    <span class="form-badge">⚡ Réponse en 15 min</span>
    <h2>Réservez en 30 secondes</h2>
  </div>
  
  <form name="reservation" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="booking-form" id="reservation-form">
    <input type="hidden" name="form-name" value="reservation" />
    <p class="hidden"><label>Bot: <input name="bot-field" /></label></p>

    <!-- TRAJET -->
    <div class="field-group">
      <div class="input-row autocomplete-group">
        <span class="input-icon">🟢</span>
        <input type="text" id="depart" name="depart" required placeholder="Adresse de départ" autocomplete="off" />
        <div class="autocomplete-dropdown" id="depart-dropdown"></div>
      </div>
    </div>

    <div class="field-group">
      <div class="input-row autocomplete-group">
        <span class="input-icon">🔴</span>
        <input type="text" id="arrivee" name="arrivee" required placeholder="Adresse d'arrivée" autocomplete="off" />
        <div class="autocomplete-dropdown" id="arrivee-dropdown"></div>
      </div>
      <div class="quick-btns">
        <button type="button" class="qb" data-dest="Aéroport Nice Côte d'Azur">✈️ Aéroport</button>
        <button type="button" class="qb" data-dest="Monaco">🎰 Monaco</button>
        <button type="button" class="qb" data-dest="Cannes">🎬 Cannes</button>
      </div>
    </div>

    <!-- DATE / HEURE / PASSAGERS sur une ligne -->
    <div class="inline-fields">
      <div class="inline-field">
        <label>📅</label>
        <input type="date" id="date" name="date" required />
      </div>
      <div class="inline-field">
        <label>🕐</label>
        <input type="time" id="heure" name="heure" required />
      </div>
      <div class="inline-field">
        <label>👥</label>
        <select id="passagers" name="passagers">
          <option>1</option>
          <option>2</option>
          <option selected>3</option>
          <option>4+</option>
        </select>
      </div>
    </div>

    <!-- CONTACT -->
    <div class="field-group">
      <div class="input-row">
        <span class="input-icon">📞</span>
        <input type="tel" id="telephone" name="telephone" required placeholder="Votre numéro de téléphone" />
      </div>
    </div>

    <!-- MESSAGE OPTIONNEL -->
    <div class="field-group optional-group">
      <details>
        <summary>+ Ajouter des détails (optionnel)</summary>
        <textarea id="message" name="message" rows="2" placeholder="N° de vol, siège enfant, demande spéciale..."></textarea>
      </details>
    </div>

    <!-- BOUTON PRINCIPAL -->
    <button type="button" class="main-btn whatsapp" id="whatsapp-btn">
      💬 Demander un devis WhatsApp
    </button>

    <div class="alt-options">
      <span>ou</span>
      <button type="submit" class="link-btn" id="submit-btn">Envoyer par email</button>
      <span>•</span>
      <a href="tel:+33616552811" class="link-btn">Appeler directement</a>
    </div>
    
    <div id="form-message" class="form-status"></div>
  </form>
</div>

<style>
  .form-wrapper {
    background: white;
    padding: 2rem;
    border-radius: 20px;
    box-shadow: 0 15px 50px rgba(0,0,0,0.1);
  }

  .form-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .form-badge {
    display: inline-block;
    background: #d4af37;
    color: #1a1a1a;
    padding: 5px 14px;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .form-header h2 {
    font-size: 1.5rem;
    color: #1a1a1a;
    margin: 0;
  }

  .booking-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field-group {
    position: relative;
  }

  .input-row {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    font-size: 0.9rem;
    z-index: 1;
  }

  .input-row input {
    width: 100%;
    padding: 1rem 1rem 1rem 2.75rem;
    border: 2px solid #eee;
    border-radius: 12px;
    font-size: 1rem;
    font-family: inherit;
    transition: all 0.2s;
  }

  .input-row input:focus {
    border-color: #d4af37;
    outline: none;
    box-shadow: 0 0 0 4px rgba(212,175,55,0.1);
  }

  /* Quick buttons */
  .quick-btns {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .qb {
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    padding: 6px 12px;
    border-radius: 50px;
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .qb:hover {
    background: #1a1a1a;
    color: white;
    border-color: #1a1a1a;
  }

  /* Inline fields */
  .inline-fields {
    display: flex;
    gap: 0.75rem;
  }

  .inline-field {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #f9f9f9;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    border: 1px solid #eee;
  }

  .inline-field label {
    font-size: 1rem;
  }

  .inline-field input,
  .inline-field select {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 0.95rem;
    font-family: inherit;
    padding: 0.5rem 0;
    min-width: 0;
  }

  .inline-field input:focus,
  .inline-field select:focus {
    outline: none;
  }

  /* Autocomplete */
  .autocomplete-group { position: relative; }

  .autocomplete-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: white;
    border: 1px solid #ddd;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    display: none;
    z-index: 100;
    max-height: 180px;
    overflow-y: auto;
    margin-top: 4px;
  }

  .autocomplete-dropdown.show { display: block; }

  .autocomplete-item {
    padding: 12px 16px;
    cursor: pointer;
    font-size: 0.9rem;
    border-bottom: 1px solid #f0f0f0;
  }

  .autocomplete-item:hover { background: #f8f8f8; }
  .autocomplete-item:last-child { border-bottom: none; }
  .autocomplete-loading { padding: 12px; text-align: center; color: #888; }

  /* Optional section */
  .optional-group details {
    background: #fafafa;
    border-radius: 10px;
    padding: 0;
  }

  .optional-group summary {
    padding: 0.75rem 1rem;
    cursor: pointer;
    font-size: 0.85rem;
    color: #666;
    list-style: none;
  }

  .optional-group summary::-webkit-details-marker { display: none; }

  .optional-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: none;
    border-top: 1px solid #eee;
    font-family: inherit;
    font-size: 0.9rem;
    resize: none;
  }

  .optional-group textarea:focus { outline: none; }

  /* Main button */
  .main-btn {
    background: #25D366;
    color: white;
    border: none;
    padding: 1.1rem;
    border-radius: 12px;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 0.5rem;
  }

  .main-btn:hover {
    background: #1fbd5a;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(37,211,102,0.3);
  }

  /* Alt options */
  .alt-options {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: #888;
  }

  .link-btn {
    background: none;
    border: none;
    color: #d4af37;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    font-size: 0.85rem;
  }

  .link-btn:hover { text-decoration: underline; }

  /* Status */
  .form-status {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 10px;
    display: none;
    text-align: center;
  }
  
  .form-status.success { display: block; background: #d1fae5; color: #065f46; }
  .form-status.error { display: block; background: #fee2e2; color: #991b1b; }
  
  .hidden { display: none; }

  @media (max-width: 600px) {
    .form-wrapper { padding: 1.25rem; }
    .inline-fields { flex-wrap: wrap; }
    .inline-field { flex: 1 1 45%; }
    .quick-btns { flex-wrap: wrap; justify-content: center; }
  }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  // Date = demain, Heure = 10:00
  const d = document.getElementById('date');
  const h = document.getElementById('heure');
  if (d) {
    const t = new Date(); t.setDate(t.getDate() + 1);
    d.value = t.toISOString().split('T')[0];
    d.min = new Date().toISOString().split('T')[0];
  }
  if (h) h.value = '10:00';

  // Autocomplete
  let timer;
  function setup(iid, did) {
    const i = document.getElementById(iid);
    const dd = document.getElementById(did);
    if (!i || !dd) return;

    i.addEventListener('input', function() {
      const q = this.value.trim();
      clearTimeout(timer);
      if (q.length < 3) { dd.classList.remove('show'); return; }
      dd.innerHTML = '<div class="autocomplete-loading">...</div>';
      dd.classList.add('show');

      timer = setTimeout(function() {
        fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + 
          encodeURIComponent(q) + '&countrycodes=fr,mc,it&limit=5', 
          { headers: { 'Accept-Language': 'fr' } })
          .then(r => r.json())
          .then(data => {
            dd.innerHTML = '';
            if (data.length) {
              data.forEach(item => {
                const div = document.createElement('div');
                div.className = 'autocomplete-item';
                div.textContent = item.display_name.split(',').slice(0,3).join(', ');
                div.onclick = () => { i.value = div.textContent; dd.classList.remove('show'); };
                dd.appendChild(div);
              });
            } else {
              dd.innerHTML = '<div class="autocomplete-loading">Aucun résultat</div>';
            }
          }).catch(() => dd.classList.remove('show'));
      }, 350);
    });

    document.addEventListener('click', e => {
      if (!i.contains(e.target) && !dd.contains(e.target)) dd.classList.remove('show');
    });
  }
  setup('depart', 'depart-dropdown');
  setup('arrivee', 'arrivee-dropdown');

  // Quick buttons
  document.querySelectorAll('.qb').forEach(b => {
    b.onclick = () => document.getElementById('arrivee').value = b.dataset.dest;
  });

  // WhatsApp
  document.getElementById('whatsapp-btn').onclick = function() {
    const dep = document.getElementById('depart').value;
    const arr = document.getElementById('arrivee').value;
    const date = document.getElementById('date').value;
    const heure = document.getElementById('heure').value;
    const pass = document.getElementById('passagers').value;
    const tel = document.getElementById('telephone').value;
    const msg = document.getElementById('message')?.value || '';

    if (!dep || !arr || !date || !heure || !tel) {
      alert('Merci de remplir tous les champs.');
      return;
    }

    const df = new Date(date).toLocaleDateString('fr-FR');
    let t = '🚗 RÉSERVATION VTC\n\n';
    t += '📍 ' + dep + ' → ' + arr + '\n';
    t += '📅 ' + df + ' à ' + heure + '\n';
    t += '👥 ' + pass + ' passager(s)\n';
    t += '📞 ' + tel + '\n';
    if (msg) t += '💬 ' + msg;

    window.open('https://wa.me/33616552811?text=' + encodeURIComponent(t), '_blank');
  };

  // Email submit
  const form = document.getElementById('reservation-form');
  const status = document.getElementById('form-message');
  const btn = document.getElementById('submit-btn');

  form?.addEventListener('submit', async e => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = '...';

    try {
      const r = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form)).toString()
      });
      if (r.ok) {
        status.className = 'form-status success';
        status.textContent = '✅ Envoyé ! Réponse sous 15 minutes.';
        form.reset();
      } else throw new Error();
    } catch {
      status.className = 'form-status error';
      status.textContent = '❌ Erreur - Appelez-nous ou utilisez WhatsApp.';
    }
    btn.disabled = false;
    btn.textContent = 'Envoyer par email';
  });
});
</script>
