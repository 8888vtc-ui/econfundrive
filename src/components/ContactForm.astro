---
/**
 * Formulaire de réservation VTC avec autocomplétion Nominatim
 * Envoi WhatsApp ou Netlify (email)
 */
---
<div class="form-wrapper fade-in-section" id="formulaire">
  <div class="form-header">
    <h2>Réservez votre Chauffeur</h2>
    <p>Remplissez ce formulaire pour recevoir un devis gratuit sous 15 minutes.</p>
  </div>
  
  <form name="reservation" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="premium-form" id="reservation-form">
    <input type="hidden" name="form-name" value="reservation" />
    <p class="hidden"><label>Bot Field: <input name="bot-field" /></label></p>

    <!-- COORDONNEES -->
    <div class="form-section">
      <h3 class="section-title">📋 Vos coordonnées</h3>
      <div class="form-grid-2">
        <div class="input-group">
          <label for="nom">Nom complet *</label>
          <input type="text" id="nom" name="nom" required placeholder="Jean Dupont" />
        </div>
        <div class="input-group">
          <label for="telephone">Téléphone *</label>
          <input type="tel" id="telephone" name="telephone" required placeholder="+33 6 00 00 00 00" />
        </div>
      </div>
      <div class="input-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="votre@email.com" />
      </div>
    </div>

    <!-- TRAJET -->
    <div class="form-section">
      <h3 class="section-title">📍 Votre trajet</h3>
      
      <div class="input-group autocomplete-group">
        <label for="depart">Adresse de départ *</label>
        <div class="input-with-icon">
          <span class="input-icon">🟢</span>
          <input type="text" id="depart" name="depart" required placeholder="Ex: Aéroport Nice Côte d'Azur" autocomplete="off" />
        </div>
        <div class="autocomplete-dropdown" id="depart-dropdown"></div>
      </div>

      <div class="input-group autocomplete-group">
        <label for="arrivee">Adresse d'arrivée *</label>
        <div class="input-with-icon">
          <span class="input-icon">🔴</span>
          <input type="text" id="arrivee" name="arrivee" required placeholder="Ex: Hôtel Negresco, Nice" autocomplete="off" />
        </div>
        <div class="autocomplete-dropdown" id="arrivee-dropdown"></div>
      </div>

      <!-- Raccourcis destinations -->
      <div class="quick-destinations">
        <span class="quick-label">Destinations fréquentes :</span>
        <button type="button" class="quick-btn" data-dest="Aéroport Nice Côte d'Azur, Nice">✈️ Aéroport Nice</button>
        <button type="button" class="quick-btn" data-dest="Monaco, Monte-Carlo">🎰 Monaco</button>
        <button type="button" class="quick-btn" data-dest="Cannes, Croisette">🎬 Cannes</button>
        <button type="button" class="quick-btn" data-dest="Saint-Tropez">⛵ St-Tropez</button>
      </div>
    </div>

    <!-- DATE ET HEURE -->
    <div class="form-section">
      <h3 class="section-title">📅 Date et heure</h3>
      <div class="form-grid-3">
        <div class="input-group">
          <label for="date">Date *</label>
          <input type="date" id="date" name="date" required />
        </div>
        <div class="input-group">
          <label for="heure">Heure *</label>
          <input type="time" id="heure" name="heure" required />
        </div>
        <div class="input-group">
          <label for="retour">Retour ?</label>
          <select id="retour" name="retour">
            <option value="non">Aller simple</option>
            <option value="oui">Aller-retour</option>
          </select>
        </div>
      </div>
    </div>

    <!-- PASSAGERS -->
    <div class="form-section">
      <h3 class="section-title">👥 Passagers et bagages</h3>
      <div class="form-grid-3">
        <div class="input-group">
          <label for="passagers">Passagers</label>
          <select id="passagers" name="passagers">
            <option>1</option>
            <option>2</option>
            <option selected>3</option>
            <option>4</option>
            <option>5+</option>
          </select>
        </div>
        <div class="input-group">
          <label for="bagages">Bagages</label>
          <select id="bagages" name="bagages">
            <option>0</option>
            <option>1</option>
            <option selected>2</option>
            <option>3+</option>
          </select>
        </div>
        <div class="input-group">
          <label for="vehicule">Véhicule</label>
          <select id="vehicule" name="vehicule">
            <option value="berline">Berline (1-3 pers)</option>
            <option value="van">Van (4-7 pers)</option>
            <option value="luxe">Luxe (Mercedes S)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- MESSAGE -->
    <div class="input-group">
      <label for="message">Informations complémentaires</label>
      <textarea id="message" name="message" rows="3" placeholder="N° de vol, besoins spéciaux, siège enfant..."></textarea>
    </div>

    <!-- BOUTONS ENVOI -->
    <div class="submit-buttons">
      <button type="button" class="submit-btn whatsapp-btn" id="whatsapp-btn">
        <span>💬 Envoyer sur WhatsApp</span>
      </button>
      <button type="submit" class="submit-btn email-btn" id="submit-btn">
        <span>📧 Envoyer par Email</span>
      </button>
    </div>
    
    <p class="form-note">* Réponse garantie sous 15 minutes par WhatsApp</p>
    
    <div id="form-message" class="form-status"></div>
  </form>
</div>

<style>
  .form-wrapper {
    background: white;
    padding: 2.5rem;
    border-radius: 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.08);
  }

  .form-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .form-header h2 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
    color: #1a1a1a;
  }

  .form-header p {
    color: #666;
    font-size: 0.95rem;
  }

  .premium-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-section {
    background: #fafafa;
    padding: 1.5rem;
    border-radius: 16px;
    border: 1px solid #eee;
  }

  .section-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #1a1a1a;
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .form-grid-3 {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    position: relative;
  }

  .input-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #333;
  }

  .input-group input, 
  .input-group select, 
  .input-group textarea {
    padding: 0.9rem 1rem;
    border: 1px solid #ddd;
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.95rem;
    transition: all 0.2s;
    background: white;
  }

  .input-group input:focus, 
  .input-group select:focus, 
  .input-group textarea:focus {
    border-color: #d4af37;
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
    outline: none;
  }

  /* Autocomplete input */
  .input-with-icon {
    position: relative;
  }

  .input-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.8rem;
  }

  .input-with-icon input {
    padding-left: 2.5rem;
    width: 100%;
  }

  .autocomplete-group {
    position: relative;
  }

  .autocomplete-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: white;
    border: 1px solid #ddd;
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    display: none;
    z-index: 100;
    max-height: 200px;
    overflow-y: auto;
    margin-top: 4px;
  }

  .autocomplete-dropdown.show {
    display: block;
  }

  .autocomplete-item {
    padding: 10px 14px;
    cursor: pointer;
    font-size: 0.9rem;
    border-bottom: 1px solid #f0f0f0;
  }

  .autocomplete-item:hover {
    background: #f5f5f5;
  }

  .autocomplete-item:last-child {
    border-bottom: none;
  }

  .autocomplete-loading {
    padding: 12px;
    text-align: center;
    color: #888;
    font-size: 0.85rem;
  }

  /* Quick destinations */
  .quick-destinations {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    align-items: center;
  }

  .quick-label {
    font-size: 0.8rem;
    color: #888;
  }

  .quick-btn {
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    padding: 6px 12px;
    border-radius: 50px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .quick-btn:hover {
    background: #d4af37;
    border-color: #d4af37;
    color: white;
  }

  /* Submit buttons */
  .submit-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .submit-btn {
    padding: 1rem;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.2s;
  }

  .whatsapp-btn {
    background: #25D366;
    color: white;
  }

  .whatsapp-btn:hover {
    background: #1fbd5a;
    transform: translateY(-2px);
  }

  .email-btn {
    background: #1a1a1a;
    color: white;
  }

  .email-btn:hover {
    background: #d4af37;
    transform: translateY(-2px);
  }

  .form-note {
    text-align: center;
    font-size: 0.8rem;
    color: #888;
    margin-top: 0.5rem;
  }

  .form-status {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 10px;
    display: none;
    text-align: center;
  }
  
  .form-status.success { display: block; background: #d1fae5; color: #065f46; }
  .form-status.error { display: block; background: #fee2e2; color: #991b1b; }
  
  .hidden { display: none; }

  @media (max-width: 768px) {
    .form-wrapper { padding: 1.5rem; }
    .form-grid-2, .form-grid-3 { grid-template-columns: 1fr; }
    .submit-buttons { grid-template-columns: 1fr; }
    .quick-destinations { justify-content: center; }
  }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  // Date par défaut = demain
  const dateInput = document.getElementById('date');
  if (dateInput) {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    dateInput.value = tomorrow.toISOString().split('T')[0];
    dateInput.min = new Date().toISOString().split('T')[0];
  }

  // Heure par défaut = 10:00
  const heureInput = document.getElementById('heure');
  if (heureInput) heureInput.value = '10:00';

  // Autocomplétion Nominatim
  let debounceTimer;
  
  function setupAutocomplete(inputId, dropdownId) {
    const input = document.getElementById(inputId);
    const dropdown = document.getElementById(dropdownId);
    if (!input || !dropdown) return;

    input.addEventListener('input', function() {
      const query = this.value.trim();
      clearTimeout(debounceTimer);
      
      if (query.length < 3) {
        dropdown.classList.remove('show');
        return;
      }

      dropdown.innerHTML = '<div class="autocomplete-loading">Recherche...</div>';
      dropdown.classList.add('show');

      debounceTimer = setTimeout(function() {
        const url = 'https://nominatim.openstreetmap.org/search?format=json&q=' + 
          encodeURIComponent(query) + 
          '&countrycodes=fr,mc,it&limit=5&addressdetails=1';
        
        fetch(url, { headers: { 'Accept-Language': 'fr' } })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            dropdown.innerHTML = '';
            if (data.length > 0) {
              data.forEach(function(item) {
                const div = document.createElement('div');
                div.className = 'autocomplete-item';
                const name = item.display_name.split(',').slice(0, 3).join(', ');
                div.textContent = name;
                div.addEventListener('click', function() {
                  input.value = name;
                  dropdown.classList.remove('show');
                });
                dropdown.appendChild(div);
              });
            } else {
              dropdown.innerHTML = '<div class="autocomplete-loading">Aucun résultat</div>';
            }
          })
          .catch(function() {
            dropdown.classList.remove('show');
          });
      }, 400);
    });

    // Fermer dropdown si click ailleurs
    document.addEventListener('click', function(e) {
      if (!input.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.remove('show');
      }
    });
  }

  setupAutocomplete('depart', 'depart-dropdown');
  setupAutocomplete('arrivee', 'arrivee-dropdown');

  // Boutons destinations rapides
  document.querySelectorAll('.quick-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const dest = this.getAttribute('data-dest');
      const arriveeInput = document.getElementById('arrivee');
      if (arriveeInput) arriveeInput.value = dest;
    });
  });

  // Envoi WhatsApp
  const waBtn = document.getElementById('whatsapp-btn');
  if (waBtn) {
    waBtn.addEventListener('click', function() {
      const nom = document.getElementById('nom').value;
      const tel = document.getElementById('telephone').value;
      const depart = document.getElementById('depart').value;
      const arrivee = document.getElementById('arrivee').value;
      const date = document.getElementById('date').value;
      const heure = document.getElementById('heure').value;
      const passagers = document.getElementById('passagers').value;
      const bagages = document.getElementById('bagages').value;
      const vehicule = document.getElementById('vehicule').value;
      const message = document.getElementById('message').value;

      if (!nom || !tel || !depart || !arrivee || !date || !heure) {
        alert('Veuillez remplir tous les champs obligatoires.');
        return;
      }

      const dateFormatted = new Date(date).toLocaleDateString('fr-FR');
      
      let text = '🚗 NOUVELLE RÉSERVATION VTC\n\n';
      text += '👤 ' + nom + '\n';
      text += '📞 ' + tel + '\n\n';
      text += '📍 Départ: ' + depart + '\n';
      text += '📍 Arrivée: ' + arrivee + '\n\n';
      text += '📅 ' + dateFormatted + ' à ' + heure + '\n';
      text += '👥 ' + passagers + ' passager(s)\n';
      text += '🧳 ' + bagages + ' bagage(s)\n';
      text += '🚘 ' + vehicule + '\n';
      if (message) text += '\n💬 ' + message;

      const waUrl = 'https://wa.me/33616552811?text=' + encodeURIComponent(text);
      window.open(waUrl, '_blank');
    });
  }

  // Envoi email (Netlify)
  const form = document.getElementById('reservation-form');
  const statusDiv = document.getElementById('form-message');
  const submitBtn = document.getElementById('submit-btn');

  if (form) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      submitBtn.disabled = true;
      const originalText = submitBtn.querySelector('span').textContent;
      submitBtn.querySelector('span').textContent = 'Envoi...';

      const formData = new FormData(form);
      
      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData).toString()
        });

        if (response.ok) {
          statusDiv.className = 'form-status success';
          statusDiv.textContent = '✅ Demande envoyée ! Nous vous répondrons sous 15 minutes.';
          form.reset();
          submitBtn.querySelector('span').textContent = 'Envoyé !';
          setTimeout(function() {
            submitBtn.disabled = false;
            submitBtn.querySelector('span').textContent = originalText;
            statusDiv.className = 'form-status';
          }, 5000);
        } else {
          throw new Error('Erreur réseau');
        }
      } catch (error) {
        statusDiv.className = 'form-status error';
        statusDiv.textContent = '❌ Erreur. Contactez-nous par WhatsApp ou téléphone.';
        submitBtn.disabled = false;
        submitBtn.querySelector('span').textContent = originalText;
      }
    });
  }
});
</script>
