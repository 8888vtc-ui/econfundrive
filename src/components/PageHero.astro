---
/**
 * Hero Section Premium pour pages VTC
 * Bandeau visuel immersif avec overlay dégradé
 */
interface Props {
  title: string;
  subtitle?: string;
  rating?: string;
  backgroundImage: string;
  badge?: string;
}

const { 
  title, 
  subtitle, 
  rating = "5.0/5",
  backgroundImage,
  badge = "SERVICE PREMIUM 24/7"
} = Astro.props;
---

<section class="page-hero">
  <div class="hero-bg" style={`background-image: url('${backgroundImage}')`}></div>
  <div class="hero-gradient"></div>
  <div class="hero-content container">
    <span class="hero-badge">{badge}</span>
    <h1>{title}</h1>
    {subtitle && <p class="hero-lead">{subtitle}</p>}
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-value">⭐ {rating}</span>
        <span class="stat-label">Avis clients</span>
      </div>
      <div class="stat">
        <span class="stat-value">24/7</span>
        <span class="stat-label">Disponibilité</span>
      </div>
      <div class="stat">
        <span class="stat-value">15 min</span>
        <span class="stat-label">Temps réponse</span>
      </div>
    </div>
    <div class="hero-cta">
      <a href="/reservation" class="btn-gold-hero">Réserver maintenant</a>
      <a href="https://wa.me/33616552811" class="btn-whatsapp-hero">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 0;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: brightness(0.5);
    transform: scale(1.05);
    transition: transform 8s ease-out;
  }

  .page-hero:hover .hero-bg {
    transform: scale(1);
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 12, 23, 0.3) 0%,
      rgba(10, 12, 23, 0.6) 50%,
      rgba(10, 12, 23, 0.95) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: white;
    padding: 2rem;
    max-width: 900px;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(212, 175, 55, 0.2);
    border: 1px solid rgba(212, 175, 55, 0.5);
    color: #d4af37;
    padding: 0.5rem 1.5rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(10px);
  }

  .page-hero h1 {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.1;
    color: white;
    text-shadow: 0 2px 20px rgba(0,0,0,0.3);
  }

  .hero-lead {
    font-size: 1.2rem;
    color: #e0e0e0;
    max-width: 700px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 3rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: #d4af37;
  }

  .stat-label {
    font-size: 0.8rem;
    color: #aaa;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-gold-hero {
    background: linear-gradient(135deg, #d4af37, #f0d78c);
    color: #000;
    padding: 1rem 2.5rem;
    border-radius: 50px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 4px 20px rgba(212, 175, 55, 0.4);
  }

  .btn-gold-hero:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 8px 30px rgba(212, 175, 55, 0.6);
  }

  .btn-whatsapp-hero {
    background: #25D366;
    color: white;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s;
  }

  .btn-whatsapp-hero:hover {
    background: #1fbd5a;
    transform: translateY(-3px);
  }

  @media (max-width: 768px) {
    .page-hero {
      min-height: 80vh;
    }
    
    .hero-stats {
      gap: 1.5rem;
    }
    
    .stat-value {
      font-size: 1.2rem;
    }
    
    .hero-cta {
      flex-direction: column;
      align-items: center;
    }
    
    .btn-gold-hero,
    .btn-whatsapp-hero {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }
  }
</style>
