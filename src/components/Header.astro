---
import Logo from './Logo.astro';

interface Props {
  currentPage?: string;
  lang?: string;
}

const { currentPage = "", lang = "fr" } = Astro.props;

const translations = {
  fr: {
    home: "Accueil",
    services: "Services",
    about: "Qui nous sommes",
    contact: "Contact",
    whatsapp_label: "WhatsApp",
  },
  en: {
    home: "Home",
    services: "Services",
    about: "About Us",
    contact: "Contact",
    whatsapp_label: "WhatsApp",
  },
  it: {
    home: "Home",
    services: "Servizi",
    about: "Chi Siamo",
    contact: "Contatti",
    whatsapp_label: "WhatsApp",
  },
  ru: {
    home: "Главная",
    services: "Услуги",
    about: "О нас",
    contact: "Контакты",
    whatsapp_label: "WhatsApp",
  }
};

const t = translations[lang] || translations.fr;

// Determine Home URL based on language
const homeUrl = lang === 'fr' ? '/' : `/${lang}/`;
---

<!-- HEADER -->
<header class="site-header">
  <div class="container navbar">
    <div class="nav-brand">
      <a href={homeUrl} class="nav-brand-link" aria-label={`ECOFUNDRIVE - ${t.home}`}>
        <Logo />
      </a>
    </div>
    
    
    <!-- Menu Desktop -->
    <nav class="nav-links-desktop" aria-label="Navigation principale">
      <a href={homeUrl} class={currentPage === "index" ? "active" : ""}>{t.home}</a>
      <a href={lang === 'fr' ? '/services' : lang === 'en' ? '/en/services' : lang === 'it' ? '/it/servizi' : '/ru/uslugi'} class={currentPage === "services" ? "active" : ""}>{t.services}</a>
      <a href={lang === 'fr' ? '/a-propos' : homeUrl} class={currentPage === "a-propos" ? "active" : ""}>{t.about}</a>
      <a href={lang === 'fr' ? '/contact' : lang === 'en' ? '/en/contact' : lang === 'it' ? '/it/contatto' : '/ru/kontakt'} class={currentPage === "contact" ? "active" : ""}>{t.contact}</a>
    </nav>
    
    <!-- Language Switcher -->
    <div class="lang-switcher">
      <button class="lang-current" aria-label="Changer de langue" aria-expanded="false">
        <span class="lang-flag">{lang === 'fr' ? '🇫🇷' : lang === 'en' ? '🇬🇧' : lang === 'it' ? '🇮🇹' : '🇷🇺'}</span>
        <span class="lang-code">{lang.toUpperCase()}</span>
        <svg class="lang-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      <div class="lang-dropdown">
        <a href="/" class={`lang-option ${lang === 'fr' ? 'active' : ''}`}>
          <span class="lang-flag">🇫🇷</span>
          <span>Français</span>
        </a>
        <a href="/en/" class={`lang-option ${lang === 'en' ? 'active' : ''}`}>
          <span class="lang-flag">🇬🇧</span>
          <span>English</span>
        </a>
        <a href="/it/" class={`lang-option ${lang === 'it' ? 'active' : ''}`}>
          <span class="lang-flag">🇮🇹</span>
          <span>Italiano</span>
        </a>
        <a href="/ru/" class={`lang-option ${lang === 'ru' ? 'active' : ''}`}>
          <span class="lang-flag">🇷🇺</span>
          <span>Русский</span>
        </a>
      </div>
    </div>
  </div>
</header>

<!-- WhatsApp FIXE en haut (mobile) - Toujours visible au scroll -->
<a 
  href="https://wa.me/33616552811?text=Bonjour%2C%20je%20souhaite%20r%C3%A9server%20un%20VTC"
  class="whatsapp-fixed-top"
  aria-label="Contacter par WhatsApp"
  target="_blank"
  rel="noopener noreferrer"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
  </svg>
  <span>{t.whatsapp_label}</span>
</a>

<!-- BOTTOM NAVIGATION MOBILE -->
<nav class="bottom-nav" aria-label="Navigation mobile">
  <a href={homeUrl} class={`bottom-nav-item ${currentPage === "index" ? "active" : ""}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      <polyline points="9 22 9 12 15 12 15 22"></polyline>
    </svg>
    <span>{t.home}</span>
  </a>
  <a href="/services" class={`bottom-nav-item ${currentPage === "services" ? "active" : ""}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="7" height="7"></rect>
      <rect x="14" y="3" width="7" height="7"></rect>
      <rect x="14" y="14" width="7" height="7"></rect>
      <rect x="3" y="14" width="7" height="7"></rect>
    </svg>
    <span>{t.services}</span>
  </a>
  <a href="/contact" class={`bottom-nav-item ${currentPage === "contact" ? "active" : ""}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
    <span>{t.contact}</span>
  </a>
</nav>
