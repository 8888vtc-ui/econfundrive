---
import BaseLayout from '../../layouts/BaseLayout.astro';

const { frontmatter } = Astro.props;

const breadcrumbItems = [
  { name: 'Accueil', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: frontmatter.title, url: Astro.url.pathname }
];

// Schema Article pour SEO
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": frontmatter.title,
  "description": frontmatter.excerpt,
  "image": frontmatter.image ? `https://www.ecofundrive.com${frontmatter.image}` : undefined,
  "datePublished": frontmatter.date,
  "dateModified": frontmatter.dateModified || frontmatter.date,
  "author": {
    "@type": "Person",
    "name": frontmatter.author || "David Chemla"
  },
  "publisher": {
    "@type": "Organization",
    "name": "ECOFUNDRIVE",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.ecofundrive.com/assets/img/logo/logo-ecofundrive.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://www.ecofundrive.com${Astro.url.pathname}`
  }
};
---

<BaseLayout 
  title={`${frontmatter.title} | Blog ECOFUNDRIVE`}
  description={frontmatter.excerpt}
  currentPage="blog"
  breadcrumbItems={breadcrumbItems}
  schema={articleSchema}
  ogImage={frontmatter.image ? `https://www.ecofundrive.com${frontmatter.image}` : undefined}
  keywords={frontmatter.tags || []}
>
  <article class="blog-article">
    {frontmatter.image && (
      <div class="article-hero">
        <img 
          src={frontmatter.image} 
          alt={frontmatter.title}
          width="1200"
          height="600"
        />
        <div class="article-hero-overlay"></div>
      </div>
    )}
    
    <div class="container">
      <header class="article-header">
        <div class="article-meta">
          <time datetime={frontmatter.date}>
            {new Date(frontmatter.date).toLocaleDateString('fr-FR', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          {frontmatter.category && (
            <span class="article-category">{frontmatter.category}</span>
          )}
          {frontmatter.readingTime && (
            <span class="reading-time">📖 {frontmatter.readingTime} min de lecture</span>
          )}
        </div>
        <h1>{frontmatter.title}</h1>
        {frontmatter.excerpt && (
          <p class="article-excerpt">{frontmatter.excerpt}</p>
        )}
      </header>

      <div class="article-content">
        <slot />
      </div>

      <footer class="article-footer">
        <div class="article-author">
          <strong>Écrit par {frontmatter.author || "David Chemla"}</strong>
          <span>Chauffeur VTC & Expert Côte d'Azur</span>
        </div>
        
        <div class="article-cta">
          <h3>Besoin d'un chauffeur privé ?</h3>
          <p>Réservez votre VTC pour découvrir la Côte d'Azur en toute sérénité.</p>
          <a href="/contact" class="btn">Demander un devis</a>
          <a href="https://wa.me/33616552811" class="btn btn-whatsapp" target="_blank" rel="noopener">💬 WhatsApp</a>
        </div>

        <div class="article-share">
          <span>Partager :</span>
          <a href={`https://www.facebook.com/sharer/sharer.php?u=https://www.ecofundrive.com${Astro.url.pathname}`} target="_blank" rel="noopener" aria-label="Partager sur Facebook">📘 Facebook</a>
          <a href={`https://twitter.com/intent/tweet?url=https://www.ecofundrive.com${Astro.url.pathname}&text=${frontmatter.title}`} target="_blank" rel="noopener" aria-label="Partager sur Twitter">🐦 Twitter</a>
        </div>

        <a href="/blog" class="back-to-blog">← Retour au blog</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-article {
    background: white;
  }

  .article-hero {
    position: relative;
    width: 100%;
    height: 400px;
    overflow: hidden;
  }

  .article-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
  }

  .article-header {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 0 2rem;
    text-align: center;
  }

  .article-meta {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: #666;
  }

  .article-category {
    background: rgba(212, 175, 55, 0.15);
    color: #d4af37;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-weight: 600;
  }

  .reading-time {
    color: #888;
  }

  .article-header h1 {
    font-size: 2.5rem;
    color: #1a1a1a;
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .article-excerpt {
    font-size: 1.2rem;
    color: #555;
    max-width: 600px;
    margin: 0 auto;
  }

  .article-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 0;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .article-content :global(h2) {
    color: #d4af37;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.8rem;
  }

  .article-content :global(h3) {
    color: #1a1a1a;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.4rem;
  }

  .article-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .article-content :global(ul), 
  .article-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-content :global(img) {
    border-radius: 12px;
    margin: 2rem 0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }

  .article-content :global(blockquote) {
    border-left: 4px solid #d4af37;
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #555;
  }

  .article-footer {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 0;
    border-top: 1px solid #eee;
  }

  .article-author {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 2rem;
  }

  .article-author strong {
    color: #1a1a1a;
    font-size: 1.1rem;
  }

  .article-author span {
    color: #888;
    font-size: 0.9rem;
  }

  .article-cta {
    background: linear-gradient(135deg, #0a0a0a, #1a1a1a);
    padding: 2rem;
    border-radius: 16px;
    text-align: center;
    margin-bottom: 2rem;
  }

  .article-cta h3 {
    color: #d4af37;
    margin-bottom: 0.5rem;
  }

  .article-cta p {
    color: #ccc;
    margin-bottom: 1.5rem;
  }

  .article-cta .btn {
    margin: 0 0.5rem;
  }

  .btn-whatsapp {
    background: #25D366 !important;
    color: white !important;
  }

  .article-share {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .article-share span {
    font-weight: 600;
    color: #333;
  }

  .article-share a {
    color: #666;
    text-decoration: none;
    transition: color 0.3s;
  }

  .article-share a:hover {
    color: #d4af37;
  }

  .back-to-blog {
    color: #d4af37;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: gap 0.3s;
  }

  .back-to-blog:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .article-hero {
      height: 250px;
    }

    .article-header h1 {
      font-size: 1.8rem;
    }

    .article-excerpt {
      font-size: 1rem;
    }

    .article-content {
      font-size: 1rem;
    }

    .article-cta .btn {
      display: block;
      margin: 0.5rem 0;
    }
  }
</style>
