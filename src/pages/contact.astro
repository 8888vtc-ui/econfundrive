---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

const title = "Contact & Réservation VTC | ECOFUNDRIVE – Chauffeur Privé Premium";
const description = "Réservez votre chauffeur privé VTC sur la Côte d'Azur. Disponible 24/7 pour transferts aéroport, business et événements. Réponse immédiate.";
const keywords = [
  'contact VTC Nice',
  'réservation chauffeur privé',
  'devis VTC Côte d\'Azur',
  'numéro chauffeur VTC',
  'whatsapp VTC'
];

const breadcrumbItems = [
  { name: "Accueil", url: "/" },
  { name: "Contact", url: "/contact" }
];
---

<BaseLayout 
  title={title}
  description={description}
  keywords={keywords}
  currentPage="contact"
  canonical="/contact"
  breadcrumbItems={breadcrumbItems}
>
  <main id="main-content">
    <!-- HERO SECTION - PREMIUM -->
    <section class="contact-hero">
      <div class="hero-bg"></div>
      <div class="hero-overlay"></div>
      <div class="container hero-content fade-in-section">
        <span class="hero-badge">Service 24H/7J</span>
        <h1>Contact & Réservation</h1>
        <p class="lead">Une expérience de transport sur-mesure commence ici. Notre équipe est à votre disposition pour organiser vos déplacements sur la Côte d'Azur.</p>
        <div class="hero-actions">
           <a href="tel:+33616552811" class="btn-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            06 16 55 28 11
           </a>
           <a href="#formulaire" class="btn-secondary">Formulaire en ligne</a>
        </div>
      </div>
    </section>

    <!-- CONTENT SECTION -->
    <section class="contact-section">
      <div class="container">
        <div class="contact-grid">
          
          <!-- INFO SIDEBAR -->
          <aside class="sidebar fade-in-section">
            <div class="info-card gold-card">
              <div class="card-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </div>
              <div class="card-text">
                <h3>Réponse Immédiate</h3>
                <p>Besoin d'un chauffeur maintenant ? Contactez-nous sur WhatsApp pour une prise en charge rapide.</p>
                <a href="https://wa.me/33616552811" class="link-arrow">WhatsApp direct →</a>
              </div>
            </div>

            <div class="info-card">
              <div class="card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              </div>
              <div class="card-text">
                <h3>Email</h3>
                <a href="mailto:8888VTC@gmail.com" class="contact-link">8888VTC@gmail.com</a>
                <p class="small-text">Réponse sous 2 heures</p>
              </div>
            </div>

            <div class="info-card">
              <div class="card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </div>
              <div class="card-text">
                <h3>Zone d'Intervention</h3>
                <p>Nice, Cannes, Monaco, Antibes, Saint-Tropez et toute la Côte d'Azur.</p>
              </div>
            </div>

            <div class="info-card">
              <div class="card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div class="card-text">
                <h3>Disponibilité</h3>
                <p><strong>24h/24 - 7j/7</strong></p>
                <p class="small-text">Réservation conseillée 24h à l'avance</p>
              </div>
            </div>
            
            <div class="advantages-box">
               <h3>Pourquoi ECOFUNDRIVE ?</h3>
               <ul class="advantages-list">
                 <li>✓ Prix fixe garanti, pas de surprise</li>
                 <li>✓ Véhicules premium (Tesla, Mercedes)</li>
                 <li>✓ Chauffeurs professionnels bilingues</li>
                 <li>✓ Suivi de vol en temps réel</li>
                 <li>✓ Annulation gratuite 24h avant</li>
               </ul>
            </div>

            <div class="whatsapp-box">
               <span class="wa-icon">💬</span>
               <div>
                 <p><strong>Réponse en moins de 15 min</strong></p>
                 <a href="https://wa.me/33616552811" class="btn-whatsapp">Contacter sur WhatsApp</a>
               </div>
            </div>
          </aside>

            <!-- FORMULAIRE -->
            <ContactForm />
          </div>
        </div>
      </section>
    
    <!-- MAP IMAGE SECTION -->
    <section class="map-section">
      <div class="container">
         <div class="map-content">
            <h2>Notre Zone d'Excellence</h2>
            <p>Nous intervenons sur toute la Côte d'Azur, de Saint-Tropez à Monaco, ainsi que pour vos transferts longue distance en Europe.</p>
         </div>
         <div class="map-visual">
            <img src="/assets/img/destinations/vtc-tesla-nice.webp" alt="Carte VTC Côte d'Azur" class="map-img-placeholder" />
            <div class="map-overlay">
               <span>Nice</span>
               <span>Cannes</span>
               <span>Monaco</span>
               <span>Saint-Tropez</span>
            </div>
         </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* --- HERO SECTION --- */
  .contact-hero {
    position: relative;
    height: 60vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: -50px; /* Chevauchement */
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('/assets/img/hero/hero-mariage.webp');
    background-size: cover;
    background-position: center;
    filter: brightness(0.6);
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(10,10,10,0.3), rgba(10,10,10,0.8));
    z-index: 2;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: white;
    max-width: 800px;
  }

  .hero-badge {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(212, 175, 55, 0.2);
    border: 1px solid #d4af37;
    border-radius: 50px;
    color: #d4af37;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(5px);
  }

  .contact-hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.1;
    text-shadow: 0 4px 10px rgba(0,0,0,0.3);
    color: white;
  }

  .contact-hero .lead {
    font-size: 1.25rem;
    color: #e0e0e0;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #d4af37;
    color: black;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s;
  }

  .btn-primary:hover {
    background: white;
    transform: translateY(-2px);
  }

  .btn-secondary {
    padding: 1rem 2rem;
    background: rgba(255,255,255,0.1);
    color: white;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
    backdrop-filter: blur(5px);
    transition: all 0.3s;
  }

  .btn-secondary:hover {
    background: white;
    color: black;
  }

  /* --- CONTENT SECTION --- */
  .contact-section {
    position: relative;
    z-index: 10;
    padding-bottom: 4rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 350px 1fr;
    gap: 3rem;
  }

  /* SIDEBAR */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    background: white;
    padding: 2rem;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    transition: transform 0.3s;
  }

  .info-card:hover {
    transform: translateY(-5px);
  }

  .info-card.gold-card {
    background: #1a1a1a;
    color: white;
  }

  .info-card.gold-card h3, .info-card.gold-card p {
    color: #e0e0e0;
  }

  .card-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    background: #f5f5f5;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d4af37;
  }

  .gold-card .card-icon {
    background: rgba(212, 175, 55, 0.15);
  }

  .card-text h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .card-text p {
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }

  .contact-link {
    font-weight: 700;
    color: #1a1a1a;
    text-decoration: none;
    font-size: 1.1rem;
  }

  .link-arrow {
    color: #d4af37;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .trust-box {
    text-align: center;
    padding: 2rem;
    background: linear-gradient(135deg, #fdfbf7, #fff);
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 16px;
  }

  .trust-logo {
    width: 60px;
    height: 60px;
    margin-bottom: 1rem;
  }
  
  .trust-box p {
    font-size: 0.9rem;
    color: #8c732b;
    font-weight: 500;
  }

  /* ADVANTAGES BOX */
  .advantages-box {
    background: linear-gradient(135deg, #1a1a1a, #2d2d2d);
    padding: 1.5rem;
    border-radius: 16px;
    color: white;
  }
  
  .advantages-box h3 {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: #d4af37;
  }
  
  .advantages-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .advantages-list li {
    padding: 0.5rem 0;
    font-size: 0.9rem;
    color: #e0e0e0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  
  .advantages-list li:last-child {
    border-bottom: none;
  }

  /* WHATSAPP BOX */
  .whatsapp-box {
    background: #25D366;
    padding: 1.25rem 1.5rem;
    border-radius: 16px;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: white;
  }
  
  .wa-icon {
    font-size: 2rem;
  }
  
  .whatsapp-box p {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    color: white;
  }
  
  .btn-whatsapp {
    display: inline-block;
    background: white;
    color: #25D366;
    padding: 8px 16px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    transition: all 0.2s;
  }
  
  .btn-whatsapp:hover {
    background: #f0fff4;
    transform: translateY(-2px);
  }

  /* MAP SECTION */
  .map-section {
    padding: 4rem 0 6rem;
    background: #f9f9f9;
  }
  
  .map-content {
      text-align: center;
      max-width: 600px;
      margin: 0 auto 3rem;
  }
  
  .map-content h2 { font-size: 2rem; margin-bottom: 1rem; }
  
  .map-visual {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      height: 400px;
  }
  
  .map-img-placeholder {
      width: 100%;
      height: 100%;
      object-fit: cover;
  }
  
  .map-overlay {
      position: absolute;
      bottom: 20px;
      left: 20px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
  }
  
  .map-overlay span {
      background: rgba(255,255,255,0.9);
      padding: 0.5rem 1rem;
      border-radius: 50px;
      font-weight: 600;
      font-size: 0.9rem;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  /* RESPONSIVE */
  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    
    .contact-hero {
        height: auto;
        padding: 8rem 0 6rem;
        margin-bottom: 0;
    }
  }

  @media (max-width: 768px) {
    .hero-actions {
        flex-direction: column;
        width: 100%;
    }
    
    .btn-primary, .btn-secondary {
        width: 100%;
        justify-content: center;
    }
  }
</style>
