---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Contact & Réservation VTC | ECOFUNDRIVE – Chauffeur Privé Premium";
const description = "Réservez votre chauffeur privé VTC sur la Côte d'Azur. Disponible 24/7 pour transferts aéroport, business et événements. Réponse immédiate.";
const keywords = [
  'contact VTC Nice',
  'réservation chauffeur privé',
  'devis VTC Côte d\'Azur',
  'numéro chauffeur VTC',
  'whatsapp VTC'
];

const breadcrumbItems = [
  { name: "Accueil", url: "/" },
  { name: "Contact", url: "/contact" }
];
---

<BaseLayout 
  title={title}
  description={description}
  keywords={keywords}
  currentPage="contact"
  canonical="/contact"
  breadcrumbItems={breadcrumbItems}
>
  <main id="main-content">
    <!-- HERO SECTION - PREMIUM -->
    <section class="contact-hero">
      <div class="hero-bg"></div>
      <div class="hero-overlay"></div>
      <div class="container hero-content fade-in-section">
        <span class="hero-badge">Service 24H/7J</span>
        <h1>Contact & Réservation</h1>
        <p class="lead">Une expérience de transport sur-mesure commence ici. Notre équipe est à votre disposition pour organiser vos déplacements sur la Côte d'Azur.</p>
        <div class="hero-actions">
           <a href="tel:+33616552811" class="btn-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            06 16 55 28 11
           </a>
           <a href="#formulaire" class="btn-secondary">Formulaire en ligne</a>
        </div>
      </div>
    </section>

    <!-- CONTENT SECTION -->
    <section class="contact-section">
      <div class="container">
        <div class="contact-grid">
          
          <!-- INFO SIDEBAR -->
          <aside class="sidebar fade-in-section">
            <div class="info-card gold-card">
              <div class="card-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </div>
              <div class="card-text">
                <h3>Réponse Immédiate</h3>
                <p>Besoin d'un chauffeur maintenant ? Contactez-nous sur WhatsApp pour une prise en charge rapide.</p>
                <a href="https://wa.me/33616552811" class="link-arrow">WhatsApp direct →</a>
              </div>
            </div>

            <div class="info-card">
              <div class="card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              </div>
              <div class="card-text">
                <h3>Email</h3>
                <a href="mailto:8888VTC@gmail.com" class="contact-link">8888VTC@gmail.com</a>
                <p class="small-text">Réponse sous 2 heures</p>
              </div>
            </div>

            <div class="info-card">
              <div class="card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </div>
              <div class="card-text">
                <h3>Zone d'Intervention</h3>
                <p>Nice, Cannes, Monaco, Antibes, Saint-Tropez et toute la Côte d'Azur.</p>
              </div>
            </div>
            
            <div class="trust-box">
               <img src="/assets/img/logo/logo-icon-gold.svg" alt="EcoFunDrive" class="trust-logo" />
               <p>Chauffeurs professionnels agréés et véhicules haut de gamme pour votre sécurité et confort.</p>
            </div>
          </aside>

          <!-- FORMULAIRE -->
          <div class="form-wrapper fade-in-section" id="formulaire">
            <div class="form-header">
              <h2>Demander un Devis ou Réserver</h2>
              <p>Remplissez ce formulaire, nous vous répondrons avec un tarif fixe et transparent.</p>
            </div>
            
            <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="premium-form" id="contact-form">
              <input type="hidden" name="form-name" value="contact" />
              <p class="hidden"><label>Bot Field: <input name="bot-field" /></label></p>

              <div class="form-grid-2">
                <div class="input-group">
                  <label for="nom">Nom Complet</label>
                  <input type="text" id="nom" name="nom" required placeholder="Ex: Jean Dupont" />
                </div>
                <div class="input-group">
                  <label for="email">Email</label>
                  <input type="email" id="email" name="email" required placeholder="Ex: jean.dupont@email.com" />
                </div>
              </div>

              <div class="form-grid-2">
                <div class="input-group">
                  <label for="telephone">Téléphone</label>
                  <input type="tel" id="telephone" name="telephone" required placeholder="Ex: +33 6 00 00 00 00" />
                </div>
                <div class="input-group">
                  <label for="type">Type de trajet</label>
                  <select id="type" name="type">
                    <option value="transfert">Transfert Aéroport / Gare</option>
                    <option value="disposition">Mise à disposition (heure/journée)</option>
                    <option value="longue-distance">Longue distance</option>
                    <option value="evenement">Événement / Mariage</option>
                  </select>
                </div>
              </div>

              <div class="input-group">
                <label for="message">Détails du trajet</label>
                <textarea id="message" name="message" rows="4" required placeholder="Date, heure, lieu de prise en charge, destination, nombre de passagers..."></textarea>
              </div>

              <button type="submit" class="submit-btn" id="submit-btn">
                <span>Envoyer ma demande</span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </button>
              
              <div id="form-message" class="form-status"></div>
            </form>
          </div>
        </div>
      </div>
    </section>
    
    <!-- MAP IMAGE SECTION -->
    <section class="map-section">
      <div class="container">
         <div class="map-content">
            <h2>Notre Zone d'Excellence</h2>
            <p>Nous intervenons sur toute la Côte d'Azur, de Saint-Tropez à Monaco, ainsi que pour vos transferts longue distance en Europe.</p>
         </div>
         <div class="map-visual">
            <img src="/assets/img/destinations/vtc-tesla-nice.webp" alt="Carte VTC Côte d'Azur" class="map-img-placeholder" />
            <div class="map-overlay">
               <span>Nice</span>
               <span>Cannes</span>
               <span>Monaco</span>
               <span>Saint-Tropez</span>
            </div>
         </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* --- HERO SECTION --- */
  .contact-hero {
    position: relative;
    height: 60vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: -50px; /* Chevauchement */
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('/assets/img/hero/hero-mariage.webp');
    background-size: cover;
    background-position: center;
    filter: brightness(0.6);
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(10,10,10,0.3), rgba(10,10,10,0.8));
    z-index: 2;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: white;
    max-width: 800px;
  }

  .hero-badge {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(212, 175, 55, 0.2);
    border: 1px solid #d4af37;
    border-radius: 50px;
    color: #d4af37;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(5px);
  }

  .contact-hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.1;
    text-shadow: 0 4px 10px rgba(0,0,0,0.3);
  }

  .contact-hero .lead {
    font-size: 1.25rem;
    color: #e0e0e0;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #d4af37;
    color: black;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s;
  }

  .btn-primary:hover {
    background: white;
    transform: translateY(-2px);
  }

  .btn-secondary {
    padding: 1rem 2rem;
    background: rgba(255,255,255,0.1);
    color: white;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
    backdrop-filter: blur(5px);
    transition: all 0.3s;
  }

  .btn-secondary:hover {
    background: white;
    color: black;
  }

  /* --- CONTENT SECTION --- */
  .contact-section {
    position: relative;
    z-index: 10;
    padding-bottom: 4rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 350px 1fr;
    gap: 3rem;
  }

  /* SIDEBAR */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    background: white;
    padding: 2rem;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    transition: transform 0.3s;
  }

  .info-card:hover {
    transform: translateY(-5px);
  }

  .info-card.gold-card {
    background: #1a1a1a;
    color: white;
  }

  .info-card.gold-card h3, .info-card.gold-card p {
    color: #e0e0e0;
  }

  .card-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    background: #f5f5f5;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d4af37;
  }

  .gold-card .card-icon {
    background: rgba(212, 175, 55, 0.15);
  }

  .card-text h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .card-text p {
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }

  .contact-link {
    font-weight: 700;
    color: #1a1a1a;
    text-decoration: none;
    font-size: 1.1rem;
  }

  .link-arrow {
    color: #d4af37;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .trust-box {
    text-align: center;
    padding: 2rem;
    background: linear-gradient(135deg, #fdfbf7, #fff);
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 16px;
  }

  .trust-logo {
    width: 60px;
    height: 60px;
    margin-bottom: 1rem;
  }
  
  .trust-box p {
    font-size: 0.9rem;
    color: #8c732b;
    font-weight: 500;
  }

  /* FORMULAIRE */
  .form-wrapper {
    background: white;
    padding: 3rem;
    border-radius: 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.08);
  }

  .form-header {
    margin-bottom: 2.5rem;
  }

  .form-header h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: #1a1a1a;
  }

  .form-header p {
    color: #666;
  }

  .premium-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .input-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1a1a1a;
  }

  .input-group input, 
  .input-group select, 
  .input-group textarea {
    padding: 1rem;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    font-family: inherit;
    font-size: 1rem;
    transition: all 0.3s;
    background: #fcfcfc;
  }

  .input-group input:focus, 
  .input-group select:focus, 
  .input-group textarea:focus {
    border-color: #d4af37;
    box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.1);
    background: white;
    outline: none;
  }

  .submit-btn {
    background: #1a1a1a;
    color: white;
    padding: 1.25rem;
    border: none;
    border-radius: 12px;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    transition: all 0.3s;
    margin-top: 1rem;
  }

  .submit-btn:hover {
    background: #d4af37;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }

  .form-status {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 8px;
    display: none;
  }
  
  .form-status.success { display: block; background: #d1fae5; color: #065f46; }
  .form-status.error { display: block; background: #fee2e2; color: #991b1b; }

  /* MAP SECTION */
  .map-section {
    padding: 4rem 0 6rem;
    background: #f9f9f9;
  }
  
  .map-content {
      text-align: center;
      max-width: 600px;
      margin: 0 auto 3rem;
  }
  
  .map-content h2 { font-size: 2rem; margin-bottom: 1rem; }
  
  .map-visual {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      height: 400px;
  }
  
  .map-img-placeholder {
      width: 100%;
      height: 100%;
      object-fit: cover;
  }
  
  .map-overlay {
      position: absolute;
      bottom: 20px;
      left: 20px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
  }
  
  .map-overlay span {
      background: rgba(255,255,255,0.9);
      padding: 0.5rem 1rem;
      border-radius: 50px;
      font-weight: 600;
      font-size: 0.9rem;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  /* RESPONSIVE */
  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    
    .contact-hero {
        height: auto;
        padding: 8rem 0 6rem;
        margin-bottom: 0;
    }
    
    .form-wrapper {
        padding: 2rem;
    }
  }

  @media (max-width: 768px) {
    .form-grid-2 {
      grid-template-columns: 1fr;
    }
    
    .hero-actions {
        flex-direction: column;
        width: 100%;
    }
    
    .btn-primary, .btn-secondary {
        width: 100%;
        justify-content: center;
    }
  }
  
  .hidden { display: none; }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('contact-form');
    const statusDiv = document.getElementById('form-message');
    const submitBtn = document.getElementById('submit-btn');

    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Simuler un envoi pour démo
        submitBtn.disabled = true;
        submitBtn.querySelector('span').textContent = 'Envoi...';
        
        setTimeout(() => {
             // Fake success pour le moment, à connecter à Netlify
             statusDiv.className = 'form-status success';
             statusDiv.textContent = '✅ Votre demande a bien été envoyée. Nous vous contacterons très vite.';
             form.reset();
             submitBtn.disabled = false;
             submitBtn.querySelector('span').textContent = 'Envoyer ma demande';
             submitBtn.style.background = '#10B981';
        }, 1500);

        // Vrai code pour Netlify (décommenter si prod)
        /*
        try {
          const formData = new FormData(form);
          const response = await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(formData).toString()
          });

          if (response.ok) {
            // Success
          } else {
             throw new Error();
          }
        } catch (error) {
           // Error
        }
        */
      });
    }
  });
</script>
