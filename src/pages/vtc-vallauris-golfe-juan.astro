---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Vallauris Golfe-Juan – Chauffeur Privé Picasso & Plages | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Vallauris Golfe-Juan. Musée Picasso, poteries, débarquement Napoléon. Entre Cannes et Antibes. Service premium 24/7.";
const keywords = [
  'VTC Vallauris',
  'VTC Golfe-Juan',
  'chauffeur privé Vallauris',
  'transfert Cannes Vallauris',
  'VTC plage Golfe-Juan'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-vallauris-golfe-juan"
  canonical="/vtc-vallauris-golfe-juan"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Vallauris Golfe-Juan", url: "/vtc-vallauris-golfe-juan" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Où voir Picasso à Vallauris ?","acceptedAnswer":{"@type":"Answer","text":"Au Musée National Picasso, dans la chapelle du château, pour admirer 'La Guerre et la Paix'."}},{"@type":"Question","name":"Golfe-Juan a-t-il uen gare ?","acceptedAnswer":{"@type":"Answer","text":"Oui, mais nos VTC vous déposent directement à votre hôtel ou résidence, sans attente et avec vos bagages."}}]}}
>
  <PageHero 
    title="VTC Vallauris Golfe-Juan"
    subtitle="La cité de la céramique et des peintres. Musée Picasso, plages de sable fin et histoire napoléonienne."
    backgroundImage="/assets/img/destinations/cannes-palais-festivals.webp"
    badge="PICASSO • CÉRAMIQUE • PLAGES"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Art & Histoire"
      image="/assets/img/fun-buzz/OIPhh.jpg"
      alt="VTC Vallauris"
      imageSide="right"
      ctaText="Réserver un transfert"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Vallauris</strong> est la capitale mondiale de la céramique d'art, rendue célèbre par <strong>Pablo Picasso</strong> qui y vécut et créa. En bord de mer, <strong>Golfe-Juan</strong> est le lieu historique du débarquement de Napoléon en 1815.
      </p>
      <p class="fade-in-section">
        Entre culture et plages familiales, ECOFUNDRIVE vous accompagne. Visitez les ateliers de poterie ou profitez du soleil sans souci de stationnement.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Cannes : 10 min</span>
        <span class="distance-badge">📍 Antibes : 10 min</span>
        <span class="distance-badge">📍 Nice : 30 min</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Services Vallauris</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">🎨</span><h3>Musée Picasso</h3><p>Visite de la chapelle "Guerre et Paix" et du musée.</p></div>
          <div class="service-card"><span class="service-icon">🏺</span><h3>Poteries</h3><p>Circuit découverte des ateliers d'artisans d'art.</p></div>
          <div class="service-card"><span class="service-icon">🏖️</span><h3>Plages Golfe-Juan</h3><p>Transport vers les plages de sable et le Vieux Port.</p></div>
          <div class="service-card"><span class="service-icon">🎩</span><h3>Route Napoléon</h3><p>Départ de la route historique vers les Alpes.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez Vallauris</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/destinations/cannes-palais-festivals.webp" alt="Musée Picasso" title="🎨 Musée National" description="Admirez l'œuvre monumentale 'La Guerre et la Paix' dans la chapelle romane." link="/reservation" />
        <CategoryCard image="/assets/img/fun-buzz/OIPhh.jpg" alt="Céramique" title="🏺 Capitale Céramique" description="Un savoir-faire unique. Des dizaines de galeries et ateliers à visiter." link="/reservation" />
        <CategoryCard image="/assets/img/fun-buzz/OIP.jpg" alt="Plages Golfe-Juan" title="🏖️ Plages du Soleil" description="Sable fin et ambiance familiale face aux îles de Lérins. Port de plaisance animé." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC à Vallauris</h2>
        <p>Sur les traces de Picasso ou de Napoléon. Voyagez avec style.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-cannes" class="text-dark hover-gold">VTC Cannes</a>
        <a href="/vtc-antibes" class="text-dark hover-gold">VTC Antibes</a>
        <a href="/vtc-juan-les-pins" class="text-dark hover-gold">VTC Juan</a>
        <a href="/vtc-mougins" class="text-dark hover-gold">VTC Mougins</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #00b0f0; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(0, 176, 240, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(0, 176, 240, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #00b0f0; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #00b0f0, #66d0f7); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #00b0f0; color: #00b0f0; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
