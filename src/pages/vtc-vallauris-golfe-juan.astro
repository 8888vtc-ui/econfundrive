---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

import PricingRequest from '../components/PricingRequest.astro';
const title = "VTC Vallauris Golfe-Juan – Chauffeur Privé Picasso & Plages | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Vallauris et Golfe-Juan. Musée Picasso, poteries, plages de sable. Entre Cannes et Antibes. Transferts aéroport Nice. Service premium.";
const keywords = [
  'VTC Vallauris',
  'VTC Golfe-Juan',
  'chauffeur privé Vallauris',
  'transfert Cannes Vallauris',
  'VTC plage Golfe-Juan'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-vallauris-golfe-juan"
  canonical="/vtc-vallauris-golfe-juan"
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Vallauris Golfe-Juan", url: "/vtc-vallauris-golfe-juan" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Vallauris est-elle proche de Cannes ?","acceptedAnswer":{"@type":"Answer","text":"Oui, Vallauris est située à seulement 6 km de Cannes, soit 10-15 minutes en VTC. Golfe-Juan offre de belles plages de sable entre Cannes et Antibes."}},{"@type":"Question","name":"Proposez-vous des transferts pour les ateliers de poterie ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous organisons des transferts vers les nombreux ateliers de céramique de Vallauris, ville rendue célèbre par Picasso."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tarifs & Devis</h2>
      <PricingRequest />
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Découvrez Vallauris Golfe-Juan</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/cannes-palais-festivals.png"
          alt="Musée Picasso Vallauris"
          title="Musée Picasso"
          description="La chapelle romane de Vallauris abrite 'La Guerre et la Paix', chef-d'œuvre monumental de Picasso."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/cannes-palais-festivals.png"
          alt="Poteries Vallauris"
          title="Ateliers de Céramique"
          description="Vallauris, capitale de la poterie depuis le XVIe siècle. Ateliers d'artisans et boutiques de céramique."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/cannes-palais-festivals.png"
          alt="Plage Golfe-Juan"
          title="Plages de Golfe-Juan"
          description="Sable fin, eau turquoise, restaurants de plage. Station balnéaire familiale entre Cannes et Antibes."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-cannes" class="text-dark hover-gold">VTC Cannes</a>
        <a href="/vtc-antibes" class="text-dark hover-gold">VTC Antibes</a>
        <a href="/vtc-mougins" class="text-dark hover-gold">VTC Mougins</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
