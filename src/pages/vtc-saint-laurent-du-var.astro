---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Saint-Laurent-du-Var – Chauffeur Privé Cap 3000 | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Saint-Laurent-du-Var. Porte de Nice. Cap 3000, port de plaisance, plages. Transferts aéroport Nice en 5 min. Service premium.";
const keywords = [
  'VTC Saint-Laurent-du-Var',
  'chauffeur privé Saint-Laurent',
  'VTC Cap 3000',
  'transfert aéroport Saint-Laurent-du-Var',
  'VTC port Saint-Laurent'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-saint-laurent-du-var"
  canonical="/vtc-saint-laurent-du-var"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Saint-Laurent-du-Var", url: "/vtc-saint-laurent-du-var" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien de temps depuis l'aéroport ?","acceptedAnswer":{"@type":"Answer","text":"Saint-Laurent est la ville voisine de l'aéroport. Le transfert prend seulement 5-10 minutes."}},{"@type":"Question","name":"Desservez-vous Cap 3000 ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous effectuons des déposes et récupérations aux entrées principales du centre commercial Cap 3000."}}]}}
>
  <PageHero 
    title="VTC Saint-Laurent-du-Var"
    subtitle="La porte de Nice. Shopping à Cap 3000, port de plaisance animé et proximité immédiate de l'aéroport."
    backgroundImage="/assets/img/destinations/destination-nice.webp"
    badge="CAP 3000 • PORT • AÉROPORT"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Shopping & Plaisance"
      image="/assets/img/fun-buzz/OIPhh.jpg"
      alt="VTC Saint-Laurent-du-Var"
      imageSide="right"
      ctaText="Réserver un transfert"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Saint-Laurent-du-Var</strong> est dynamique et idéalement située. Elle abrite <strong>Cap 3000</strong>, élu meilleur centre commercial du monde, et un grand port de plaisance bordé de restaurants.
      </p>
      <p class="fade-in-section">
        À 5 minutes de l'aéroport de Nice, c'est une étape pratique et agréable. ECOFUNDRIVE facilite vos transferts shopping ou vos soirées au port.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Aéroport : 5 min</span>
        <span class="distance-badge">📍 Nice Centre : 15 min</span>
        <span class="distance-badge">📍 Antibes : 15 min</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Services Saint-Laurent</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">🛍️</span><h3>Shopping Cap 3000</h3><p>Dépose VIP pour une journée shopping face à la mer.</p></div>
          <div class="service-card"><span class="service-icon">✈️</span><h3>Transfert Express</h3><p>La liaison la plus rapide vers/depuis l'aéroport de Nice.</p></div>
          <div class="service-card"><span class="service-icon">🍽️</span><h3>Port de Plaisance</h3><p>Soirées restaurants et bars sur la promenade du port.</p></div>
          <div class="service-card"><span class="service-icon">🏢</span><h3>Zone Industrielle</h3><p>Transferts professionnels vers la zone d'activité.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez Saint-Laurent</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/destinations/destination-nice.webp" alt="Cap 3000" title="🛍️ Cap 3000" description="Le centre commercial iconique de la Riviera. Luxe, mode et gastronomie face à la mer." link="/reservation" />
        <CategoryCard image="/assets/img/fun-buzz/OIPhh.jpg" alt="Port Saint-Laurent" title="⛵ Port de Plaisance" description="L'un des plus grands ports de la Côte. Promenade animée jour et nuit." link="/reservation" />
        <CategoryCard image="/assets/img/fun-buzz/interieur.jpg" alt="Plages Saint-Laurent" title="🏖️ Plages & Loisirs" description="Plages de galets aménagées, clubs nautiques et beach volley." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC à Saint-Laurent</h2>
        <p>Shopping, business ou détente. Un chauffeur à votre service.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-cagnes-sur-mer" class="text-dark hover-gold">VTC Cagnes</a>
        <a href="/vtc-villeneuve-loubet" class="text-dark hover-gold">VTC Villeneuve</a>
        <a href="/vtc-antibes" class="text-dark hover-gold">VTC Antibes</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #00b0f0; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(0, 176, 240, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(0, 176, 240, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #00b0f0; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #00b0f0, #66d0f7); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #00b0f0; color: #00b0f0; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
