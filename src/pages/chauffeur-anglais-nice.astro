---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionImageText from '../components/SectionImageText.astro';

const title = "English-Speaking Chauffeur Nice – Private Driver for Tourists | ECOFUNDRIVE";
const description = "Need an English-speaking driver on the French Riviera? Our multilingual chauffeurs provide comfortable, stress-free transfers for English speaking travelers.";
const keywords = [
  'English speaking driver Nice',
  'English chauffeur French Riviera',
  'private driver English Nice',
  'English speaking VTC',
  'bilingual chauffeur Nice'
];
---

<BaseLayout
  title={title}
  description={description}
  currentPage="chauffeur-anglais-nice"
  canonical="/chauffeur-anglais-nice"
  keywords={keywords}
  lang="fr"
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "Chauffeur Anglophone", url: "/chauffeur-anglais-nice" }
  ]}
  schema={{
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "English-Speaking Private Driver Nice",
    "description": description,
    "provider": {
      "@type": "Organization",
      "name": "ECOFUNDRIVE"
    },
    "availableLanguage": ["English", "French"],
    "areaServed": "Nice, French Riviera"
  }}
>
  <main class="page-content">
    <div class="container py-lg">
      <h1 class="text-center mb-xl">English-Speaking Chauffeur in Nice</h1>
      <p class="lead text-center mb-xl">
        Vous cherchez un chauffeur anglophone pour vos clients internationaux ? Nous offrons un service VTC bilingue parfait pour les touristes et voyageurs d'affaires anglophones.
      </p>
    </div>

    <!-- WHY ENGLISH DRIVER -->
    <SectionImageText
      title="Why Choose an English-Speaking Driver?"
      image="/assets/img/fun-buzz/OIP.jpg"
      alt="English speaking chauffeur Nice"
      imageSide="right"
      ctaText="Book English Driver"
      ctaLink="/reservation"
    >
      <p>
        <strong>For international travelers</strong>, navigating the French Riviera can be overwhelming. Street signs are in French, menus are in French, and most taxi drivers speak limited English.
      </p>
      <p>
        Our English-speaking chauffeurs don't just drive – they become your local guide, translator, and concierge. They can recommend restaurants, explain local customs, and ensure you never feel lost.
      </p>
    </SectionImageText>

    <!-- SERVICES FOR ENGLISH SPEAKERS -->
    <section class="mb-xl container">
      <h2 class="text-center mb-lg">Services for English-Speaking Travelers</h2>
      <div class="grid-3-cols">
        <div class="card-content bg-light p-4 rounded">
          <h3 class="mb-3">✈️ Airport Transfers</h3>
          <p>Your driver meets you in arrivals with a name sign. No confusion, no searching for transport – just a warm welcome in perfect English.</p>
        </div>
        <div class="card-content bg-light p-4 rounded">
          <h3 class="mb-3">🏰 Guided Tours</h3>
          <p>Half-day and full-day tours with English commentary. Monaco, Eze, Grasse, Saint-Tropez... Your driver shares local history and insider tips.</p>
        </div>
        <div class="card-content bg-light p-4 rounded">
          <h3 class="mb-3">💼 Business Services</h3>
          <p>Impress your international clients with seamless English-speaking transport for meetings, conferences, and corporate events.</p>
        </div>
      </div>
    </section>

    <!-- MULTILINGUAL TEAM -->
    <SectionImageText
      title="Notre Équipe Multilingue"
      image="/assets/img/fun-buzz/espace.jpg"
      alt="Chauffeur bilingue"
      imageSide="left"
      ctaText="Réserver un Chauffeur Anglophone"
      ctaLink="/reservation"
    >
      <p>
        Nos chauffeurs parlent couramment :
      </p>
      <ul>
        <li><strong>Anglais (English)</strong> : Tous nos chauffeurs</li>
        <li><strong>Français</strong> : Langue maternelle</li>
        <li><strong>Italien (Italiano)</strong> : Certains chauffeurs</li>
        <li><strong>Russe (Русский)</strong> : Sur demande</li>
      </ul>
      <p>
        <strong>Pour les conciergeries et hôtels :</strong> Nous pouvons garantir un chauffeur anglophone pour vos clients VIP. Contactez-nous pour établir un partenariat.
      </p>
    </SectionImageText>

    <!-- FOR HOTELS AND CONCIERGES -->
    <section class="mb-xl container">
      <h2 class="text-center mb-lg">Pour les Hôtels et Conciergeries</h2>
      <div class="grid-2-cols">
        <div class="card-content bg-light p-4 rounded">
          <h3 class="mb-3">🏨 Service Dédié Hôtels</h3>
          <p>Vous êtes concierge ou responsable de réception ? Nous offrons un service prioritaire pour vos clients internationaux. Facture centralisée, réponse rapide, qualité garantie.</p>
        </div>
        <div class="card-content bg-light p-4 rounded">
          <h3 class="mb-3">🌍 Clientèle Internationale</h3>
          <p>Nice accueille des millions de touristes anglophones chaque année. Offrez-leur une expérience locale sans barrière linguistique.</p>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="mb-xl container">
      <div class="text-center bg-light p-5 rounded">
        <h2 class="mb-4">Book Your English-Speaking Driver</h2>
        <p class="lead mb-4">
          Whether you're a traveler or a hotel concierge, we're here to help.
        </p>
        <div class="d-flex justify-content-center gap-3">
          <a href="/reservation" class="btn btn-primary">Book Transfer</a>
          <a href="https://wa.me/33616552811" class="btn btn-outline">WhatsApp Us</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
