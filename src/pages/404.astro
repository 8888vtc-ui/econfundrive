---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Page non trouvée | ECOFUNDRIVE"
  description="La page que vous recherchez n'existe pas. Retournez à l'accueil ou contactez-nous."
  currentPage="404"
  skipBaseSchema={true}
>
  <main id="main-content" class="container py-xl">
    <div class="error-page">
      <h1 class="error-code">404</h1>
      <h2 class="error-title">Page non trouvée</h2>
      <p class="error-message">
        Oups ! La page que vous recherchez n'existe pas ou a été déplacée.
      </p>
      
      <div class="error-actions">
        <a href="/" class="btn-primary">Retour à l'accueil</a>
        <a href="/reservation" class="btn-secondary">Réserver un VTC</a>
      </div>

      <div class="quick-links">
        <h3>Pages populaires :</h3>
        <ul>
          <li><a href="/vtc-nice">VTC Nice</a></li>
          <li><a href="/vtc-monaco">VTC Monaco</a></li>
          <li><a href="/vtc-cannes">VTC Cannes</a></li>
          <li><a href="/transfert-nice-aeroport-monaco">Nice → Monaco</a></li>
          <li><a href="/contact">Demander un devis</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div class="contact-box">
        <h3>Besoin d'aide ?</h3>
        <p><strong>WhatsApp :</strong> <a href="https://wa.me/33616552811">+33 6 16 55 28 11</a></p>
        <p><strong>Téléphone :</strong> <a href="tel:+33616552811">+33 6 16 55 28 11</a></p>
        <p>Disponible 24h/24, 7j/7</p>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .error-page {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    padding: 2rem;
  }
  .error-code {
    font-size: 8rem;
    font-weight: 700;
    color: #00b0f0;
    line-height: 1;
    margin-bottom: 0.5rem;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
  }
  .error-title {
    font-size: 2rem;
    color: #333;
    margin-bottom: 1rem;
  }
  .error-message {
    font-size: 1.1rem;
    color: #666;
    margin-bottom: 2rem;
  }
  .error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .btn-primary {
    background: linear-gradient(135deg, #00b0f0, #66d0f7);
    color: #0a0c17;
    padding: 1rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s;
  }
  .btn-primary:hover {
    transform: translateY(-2px);
  }
  .btn-secondary {
    background: #0a0c17;
    color: #00b0f0;
    padding: 1rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
  }
  .quick-links {
    background: #f9f9f9;
    padding: 1.5rem;
    border-radius: 12px;
    margin-bottom: 2rem;
  }
  .quick-links h3 {
    margin-bottom: 1rem;
    color: #00b0f0;
  }
  .quick-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: center;
    list-style: none;
    padding: 0;
  }
  .quick-links a {
    color: #333;
    text-decoration: none;
  }
  .quick-links a:hover {
    color: #00b0f0;
  }
  .contact-box {
    background: linear-gradient(135deg, #00b0f0 0%, #66d0f7 100%);
    padding: 1.5rem;
    border-radius: 12px;
    color: #0a0c17;
  }
  .contact-box h3 {
    margin-bottom: 0.5rem;
  }
  .contact-box a {
    color: #0a0c17;
    font-weight: 600;
  }
</style>
