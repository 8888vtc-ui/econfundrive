---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

import PricingRequest from '../components/PricingRequest.astro';
const title = "VTC Èze – Chauffeur Privé Village Perché & Parfumeries | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Èze. Jardin Exotique, village médiéval, parfumeries Fragonard et Galimard. Circuit Moyenne Corniche. Transferts Nice, Monaco. Service premium.";
const keywords = [
  'VTC Eze',
  'chauffeur privé Eze',
  'VTC parfumerie Eze',
  'transfert Nice Eze',
  'VTC Jardin Exotique Eze'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-eze"
  canonical="/vtc-eze"
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Èze", url: "/vtc-eze" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien de temps pour visiter Èze ?","acceptedAnswer":{"@type":"Answer","text":"Comptez environ 2-3 heures pour visiter le village, le jardin exotique et une parfumerie. Nous pouvons vous attendre ou revenir vous chercher."}},{"@type":"Question","name":"Proposez-vous un circuit Nice - Èze - Monaco ?","acceptedAnswer":{"@type":"Answer","text":"Oui, c'est notre circuit le plus populaire ! Départ de Nice le matin, visite d'Èze (village + parfumerie), déjeuner, puis Monaco l'après-midi. Demi-journée ou journée complète."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tarifs & Devis</h2>
      <PricingRequest />
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Découvrez Èze</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.png"
          alt="Jardin Exotique Èze"
          title="Le Jardin Exotique"
          description="Au sommet du village, un jardin de cactus avec vue panoramique à 360° sur la mer et les Alpes."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.png"
          alt="Parfumerie Fragonard Eze"
          title="Parfumeries"
          description="Visite gratuite des usines Fragonard et Galimard. Découvrez les secrets de la parfumerie provençale."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.png"
          alt="Moyenne Corniche Eze"
          title="La Moyenne Corniche"
          description="Route panoramique légendaire entre Nice et Monaco, avec arrêt photo à Èze. Vues spectaculaires."
          link="/guide-route-panoramique-nice-eze-monaco"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-monaco" class="text-dark hover-gold">VTC Monaco</a>
        <a href="/vtc-villefranche-sur-mer" class="text-dark hover-gold">VTC Villefranche</a>
        <a href="/vtc-beaulieu-sur-mer" class="text-dark hover-gold">VTC Beaulieu</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
