---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

import PricingRequest from '../components/PricingRequest.astro';
const title = "VTC Beaulieu-sur-Mer – Chauffeur Privé Villa Kérylos | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Beaulieu-sur-Mer. Villa Kérylos, port de plaisance, plages privées, hôtels 5 étoiles. Transferts Nice, Monaco. Service premium 24h/24.";
const keywords = [
  'VTC Beaulieu-sur-Mer',
  'chauffeur privé Beaulieu',
  'VTC Villa Kérylos',
  'transfert Nice Beaulieu',
  'chauffeur Beaulieu Monaco'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-beaulieu-sur-mer"
  canonical="/vtc-beaulieu-sur-mer"
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Beaulieu-sur-Mer", url: "/vtc-beaulieu-sur-mer" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien coûte un VTC de Nice à Beaulieu-sur-Mer ?","acceptedAnswer":{"@type":"Answer","text":"Nos tarifs sont personnalisés selon le véhicule choisi, l'horaire et le niveau de service. Contactez-nous pour un devis gratuit et sans engagement."}},{"@type":"Question","name":"Beaulieu-sur-Mer est-elle proche de Monaco ?","acceptedAnswer":{"@type":"Answer","text":"Oui, Beaulieu est à seulement 8 km de Monaco. Le trajet en VTC prend environ 15-20 minutes."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tarifs & Devis</h2>
      <PricingRequest />
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Découvrez Beaulieu-sur-Mer</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.png"
          alt="Villa Kérylos Beaulieu"
          title="Villa Kérylos"
          description="Réplique unique d'une villa grecque antique, surplombant la mer. Un voyage dans le temps fascinant."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Baie des Fourmis Beaulieu"
          title="La Baie des Fourmis"
          description="L'une des plus belles plages de la Côte d'Azur, avec vue sur le Cap Ferrat. Eau cristalline garantie."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Port Beaulieu"
          title="Le Port de Plaisance"
          description="Port élégant avec yachts de luxe, restaurants et promenade le long du quai."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-monaco" class="text-dark hover-gold">VTC Monaco</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-villefranche-sur-mer" class="text-dark hover-gold">VTC Villefranche</a>
        <a href="/vtc-cap-ferrat" class="text-dark hover-gold">VTC Cap Ferrat</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
