---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Beaulieu-sur-Mer – Chauffeur Privé Villa Kérylos | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Beaulieu-sur-Mer. Villa Kérylos, La Réserve, port de plaisance. La 'petite Afrique' entre Nice et Monaco. Service premium 24/7.";
const keywords = [
  'VTC Beaulieu-sur-Mer',
  'chauffeur privé Beaulieu',
  'VTC Villa Kérylos',
  'transfert Monaco Beaulieu',
  'VTC La Réserve Beaulieu'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-beaulieu-sur-mer"
  canonical="/vtc-beaulieu-sur-mer"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Beaulieu-sur-Mer", url: "/vtc-beaulieu-sur-mer" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Pourquoi 'petite Afrique' ?","acceptedAnswer":{"@type":"Answer","text":"Beaulieu bénéficie d'un microclimat exceptionnel, protégée par les montagnes. Les hivers sont si doux que des plantes tropicales poussent naturellement."}},{"@type":"Question","name":"Qu'est-ce que la Villa Kérylos ?","acceptedAnswer":{"@type":"Answer","text":"Une reconstitution unique d'une demeure grecque antique, construite au début du XXe siècle. Classée monument historique."}}]}}
>
  <PageHero 
    title="VTC Beaulieu-sur-Mer"
    subtitle="La 'petite Afrique' de la Riviera. Villa Kérylos, La Réserve, microclimat exceptionnel entre Nice et Monaco."
    backgroundImage="/assets/img/destinations/destination-monaco.webp"
    badge="PETITE AFRIQUE • VILLA KÉRYLOS"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="La Douceur de Vivre"
      image="/assets/img/about/vehicule-premium.webp"
      alt="VTC Beaulieu-sur-Mer"
      imageSide="right"
      ctaText="Réserver un transfert"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        Surnommée <strong>"la petite Afrique"</strong> pour son microclimat exceptionnellement doux, <strong>Beaulieu-sur-Mer</strong> est une station balnéaire de prestige nichée entre Nice et Monaco.
      </p>
      <p class="fade-in-section">
        La <strong>Villa Kérylos</strong>, reconstitution unique d'une demeure grecque antique, est le joyau culturel de la commune. ECOFUNDRIVE assure les transferts vers les établissements de luxe comme <strong>La Réserve de Beaulieu</strong>.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Nice : 15 min</span>
        <span class="distance-badge">📍 Monaco : 10 min</span>
        <span class="distance-badge">📍 Èze : 8 min</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Nos Services à Beaulieu</h2>
        <div class="services-grid">
          <div class="service-card">
            <span class="service-icon">🏨</span>
            <h3>Hôtels de Luxe</h3>
            <p>La Réserve, Royal Riviera et tous les établissements prestigieux.</p>
          </div>
          <div class="service-card">
            <span class="service-icon">⛵</span>
            <h3>Port de Plaisance</h3>
            <p>Transferts propriétaires et équipages de yachts.</p>
          </div>
          <div class="service-card">
            <span class="service-icon">🏛️</span>
            <h3>Villa Kérylos</h3>
            <p>Excursion avec attente pour visiter ce chef-d'œuvre classé.</p>
          </div>
          <div class="service-card">
            <span class="service-icon">🛤️</span>
            <h3>Circuit Basse Corniche</h3>
            <p>Nice → Villefranche → Beaulieu → Monaco. Le plus beau littoral.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez Beaulieu</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/hero/hero-mariage.webp"
          alt="Villa Kérylos"
          title="🏛️ Villa Kérylos"
          description="Reconstitution fascinante d'une demeure grecque antique avec vue imprenable sur la Méditerranée."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Port Beaulieu"
          title="⛵ Port de Beaulieu"
          description="Charmant port de plaisance accueillant yachts et bateaux dans un cadre préservé."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/about/vehicule-premium.webp"
          alt="La Réserve"
          title="⭐ La Réserve"
          description="Palace mythique de la Riviera, étoilé Michelin, vue sublime sur le cap Ferrat."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC à Beaulieu</h2>
        <p>Villa Kérylos, hôtels de luxe, port... Profitez du charme unique de la petite Afrique.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-villefranche-sur-mer" class="text-dark hover-gold">VTC Villefranche</a>
        <a href="/vtc-cap-ferrat" class="text-dark hover-gold">VTC Cap-Ferrat</a>
        <a href="/vtc-eze" class="text-dark hover-gold">VTC Èze</a>
        <a href="/vtc-monaco" class="text-dark hover-gold">VTC Monaco</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-menton" class="text-dark hover-gold">VTC Menton</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17 0%, #1a1a2e 100%); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 16px; padding: 2rem; text-align: center; transition: all 0.3s; }
  .service-card:hover { transform: translateY(-5px); border-color: #d4af37; }
  .service-icon { font-size: 2rem; display: block; margin-bottom: 1rem; }
  .service-card h3 { color: #d4af37; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17 0%, #1a1a2e 100%); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; position: relative; }
  .cta-premium::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, transparent, #d4af37, transparent); }
  .cta-premium h2 { color: white; font-size: 2rem; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; font-size: 1.1rem; max-width: 600px; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; transition: all 0.3s; }
  .btn-gold:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4); }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; transition: all 0.3s; }
  .btn-outline:hover { background: #d4af37; color: #000; }
</style>
