---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "Grand Prix de Monaco – Guide Transport VTC F1 | ECOFUNDRIVE";
const description = "Guide complet pour se déplacer au Grand Prix F1 de Monaco. Évitez les bouchons, accédez aux tribunes VIP en chauffeur privé. Transferts Nice-Monaco.";
const keywords = [
  'VTC Grand Prix Monaco',
  'transport F1 Monaco',
  'chauffeur privé GP Monaco',
  'transfert Nice Monaco F1',
  'accès VIP F1'
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": "https://www.ecofundrive.com/assets/img/destinations/destination-monaco.webp",
  "author": { "@type": "Organization", "name": "ECOFUNDRIVE" }
};
---

<BaseLayout
  title={title}
  description={description}
  currentPage="guide-grand-prix-monaco-deplacements"
  canonical="/guide-grand-prix-monaco-deplacements"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Guides", url: "/guides" },
    { name: "Grand Prix Monaco", url: "/guide-grand-prix-monaco-deplacements" }
  ]}
  schema={schema}
>
  <PageHero 
    title="Grand Prix de Monaco"
    subtitle="Le joyau de la Couronne F1. Guide logistique pour un week-end de course sans stress."
    backgroundImage="/assets/img/destinations/destination-monaco.webp"
    badge="F1 • VIP • LOGISTIQUE"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Le Défi Logistique"
      image="/assets/img/destinations/destination-monaco.webp"
      alt="Circuit F1 Monaco"
      imageSide="right"
      ctaText="Réserver mon Chauffeur"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        Le <strong>Grand Prix de Monaco</strong> est mythique, mais son accès est un défi. Routes barrées, foule immense, parkings saturés... Se déplacer peut vite tourner au cauchemar.
      </p>
      <p class="fade-in-section">
        Le secret d'un GP réussi ? Une logistique impeccable. Nos chauffeurs VTC maîtrisent les itinéraires alternatifs et les points de dépose stratégiques pour vous faire gagner un temps précieux.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">🏎️ Circuit Urbain</span>
        <span class="distance-badge">🚦 Trafic Intense</span>
        <span class="distance-badge">🤵 Service Premium</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Planning & Stratégie</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">📅</span><h3>Jeudi & Vendredi</h3><p>Essais libres. Trafic dense mais gérable. Arrivez tôt pour profiter de l'ambiance.</p></div>
          <div class="service-card"><span class="service-icon">⏱️</span><h3>Samedi Qualifs</h3><p>Journée cruciale. La foule est dense. Départ recommandé de Nice avant 9h00.</p></div>
          <div class="service-card"><span class="service-icon">🏆</span><h3>Dimanche Course</h3><p>Le Grand Jour. Accès quasi impossible sans accréditation ou VTC. <strong>Réservez 1 mois avant.</strong></p></div>
          <div class="service-card"><span class="service-icon">🌙</span><h3>Soirées Amber Lounge</h3><p>Service de nuit pour les after-parties les plus exclusives de la saison.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Points de Dépose Stratégiques</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/destinations/destination-monaco.png" alt="Fontvieille" title="📍 Fontvieille" description="Idéal pour les tribunes K, L, M, O, P et le Rocher. Accès via tunnel." link="/reservation" />
        <CategoryCard image="/assets/img/services/service-business.webp" alt="Casino" title="📍 Casino / Beausoleil" description="Pour les terrasses VIP, l'Hôtel de Paris et la tribune B (Casino)." link="/reservation" />
        <CategoryCard image="/assets/img/services/service-aeroport.webp" alt="Gare / Port" title="📍 La Condamine" description="Accès tribunes T, V, X (Ligne départ) et secteur Rascasse." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Sécurisez votre Transport F1</h2>
        <p>Les disponibilités pour le week-end du Grand Prix partent très vite.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver Maintenant</a>
          <a href="https://wa.me/33616552811" class="btn-outline">Devis WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Voir aussi</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-monaco" class="text-dark hover-gold">VTC Monaco</a>
        <a href="/transfert-nice-aeroport-monaco" class="text-dark hover-gold">Transfert Nice → Monaco</a>
        <a href="/vtc-nice" class="text-dark hover-gold">Hébergement Nice</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #d4af37; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
