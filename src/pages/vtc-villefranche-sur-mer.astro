---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Villefranche-sur-Mer – Chauffeur Privé Rade & Cocteau | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Villefranche-sur-Mer. Rade légendaire, Chapelle Cocteau, escale croisières. Transferts Monaco, Nice. Service premium 24/7.";
const keywords = [
  'VTC Villefranche-sur-Mer',
  'chauffeur privé Villefranche',
  'VTC croisière Villefranche',
  'transfert Chapelle Cocteau',
  'VTC rade Villefranche'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-villefranche-sur-mer"
  canonical="/vtc-villefranche-sur-mer"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Villefranche-sur-Mer", url: "/vtc-villefranche-sur-mer" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Villefranche est-elle une escale de croisière ?","acceptedAnswer":{"@type":"Answer","text":"Oui, la rade de Villefranche accueille les navires de croisière. Nous assurons les transferts vers Monaco, Nice et les villages."}},{"@type":"Question","name":"Qu'est-ce que la Chapelle Cocteau ?","acceptedAnswer":{"@type":"Answer","text":"La Chapelle Saint-Pierre, décorée par Jean Cocteau en 1957, est un joyau artistique sur le port."}}]}}
>
  <PageHero 
    title="VTC Villefranche-sur-Mer"
    subtitle="La plus belle rade du monde. Chapelle Cocteau, escale croisières, vieille ville colorée aux ruelles médiévales."
    backgroundImage="/assets/img/destinations/destination-nice.webp"
    badge="RADE LÉGENDAIRE • CROISIÈRES"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="La Perle de la Rade"
      image="/assets/img/about/chauffeur-professionnel.webp"
      alt="VTC Villefranche rade"
      imageSide="right"
      ctaText="Réserver un transfert"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Villefranche-sur-Mer</strong> possède l'une des plus belles rades du monde, si profonde qu'elle accueille navires de croisière et même porte-avions américains. Sa vieille ville aux couleurs ocres et roses, la <strong>Chapelle Cocteau</strong> et la mystérieuse <strong>Rue Obscura</strong> en font un joyau.
      </p>
      <p class="fade-in-section">
        ECOFUNDRIVE est le partenaire idéal des <strong>croisiéristes</strong> débarquant à Villefranche. Excursions vers Monaco, Èze, Nice ou les villages perchés pendant votre escale.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Nice : 10 min</span>
        <span class="distance-badge">📍 Monaco : 15 min</span>
        <span class="distance-badge">📍 Èze : 10 min</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Nos Services à Villefranche</h2>
        <div class="services-grid">
          <div class="service-card">
            <span class="service-icon">🚢</span>
            <h3>Transferts Croisières</h3>
            <p>Excursions sur mesure depuis le port : Monaco, Èze, Nice. Retour garanti à l'heure.</p>
          </div>
          <div class="service-card">
            <span class="service-icon">🛤️</span>
            <h3>Circuit Corniche</h3>
            <p>Villefranche → Èze → La Turbie → Monaco. Route panoramique par excellence.</p>
          </div>
          <div class="service-card">
            <span class="service-icon">🏖️</span>
            <h3>Navettes Plages</h3>
            <p>Paloma Beach, Passable et criques secrètes du Cap-Ferrat.</p>
          </div>
          <div class="service-card">
            <span class="service-icon">🍽️</span>
            <h3>Transferts Restaurants</h3>
            <p>Tables du port et de la Darse. Service aller-retour soirées.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez Villefranche</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/hero/hero-ete.webp"
          alt="Rade Villefranche"
          title="⛵ La Rade Légendaire"
          description="L'une des plus profondes du monde. Escale des croisières et de la marine américaine."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Chapelle Cocteau"
          title="🎨 Chapelle Cocteau"
          description="Chapelle Saint-Pierre, décorée par Jean Cocteau en 1957. Chef-d'œuvre intime."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.webp"
          alt="Rue Obscura"
          title="🏛️ Rue Obscura"
          description="Rue couverte médiévale de 130 mètres. Témoignage unique du passé de pêcheurs."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC à Villefranche</h2>
        <p>Croisière, excursion, plage... Profitez de la perle de la rade avec votre chauffeur privé.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-cap-ferrat" class="text-dark hover-gold">VTC Cap-Ferrat</a>
        <a href="/vtc-beaulieu-sur-mer" class="text-dark hover-gold">VTC Beaulieu</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-eze" class="text-dark hover-gold">VTC Èze</a>
        <a href="/vtc-monaco" class="text-dark hover-gold">VTC Monaco</a>
        <a href="/guide-route-panoramique-nice-eze-monaco" class="text-dark hover-gold">Guide Corniches</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17 0%, #1a1a2e 100%); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 16px; padding: 2rem; text-align: center; transition: all 0.3s; }
  .service-card:hover { transform: translateY(-5px); border-color: #d4af37; }
  .service-icon { font-size: 2rem; display: block; margin-bottom: 1rem; }
  .service-card h3 { color: #d4af37; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17 0%, #1a1a2e 100%); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; position: relative; }
  .cta-premium::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, transparent, #d4af37, transparent); }
  .cta-premium h2 { color: white; font-size: 2rem; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; font-size: 1.1rem; max-width: 600px; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; transition: all 0.3s; }
  .btn-gold:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4); }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; transition: all 0.3s; }
  .btn-outline:hover { background: #d4af37; color: #000; }
</style>
