---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Fréjus Saint-Raphaël – Chauffeur Privé Var Estérel | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Fréjus et Saint-Raphaël. Massif de l'Estérel, plages, port, arènes romaines. Transferts Nice, Cannes, Saint-Tropez. Service premium 24/7.";
const keywords = ['VTC Fréjus', 'VTC Saint-Raphaël', 'chauffeur privé Var', 'transfert Esterel', 'VTC port Saint-Raphaël'];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-frejus-saint-raphael"
  canonical="/vtc-frejus-saint-raphael"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Fréjus Saint-Raphaël", url: "/vtc-frejus-saint-raphael" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien de temps Nice → Fréjus ?","acceptedAnswer":{"@type":"Answer","text":"Le transfert prend environ 50-60 minutes (60 km via l'autoroute A8)."}},{"@type":"Question","name":"Desservez-vous le port de Saint-Raphaël ?","acceptedAnswer":{"@type":"Answer","text":"Oui, transferts port et Vieux Port pour embarquements vers les îles de Lérins."}}]}}
>
  <PageHero 
    title="VTC Fréjus Saint-Raphaël"
    subtitle="Porte d'entrée du Var et de l'Estérel. Arènes romaines, port de plaisance, plages de sable et massif rougeoyant."
    backgroundImage="/assets/img/destinations/destination-saint-tropez.webp"
    badge="ESTÉREL • VAR • PLAGES"
  />

  <main id="main-content" class="page-content">
    <SectionImageText
      title="Votre Chauffeur Privé dans le Var"
      image="/assets/img/fun-buzz/interieur.jpg"
      alt="VTC Fréjus massif Estérel"
      imageSide="right"
      ctaText="Réserver un transfert"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Fréjus</strong> et <strong>Saint-Raphaël</strong> sont les portes d'entrée du Var et du spectaculaire <strong>massif de l'Estérel</strong>. Patrimoine romain, port de plaisance animé, plages de sable fin et routes panoramiques.
      </p>
      <p class="fade-in-section">
        ECOFUNDRIVE assure les transferts depuis Nice, Cannes et l'aéroport vers cette destination prisée des vacanciers.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Nice : 60 min</span>
        <span class="distance-badge">📍 Cannes : 35 min</span>
        <span class="distance-badge">📍 Saint-Tropez : 45 min</span>
      </div>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez la Région</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/hero/hero-ete.webp" alt="Massif Estérel" title="🏔️ Massif de l'Estérel" description="Roches rouges spectaculaires, randonnées, route de la Corniche d'Or vers Cannes." link="/reservation" />
        <CategoryCard image="/assets/img/fun-buzz/OIPhh.jpg" alt="Arènes Fréjus" title="🏛️ Arènes Romaines" description="Amphithéâtre romain du Ier siècle. Fréjus, ville d'art et d'histoire." link="/reservation" />
        <CategoryCard image="/assets/img/destinations/destination-cannes.webp" alt="Port Saint-Raphaël" title="⛵ Port de Plaisance" description="Vieux Port animé, restaurants, départs vers les îles de Lérins et Saint-Tropez." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC</h2>
        <p>Découvrez le Var et l'Estérel avec votre chauffeur privé.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-saint-tropez" class="text-dark hover-gold">VTC Saint-Tropez</a>
        <a href="/vtc-cannes" class="text-dark hover-gold">VTC Cannes</a>
        <a href="/vtc-mandelieu-la-napoule" class="text-dark hover-gold">VTC Mandelieu</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #00b0f0; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(0, 176, 240, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; font-size: 2rem; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #00b0f0, #66d0f7); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #00b0f0; color: #00b0f0; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
