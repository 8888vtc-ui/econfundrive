---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Carnaval de Nice 2026 – Chauffeur Privé Corso & Bataille de Fleurs | ECOFUNDRIVE";
const description = "Chauffeur privé VTC pour le Carnaval de Nice 2026. Transferts aéroport, navettes Corso Carnavalesque, Bataille de Fleurs. Service premium 24h/24.";
const keywords = [
  'VTC Carnaval Nice',
  'chauffeur Carnaval Nice',
  'transfert Carnaval Nice',
  'VTC Bataille de Fleurs',
  'transport Carnaval Nice 2026'
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "Carnaval de Nice 2026",
  "startDate": "2026-02-14",
  "endDate": "2026-03-01",
  "location": {
    "@type": "Place",
    "name": "Promenade des Anglais & Place Masséna",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Nice",
      "addressCountry": "FR"
    }
  },
  "description": "Le Carnaval de Nice est l'un des plus grands carnavals du monde. ECOFUNDRIVE propose des services VTC premium pour les visiteurs."
};
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-carnaval-nice"
  canonical="/vtc-carnaval-nice"
  schema={schema}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Carnaval Nice", url: "/vtc-carnaval-nice" }
  ]}
>
  <PageHero 
    title="VTC Carnaval de Nice 2026"
    subtitle="Vivez la magie du Roi des Océans. Corsos illuminés, batailles de fleurs et soirées festives."
    backgroundImage="/assets/img/destinations/destination-nice.png"
    badge="14 FÉV - 1 MARS 2026 • CORSO • BATAILLE DE FLEURS"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Le Carnaval en Mode VIP"
      image="/assets/img/destinations/destination-nice.png"
      alt="VTC Carnaval de Nice"
      imageSide="right"
      ctaText="Réserver votre VTC Carnaval"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        Le <strong>Carnaval de Nice</strong> est l'événement hivernal incontournable de la Côte d'Azur. Du 14 février au 1er mars 2026, la ville vibre au rythme des chars et des parades.
      </p>
      <p class="fade-in-section">
        Pour éviter les tracas de stationnement et profiter pleinement de la fête, ECOFUNDRIVE vous dépose au plus près de la <strong>Place Masséna</strong> et de la <strong>Promenade des Anglais</strong>.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📅 Dates : 14 fév - 1 mars</span>
        <span class="distance-badge">📍 Lieu : Masséna / Promenade</span>
        <span class="distance-badge">🚗 Service : 24/7</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Programme & Services</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">🎭</span><h3>Corsos Illuminés</h3><p>Transferts pour les défilés nocturnes spectaculaires.</p></div>
          <div class="service-card"><span class="service-icon">💐</span><h3>Bataille de Fleurs</h3><p>Navettes pour le show fleuri sur la Promenade.</p></div>
          <div class="service-card"><span class="service-icon">✈️</span><h3>Aéroport Nice</h3><p>Accueil arrivée et départ pour les festivaliers.</p></div>
          <div class="service-card"><span class="service-icon">👨‍👩‍👧‍👦</span><h3>Familles</h3><p>Sièges enfants et vans spacieux pour tribus.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">L'Expérience Carnaval</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/destinations/destination-nice.png" alt="Corso Illuminé" title="✨ Corso Illuminé" description="La magie nocturne. Chars géants illuminés et animations visuelles incroyables." link="/reservation" />
        <CategoryCard image="/assets/img/services/service-business.webp" alt="Bataille de Fleurs" title="🌸 Bataille de Fleurs" description="L'élégance à la niçoise. Pluie de mimosas et de lys sur le public." link="/reservation" />
        <CategoryCard image="/assets/img/services/service-aeroport.webp" alt="Transfert Aéroport" title="✈️ Arrivée à Nice" description="Commencez votre séjour sans stress. Votre chauffeur vous attend aux arrivées." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC Carnaval</h2>
        <p>Les places de parking sont rares, nos chauffeurs sont là.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Découvrez aussi</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/guide-que-faire-a-nice-1-3-jours" class="text-dark hover-gold">Visiter Nice</a>
        <a href="/transfert-nice-aeroport-monaco" class="text-dark hover-gold">Aéroport → Monaco</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #d4af37; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
