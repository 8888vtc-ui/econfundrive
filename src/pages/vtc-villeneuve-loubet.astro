---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Villeneuve-Loubet – Chauffeur Privé Marina & Plages | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Villeneuve-Loubet. Marina Baie des Anges, plages, Marineland, Fondation Escoffier. Entre Nice et Cannes. Service premium 24h/24.";
const keywords = [
  'VTC Villeneuve-Loubet',
  'chauffeur privé Villeneuve-Loubet',
  'VTC Marina Baie des Anges',
  'transfert Marineland',
  'VTC plages Villeneuve-Loubet'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-villeneuve-loubet"
  canonical="/vtc-villeneuve-loubet"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Villeneuve-Loubet", url: "/vtc-villeneuve-loubet" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Proposez-vous des transferts Marineland ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous assurons les transferts vers Marineland, Aquasplash et tous les parcs de la zone."}},{"@type":"Question","name":"Desservez-vous la Marina ?","acceptedAnswer":{"@type":"Answer","text":"Absolument, nous effectuons des prises en charge dans toutes les résidences de la Marina Baie des Anges."}}]}}
>
  <PageHero 
    title="VTC Villeneuve-Loubet"
    subtitle="Entre mer et parc naturel. Marina Baie des Anges, plages et Musée Escoffier de l'Art Culinaire."
    backgroundImage="/assets/img/destinations/destination-nice.png"
    badge="MARINA • MARINELAND • ESCOFFIER"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Architecture & Gastronomie"
      image="/assets/img/services/service-business.webp"
      alt="VTC Villeneuve-Loubet"
      imageSide="right"
      ctaText="Réserver un transfert"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Villeneuve-Loubet</strong> est célèbre pour son architecture audacieuse, la <strong>Marina Baie des Anges</strong>, et pour le <strong>Musée Escoffier</strong>, dédié au roi des cuisiniers né dans le village.
      </p>
      <p class="fade-in-section">
        Idéalement située entre Nice et Antibes, la ville offre aussi de vastes parcs naturels et plages de galets. ECOFUNDRIVE vous accompagne pour tous vos déplacements.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Aéroport : 15 min</span>
        <span class="distance-badge">📍 Antibes : 10 min</span>
        <span class="distance-badge">📍 Nice : 20 min</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Services Villeneuve</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">⛵</span><h3>Marina</h3><p>Prise en charge au pied des célèbres pyramides de la Marina.</p></div>
          <div class="service-card"><span class="service-icon">🐬</span><h3>Marineland</h3><p>Navettes pour le parc marin situé à la limite de Biot.</p></div>
          <div class="service-card"><span class="service-icon">👨‍🍳</span><h3>Musée Escoffier</h3><p>Visite de la maison natale d'Auguste Escoffier.</p></div>
          <div class="service-card"><span class="service-icon">🌳</span><h3>Parc Vaugrenier</h3><p>Accès au grand parc départemental naturel.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez Villeneuve</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/destinations/destination-nice.png" alt="Marina Baie des Anges" title="⛵ Marina Baie des Anges" description="Architecture iconique classée Patrimoine du XXe siècle. Port et restaurants." link="/reservation" />
        <CategoryCard image="/assets/img/services/service-business.webp" alt="Musée Escoffier" title="👨‍🍳 Musée Escoffier" description="Temple de l'art culinaire français. Une visite savoureuse au village." link="/reservation" />
        <CategoryCard image="/assets/img/services/service-mise-disposition.webp" alt="Plages" title="🏖️ Plages Naturelles" description="4 km de littoral préservé. Idéal pour la promenade et la baignade." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC à Villeneuve-Loubet</h2>
        <p>Marina, village ou bord de mer. Un chauffeur privé pour tous vos trajets.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-cagnes-sur-mer" class="text-dark hover-gold">VTC Cagnes</a>
        <a href="/vtc-antibes" class="text-dark hover-gold">VTC Antibes</a>
        <a href="/vtc-saint-laurent-du-var" class="text-dark hover-gold">VTC St-Laurent</a>
        <a href="/vtc-biot" class="text-dark hover-gold">VTC Biot</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #d4af37; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>