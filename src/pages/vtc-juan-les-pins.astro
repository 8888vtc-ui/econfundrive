---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Juan-les-Pins – Chauffeur Privé Jazz & Plages | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Juan-les-Pins. Festival Jazz à Juan, plages de sable, vie nocturne, casinos. Station balnéaire Art Déco. Transferts Nice. Service premium 24h/24.";
const keywords = [
  'VTC Juan-les-Pins',
  'chauffeur privé Juan-les-Pins',
  'VTC Jazz à Juan',
  'transfert plages Juan-les-Pins',
  'chauffeur festival jazz'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-juan-les-pins"
  canonical="/vtc-juan-les-pins"
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Juan-les-Pins", url: "/vtc-juan-les-pins" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Proposez-vous des transferts pour Jazz à Juan ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous assurons les transferts vers le festival Jazz à Juan en juillet. Service de récupération après les concerts disponible même tard le soir."}},{"@type":"Question","name":"Juan-les-Pins a-t-elle des plages de sable ?","acceptedAnswer":{"@type":"Answer","text":"Oui, Juan-les-Pins possède les plus belles plages de sable fin de la Baie des Anges, idéales pour les familles."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tarifs & Devis</h2>
      <div class="cta-box">
        <a href="/contact" class="btn-primary">Demander un devis gratuit</a>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Découvrez Juan-les-Pins</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/destination-nice.png"
          alt="Jazz à Juan"
          title="Festival Jazz à Juan"
          description="Créé en 1960, l'un des plus prestigieux festivals de jazz au monde. En plein air face à la pinède en juillet."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Plages Juan-les-Pins"
          title="Plages de Sable Fin"
          description="Les plus belles plages de sable de la Côte d'Azur. Eau cristalline, plages privées et publiques."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/hero/hero-business.webp"
          alt="Vie nocturne Juan-les-Pins"
          title="Vie Nocturne"
          description="Bars, clubs, casino Eden Beach. L'ambiance festive des années folles continue encore aujourd'hui."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-antibes" class="text-dark hover-gold">VTC Antibes</a>
        <a href="/vtc-cannes" class="text-dark hover-gold">VTC Cannes</a>
        <a href="/vtc-cap-ferrat" class="text-dark hover-gold">VTC Cap Ferrat</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
