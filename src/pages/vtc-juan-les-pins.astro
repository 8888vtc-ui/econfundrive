---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Juan-les-Pins – Chauffeur Privé Jazz & Plages | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Juan-les-Pins. Festival Jazz à Juan, plages de sable, vie nocturne Art Déco. Transferts Antibes et aéroport Nice. Service premium 24/7.";
const keywords = [
  'VTC Juan-les-Pins',
  'chauffeur privé Juan-les-Pins',
  'VTC Jazz à Juan',
  'transfert festival Juan-les-Pins',
  'VTC plages Juan'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-juan-les-pins"
  canonical="/vtc-juan-les-pins"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Juan-les-Pins", url: "/vtc-juan-les-pins" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Quand a lieu Jazz à Juan ?","acceptedAnswer":{"@type":"Answer","text":"Le festival Jazz à Juan se tient chaque année en juillet dans la pinède Gould. Réservez votre VTC à l'avance."}},{"@type":"Question","name":"Y a-t-il une vie nocturne ?","acceptedAnswer":{"@type":"Answer","text":"Oui, Juan-les-Pins est réputée pour sa vie nocturne animée. Nous assurons les retours sécurisés 24/7."}}]}}
>
  <PageHero 
    title="VTC Juan-les-Pins"
    subtitle="La station balnéaire Art Déco. Jazz à Juan, plages de sable fin et vie nocturne légendaire."
    backgroundImage="/assets/img/destinations/destination-nice.webp"
    badge="JAZZ • PLAGES • NIGHTLIFE"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Jazz, Plages & Art Déco"
      image="/assets/img/destinations/destination-saint-tropez.webp"
      alt="VTC Juan-les-Pins"
      imageSide="right"
      ctaText="Réserver un transfert"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Juan-les-Pins</strong> est la station balnéaire mythique de la Côte d'Azur. Célèbre pour le <strong>Festival Jazz à Juan</strong> et ses plages de sable fin, elle incarne la douceur de vivre et la fête.
      </p>
      <p class="fade-in-section">
        ECOFUNDRIVE est votre partenaire pour profiter des nuits de Juan sans souci. Navettes festival, transferts plages et retours nocturnes sécurisés.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Antibes : 5 min</span>
        <span class="distance-badge">📍 Cannes : 15 min</span>
        <span class="distance-badge">📍 Nice : 35 min</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Nos Services à Juan</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">🎷</span><h3>Jazz à Juan</h3><p>Navettes festival en juillet. Dépose pinède Gould.</p></div>
          <div class="service-card"><span class="service-icon">🏖️</span><h3>Plages de Sable</h3><p>Transport vers les plages privées et publiques.</p></div>
          <div class="service-card"><span class="service-icon">🌙</span><h3>Retours Nocturnes</h3><p>Service sécurisé après vos soirées clubbing.</p></div>
          <div class="service-card"><span class="service-icon">⛵</span><h3>Port Gallice</h3><p>Transferts vers le port de plaisance de Juan.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez Juan-les-Pins</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/destinations/destination-nice.webp" alt="Jazz à Juan" title="🎷 Jazz à Juan" description="Festival légendaire dans la pinède Gould. Les plus grands noms du jazz face à la mer." link="/reservation" />
        <CategoryCard image="/assets/img/services/service-business.webp" alt="Plages Juan" title="🏖️ Plages de Sable" description="Les plus belles plages de sable entre Nice et Cannes. Eaux turquoise et pinède." link="/reservation" />
        <CategoryCard image="/assets/img/destinations/destination-saint-tropez.webp" alt="Nightlife Juan" title="🍸 Vie Nocturne" description="Bars, clubs, casino. L'épicentre de la fête estivale sur la Riviera." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC à Juan</h2>
        <p>Jazz, plage ou soirée... Profitez de Juan-les-Pins en toute liberté.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-antibes" class="text-dark hover-gold">VTC Antibes</a>
        <a href="/vtc-cannes" class="text-dark hover-gold">VTC Cannes</a>
        <a href="/vtc-biot" class="text-dark hover-gold">VTC Biot</a>
        <a href="/vtc-mougins" class="text-dark hover-gold">VTC Mougins</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #d4af37; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
