---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';

const title = "Van with Driver for Yacht Crew – Antibes & French Riviera | ECOFUNDRIVE";
const description = "Dedicated van with driver for superyacht crew in Antibes & Villeneuve-Loubet. Metro shopping runs, airport transfers, errands, crew transport. VW ID Buzz, fixed rates, available 7/7.";
const keywords = [
  'van with driver yacht crew Antibes',
  'driver for yacht crew French Riviera',
  'yacht crew transport Antibes',
  'chauffeur service superyacht crew',
  'crew assistant driver Antibes',
  'van hire with driver yacht Villeneuve-Loubet'
];
---

<BaseLayout
  title={title}
  description={description}
  currentPage="en-yacht-crew-driver"
  canonical="/en/van-driver-yacht-crew-antibes"
  lang="en"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Home", url: "/en" },
    { name: "Yacht Provisioning", url: "/en/yacht-provisioning-delivery-antibes" },
    { name: "Van with Driver", url: "/en/van-driver-yacht-crew-antibes" }
  ]}
  schema={{"@context":"https://schema.org","@type":"Service","name":"Van with Driver for Yacht Crew","provider":{"@type":"Organization","name":"ECOFUNDRIVE","telephone":"+33616552811"},"areaServed":"Antibes, Villeneuve-Loubet, French Riviera","description":"Dedicated van with driver for superyacht crew. Shopping runs, errands, airport transfers, crew transport."}}
>
  <main id="main-content">
    <section class="hero-section">
      <div class="hero-content">
        <span class="hero-badge">🚐 CREW SERVICES • VAN WITH DRIVER</span>
        <h1>Van with Driver for Yacht Crew</h1>
        <p class="hero-subtitle">Your dedicated driver in Antibes & Villeneuve-Loubet. Metro runs, airport pickups, errands, crew days off — whatever you need, we drive.</p>
        <div class="hero-cta">
          <a href="https://wa.me/33616552811" class="btn btn-whatsapp btn-lg">💬 Book via WhatsApp</a>
          <a href="tel:+33616552811" class="btn btn-outline btn-lg">📞 +33 6 16 55 28 11</a>
        </div>
      </div>
    </section>

    <article class="guide-content container py-xl">
      <div class="article-body">

        <p class="lead"><strong>ECOFUNDRIVE provides a dedicated van with driver for superyacht crews based in Antibes, Villeneuve-Loubet, and across the French Riviera.</strong> Whether you need someone to do the Metro run, collect parcels from DHL, drive the crew to the airport, or shuttle everyone to town for a night out — we're your reliable, English-speaking driver with a spacious VW ID Buzz.</p>

        <h2>What Crew Use Our Van & Driver For</h2>

        <div class="use-grid">
          <div class="use-card">
            <span class="use-icon">🛒</span>
            <h3>Provisioning Runs</h3>
            <p>Metro (Villeneuve-Loubet), Carrefour (Antibes), local markets. We load, transport and deliver to the yacht. The chef sends the list, we do the rest.</p>
          </div>
          <div class="use-card">
            <span class="use-icon">✈️</span>
            <h3>Crew Airport Transfers</h3>
            <p>Crew changes, owner arrivals, guest pickups. Nice Airport (NCE) to Port Vauban or any marina. Meet & greet with name board.</p>
          </div>
          <div class="use-card">
            <span class="use-icon">📦</span>
            <h3>Parcel & Parts Collection</h3>
            <p>DHL, FedEx, UPS depot pickups. Chandlery runs. Collect anything from anywhere and bring it to the boat.</p>
          </div>
          <div class="use-card">
            <span class="use-icon">👔</span>
            <h3>Crew Uniforms & Laundry</h3>
            <p>Drop off and collect crew uniforms, laundry, dry cleaning. We handle the logistics while you work.</p>
          </div>
          <div class="use-card">
            <span class="use-icon">🏖️</span>
            <h3>Crew Days Off</h3>
            <p>Shuttle to town, beach, restaurants, nightlife. Group transport for up to 6 crew members in one vehicle.</p>
          </div>
          <div class="use-card">
            <span class="use-icon">🏥</span>
            <h3>Appointments & Admin</h3>
            <p>Drive crew to doctor, dentist, immigration office, bank, phone shop. We know where everything is in Antibes.</p>
          </div>
        </div>

        <h2>Rates</h2>

        <table class="tarif-table">
          <thead><tr><th>Service</th><th>Rate</th><th>Details</th></tr></thead>
          <tbody>
            <tr><td>Single errand / delivery</td><td class="price-cell">€30–50</td><td>One pickup, one delivery</td></tr>
            <tr><td>Provisioning run (Metro/Carrefour)</td><td class="price-cell">€50–80</td><td>Shopping + quayside delivery</td></tr>
            <tr><td>Airport transfer (Nice NCE)</td><td class="price-cell">€70–90</td><td>Port Vauban ↔ Nice Airport</td></tr>
            <tr><td>Airport + Metro combo</td><td class="price-cell">€120–180</td><td>Airport pickup + provisioning stop</td></tr>
            <tr><td>Half-day dedicated driver (4h)</td><td class="price-cell">€150–200</td><td>Unlimited local runs</td></tr>
            <tr><td>Full-day dedicated driver (8–10h)</td><td class="price-cell">€250–350</td><td>All-inclusive, any errands</td></tr>
            <tr><td>Weekly package (5 days)</td><td class="price-cell">€1,000–1,400</td><td>Dedicated crew driver all week</td></tr>
            <tr><td>Season contract</td><td class="price-cell">On request</td><td>May–September, custom terms</td></tr>
          </tbody>
        </table>

        <h2>Why Yacht Crews Choose ECOFUNDRIVE</h2>

        <div class="reasons-grid">
          <div class="reason">
            <h3>🗣️ We Speak Your Language</h3>
            <p>Our driver is fluent in English and French. No miscommunication, no getting lost in translation. We understand yacht crew culture and the pace of the industry.</p>
          </div>
          <div class="reason">
            <h3>🚐 Spacious Electric Van</h3>
            <p>The VW ID Buzz is not a small car — it's a proper van with room for 6 passengers OR a full cargo load. Perfect for Metro runs with 20+ crates, or crew shuttle with luggage.</p>
          </div>
          <div class="reason">
            <h3>⚡ Always Available</h3>
            <p>We work 7 days a week during season. Last-minute WhatsApp at 7am for an urgent Metro run? No problem. Owner arriving at midnight? We're there.</p>
          </div>
          <div class="reason">
            <h3>📍 We Know Antibes</h3>
            <p>Every chandlery, every shortcut, every parking trick. We know where to find what you need and how to get there fast — even during summer traffic.</p>
          </div>
        </div>

        <h2>A Typical Day as Your Dedicated Driver</h2>

        <div class="timeline">
          <div class="timeline-item"><span class="time">07:30</span><strong>Metro run</strong> — Collect chef's shopping list, drive to Metro Villeneuve-Loubet, shop, deliver to yacht by 09:30</div>
          <div class="timeline-item"><span class="time">10:00</span><strong>DHL pickup</strong> — Collect 3 parcels from DHL depot in Nice, deliver to yacht</div>
          <div class="timeline-item"><span class="time">11:30</span><strong>Chandlery run</strong> — Pick up fenders and lines from Accastillage Diffusion</div>
          <div class="timeline-item"><span class="time">13:00</span><strong>Lunch break</strong></div>
          <div class="timeline-item"><span class="time">14:00</span><strong>Laundry run</strong> — Collect crew uniforms from dry cleaner, deliver to yacht</div>
          <div class="timeline-item"><span class="time">15:30</span><strong>Airport pickup</strong> — Collect 2 arriving crew from Nice Airport, transfer to Port Vauban</div>
          <div class="timeline-item"><span class="time">17:00</span><strong>End of day</strong> — All done!</div>
        </div>

        <p>All of the above for a <strong>single flat rate of €250–350</strong> for the full day. No surprises, no meter running.</p>

        <h2>Frequently Asked Questions</h2>

        <div class="faq-list">
          <div class="faq-item">
            <h3 class="faq-question">Can the driver use our yacht's Metro card?</h3>
            <div class="faq-answer"><p>Yes, absolutely. Just hand over the card and your list. We shop on your account, return the card with the receipt.</p></div>
          </div>
          <div class="faq-item">
            <h3 class="faq-question">Is the van big enough for a full Metro shop + crew passengers?</h3>
            <div class="faq-answer"><p>The VW ID Buzz is configured for either 6 passengers OR full cargo. For a Metro run, we use the cargo configuration (seats folded). If you need both passengers and cargo, we can do a combined trip for smaller loads.</p></div>
          </div>
          <div class="faq-item">
            <h3 class="faq-question">Do you offer seasonal contracts for the charter season?</h3>
            <div class="faq-answer"><p>Yes. For yachts based in Antibes from May to September, we offer seasonal contracts with preferred rates and guaranteed availability. Contact us to discuss terms.</p></div>
          </div>
          <div class="faq-item">
            <h3 class="faq-question">Can you transport crew to other ports (Cannes, Monaco, Saint-Tropez)?</h3>
            <div class="faq-answer"><p>Yes. We cover the entire Côte d'Azur. Transfers to Cannes (30 min), Monaco (40 min), or Saint-Tropez (1.5h) are available at published rates or included in your day package.</p></div>
          </div>
          <div class="faq-item">
            <h3 class="faq-question">How do we book?</h3>
            <div class="faq-answer"><p>WhatsApp is the fastest way: <a href="https://wa.me/33616552811">+33 6 16 55 28 11</a>. You can also call or email. For same-day service, WhatsApp or call before 8am.</p></div>
          </div>
        </div>

      </div>
    </article>

    <section class="cta-section fade-in-section">
      <div class="container text-center">
        <h2>Need a Reliable Driver for Your Crew?</h2>
        <p class="lead mb-lg">WhatsApp us now. Available 7 days a week during season.</p>
        <div class="cta-buttons">
          <a href="https://wa.me/33616552811" class="btn btn-whatsapp btn-lg">💬 WhatsApp</a>
          <a href="/en/yacht-provisioning-delivery-antibes" class="btn btn-outline btn-lg">All Yacht Services →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero-section { background: linear-gradient(135deg, rgba(0,20,40,0.85), rgba(0,40,80,0.7)), url('/assets/img/fun-buzz/2025-Volkswagen-ID.-Buzz_Cabana_Blue-VW-Bus.webp'); background-size: cover; background-position: center; padding: 8rem 2rem; text-align: center; color: white; }
  .hero-badge { display: inline-block; background: rgba(0,176,240,0.2); border: 1px solid rgba(0,176,240,0.4); padding: 0.5rem 1.5rem; border-radius: 50px; font-size: 0.85rem; font-weight: 600; margin-bottom: 1.5rem; color: #66d0f7; }
  .hero-section h1 { font-size: 2.5rem; margin-bottom: 1rem; text-shadow: 2px 2px 4px rgba(0,0,0,0.5); }
  .hero-subtitle { font-size: 1.15rem; margin-bottom: 2rem; opacity: 0.9; max-width: 700px; margin-left: auto; margin-right: auto; }
  .hero-cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .btn { padding: 1rem 2rem; border-radius: 50px; text-decoration: none; font-weight: 600; transition: all 0.3s ease; display: inline-block; }
  .btn-whatsapp { background: #25D366; color: white; } .btn-whatsapp:hover { background: #1da851; }
  .btn-gold { background: #00b0f0; color: #000; }
  .btn-outline { border: 2px solid white; color: white; } .btn-outline:hover { background: white; color: #000; }
  .btn-lg { padding: 1.25rem 2.5rem; font-size: 1.1rem; }
  .guide-content { max-width: 900px; margin: 0 auto; }
  .article-body { font-size: 1.05rem; line-height: 1.8; }
  .article-body h2 { color: #00b0f0; margin-top: 3rem; margin-bottom: 1rem; font-size: 1.8rem; }
  .lead { font-size: 1.15rem; color: #444; }
  .use-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin: 2rem 0; }
  .use-card { background: #f9f9f9; padding: 1.5rem; border-radius: 12px; text-align: center; transition: transform 0.3s; }
  .use-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.08); }
  .use-icon { font-size: 2rem; display: block; margin-bottom: 0.75rem; }
  .use-card h3 { color: #00b0f0; margin-bottom: 0.5rem; }
  .price-cell { font-weight: 700; color: #00b0f0; }
  .reasons-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin: 2rem 0; }
  .reason { background: #f0f9ff; padding: 2rem; border-radius: 12px; border: 1px solid #e0f2fe; }
  .reason h3 { margin-top: 0; color: #1a1a1a; }
  .timeline { margin: 2rem 0; border-left: 3px solid #00b0f0; padding-left: 2rem; }
  .timeline-item { margin-bottom: 1.5rem; position: relative; }
  .timeline-item::before { content: ''; position: absolute; left: -2.55rem; top: 0.4rem; width: 12px; height: 12px; background: #00b0f0; border-radius: 50%; }
  .time { display: inline-block; background: #00b0f0; color: white; padding: 0.2rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 700; margin-right: 0.75rem; }
  .cta-section { background: linear-gradient(135deg, #001428, #002850); padding: 4rem 2rem; color: white; }
  .cta-section h2 { color: white; }
  .cta-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  @media (max-width: 768px) { .hero-section { padding: 5rem 1rem; } .hero-section h1 { font-size: 1.8rem; } .timeline { padding-left: 1.5rem; } }
</style>
