---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const title = "Long Distance Transfers Nice - Milan, Lyon, Geneva | ECOFUNDRIVE";
const description = "Premium long-distance chauffeur service from Nice. Travel to Milan, Lyon, Geneva, Marseille in first-class comfort. Fixed rates, colorful ID Buzz vans.";
const keywords = [
  'long distance transfer Nice',
  'chauffeur Nice to Milan',
  'private driver Nice to Lyon',
  'Nice Geneva private transfer',
  'fun ID Buzz van service French Riviera'
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Long Distance Chauffeured Transfer",
  "provider": { "@type": "Organization", "name": "ECOFUNDRIVE" },
  "areaServed": ["France", "Italy", "Switzerland", "Monaco"],
  "description": "Premium private driver service for intercity and international trips."
};
---

<BaseLayout
  title={title}
  description={description}
  currentPage="guide-long-distance-transfers"
  canonical="/en/guide-long-distance-transfers"
  lang="en"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Home", url: "/en" },
    { name: "Guides", url: "/en/guides" },
    { name: "Long Distance", url: "/en/guide-long-distance-transfers" }
  ]}
  schema={schema}
>
  <PageHero 
    title="Long Distance Journeys"
    subtitle="Milan, Lyon, Geneva... Travel across Europe in the absolute comfort of our premium vehicles. The first-class alternative to trains and planes."
    backgroundImage="/assets/img/fun-buzz/2025-Volkswagen-ID.-Buzz_Cabana_Blue-VW-Bus.webp"
    badge="FRANCE • ITALY • SWITZERLAND"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Why Choose a Long-Distance Chauffeur?"
      image="/assets/img/fun-buzz/2025-Volkswagen-ID.-Buzz_Cabana_Blue-VW-Bus.webp"
      alt="Business trip sedan"
      imageSide="right"
      ctaText="Get a Quote"
      ctaLink="/en/booking"
    >
      <p class="fade-in-section">
        Forget strikes, train delays, endless security checks, airport crowds, and luggage limits. <strong>Long-distance private transport</strong> is the ultimate seamless travel solution.
      </p>
      <p class="fade-in-section">
        Your chauffeur picks you up at your doorstep and drops you off right at your destination. Use the travel time to work productivey (Wi-Fi on board) or simply relax. You control the schedule: stop for coffee whenever you like, route adjustments, no rigid timetables.
      </p>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Key Routes & Estimates</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">🇮🇹</span><h3>Nice → Milan</h3><p>~185 miles / 3h30. For Fashion Week or business. Scenic drive through the Alps.<br><small>From €450</small></p></div>
          <div class="service-card"><span class="service-icon">🇫🇷</span><h3>Nice → Lyon</h3><p>~290 miles / 4h30. TGV or business hub connection. Early departure recommended.<br><small>From €550</small></p></div>
          <div class="service-card"><span class="service-icon">🇨🇭</span><h3>Nice → Geneva</h3><p>~340 miles / 5h30. Global financial center. Travel business class on the road.<br><small>From €650</small></p></div>
          <div class="service-card"><span class="service-icon">⚓</span><h3>Nice → Marseille</h3><p>~125 miles / 2h15. Regional meetings or Marignane airport connection.<br><small>From €280</small></p></div>
        </div>
      </div>
    </section>

    <SectionImageText
      title="On-Board Comfort & Amenities"
      image="/assets/img/fun-buzz/OIPblack.jpg"
      alt="Premium vehicle interior"
      imageSide="left"
      ctaText="View Fleet"
      ctaLink="/en/services"
    >
      <p class="fade-in-section">
        Our vehicles are specified for long-haul comfort. Van VW ID Buzz E-Class/S-Class sedans or Volkswagen ID Buzz for silence, V-Class Vans for space.
      </p>
      <ul class="fade-in-section">
        <li>4G/5G Wi-Fi connection to stay online.</li>
        <li>USB ports and chargers for all your devices.</li>
        <li>Complimentary mineral water.</li>
        <li>Plush leather seats and multi-zone climate control.</li>
        <li>Large trunk capacity (V-Class recommended for >3 suitcases).</li>
      </ul>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Ready for the Grand Tour?</h2>
        <p>Request an immediate flat-rate quote for your destination.</p>
        <div class="cta-buttons">
          <a href="/en/booking" class="btn-gold">Free Quote</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Other Services</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/en/services" class="text-dark hover-gold">Hourly Service</a>
        <a href="/en/nice-airport-transfer" class="text-dark hover-gold">Airport Transfer</a>
        <a href="/en/booking" class="text-dark hover-gold">Ski Transfer</a>
        <a href="/en/contact" class="text-dark hover-gold">Contact Us</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #00b0f0; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(0, 176, 240, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(0, 176, 240, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #00b0f0; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .service-card small { display: block; margin-top: 0.5rem; color: #fff; font-weight: 700; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #00b0f0, #66d0f7); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #00b0f0; color: #00b0f0; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
