---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';

const title = "The Corniches: Scenic Coastal Roads | ECOFUNDRIVE";
const description = "Drive the 3 legendary Corniches between Nice, Eze & Monaco. Grande, Moyenne, Basse – the world's most beautiful coastal roads. Private chauffeur service.";
const keywords = [
  'Corniche Nice Monaco',
  'scenic drive French Riviera',
  'Grande Corniche tour',
  'Eze village private driver',
  'Monaco coastal road'
];
---

<BaseLayout
  title={title}
  description={description}
  currentPage="guide-scenic-road-nice-eze-monaco"
  canonical="/en/guide-scenic-road-nice-eze-monaco"
  lang="en"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Home", url: "/en" },
    { name: "Guides", url: "/en/guides" },
    { name: "Scenic Roads", url: "/en/guide-scenic-road-nice-eze-monaco" }
  ]}
  schema={{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "image": "https://www.ecofundrive.com/assets/img/guides/villages-perches.webp",
    "author": { "@type": "Organization", "name": "ECOFUNDRIVE" },
    "publisher": {
      "@type": "Organization",
      "name": "ECOFUNDRIVE",
      "logo": { "@type": "ImageObject", "url": "https://www.ecofundrive.com/assets/img/logo/logo.png" }
    },
    "datePublished": "2024-03-01",
    "dateModified": new Date().toISOString().split('T')[0]
  }}
>
  <main class="page-content">
    <div class="container py-lg">
      <h1 class="text-center mb-xl">The Corniches: The World's Most Spectacular Roads</h1>
      <p class="lead text-center mb-xl">
        Three legendary roads carved into the cliffs between Nice and Monaco. Hairpin bends, sheer drops to the azure sea, and views that will make your heart race. Let your chauffeur handle the driving while you drink in the scenery.
      </p>
    </div>

    <!-- INTRO -->
    <SectionImageText
      title="Why You Need a Private Driver for the Corniches"
      image="/assets/img/guides/villages-perches.webp"
      alt="Grande Corniche view"
      imageSide="right"
      ctaText="Book Scenic Drive"
      ctaLink="/en/booking"
    >
      <p>
        <strong>These roads are spectacular but demanding.</strong> Tight hairpin bends, vertiginous drops, distracted tourists snapping photos... Driving yourself means missing the very scenery you came to see.
      </p>
      <p>
        With ECOFUNDRIVE, you're the passenger. Gaze at the views, take unlimited photos at the best viewpoints, and stop whenever something catches your eye. Our chauffeurs know every curve by heart – and the secret spots tourists never find.
      </p>
    </SectionImageText>

    <!-- THE 3 CORNICHES -->
    <section class="mb-xl container">
      <h2 class="text-center mb-lg">The Three Corniches: Choose Your Adventure</h2>
      <div class="grid-3-cols">
        <div class="card-content bg-light p-4 rounded">
          <h3 class="mb-3">🏔️ Grande Corniche (D2564)</h3>
          <p><strong>Highest: 1,680 ft elevation</strong>. The most spectacular. Built by Napoleon following the ancient Via Julia Augusta. Don't miss the Col d'Eze viewpoint and Tête de Chien (Dog's Head).</p>
          <p><em>Duration: 45 min non-stop</em></p>
        </div>
        <div class="card-content bg-light p-4 rounded">
          <h3 class="mb-3">⛰️ Moyenne Corniche (D6007)</h3>
          <p><strong>The best compromise</strong>. Passes through Eze Village. Perfect for combining panoramas with a visit to the Exotic Garden. Featured in Hitchcock's "To Catch a Thief".</p>
          <p><em>Duration: 30 min non-stop</em></p>
        </div>
        <div class="card-content bg-light p-4 rounded">
          <h3 class="mb-3">🌊 Basse Corniche (D6098)</h3>
          <p><strong>Sea level</strong>. Hugs the coast from Villefranche to Cap-d'Ail. Views of Cap Ferrat and its billionaire villas. Perfect for a waterfront aperitif stop.</p>
          <p><em>Duration: 40 min non-stop</em></p>
        </div>
      </div>
    </section>

    <!-- SIGNATURE CIRCUIT -->
    <SectionImageText
      title="Our Signature Circuit: The Grand Tour"
      image="/assets/img/destinations/destination-monaco.webp"
      alt="Monaco view from Grande Corniche"
      imageSide="left"
      ctaText="Book Grand Tour"
      ctaLink="/en/booking"
    >
      <p>
        <strong>Duration: 3-4 hours</strong>. A complete itinerary combining all three corniches:
      </p>
      <ol>
        <li>Depart Nice → <strong>Grande Corniche</strong> (photo stop at Col d'Eze)</li>
        <li>Descend to <strong>Moyenne Corniche</strong> → Explore <strong>Eze Village</strong> (1.5 hrs)</li>
        <li>Continue to <strong>Monaco</strong> → Drive the F1 circuit, stop at the Casino</li>
        <li>Return via <strong>Basse Corniche</strong> → Villefranche-sur-Mer & Cap Ferrat</li>
      </ol>
      <p>
        <strong>Included:</strong> Unlimited photo stops. Chilled water. Your driver's commentary on the region's history and secrets.
      </p>
    </SectionImageText>

    <!-- PHOTO SPOTS -->
    <section class="mb-xl container">
      <h2 class="text-center mb-lg">📸 Best Photo Spots</h2>
      <div class="grid-2-cols">
        <div class="card-content bg-light p-4 rounded">
          <h3 class="mb-3">Tête de Chien (Grande Corniche)</h3>
          <p>Plunging 1,800 ft view directly over Monaco. The ultimate photo spot, especially at sunrise or sunset. Only accessible by car.</p>
        </div>
        <div class="card-content bg-light p-4 rounded">
          <h3 class="mb-3">Eze Exotic Garden</h3>
          <p>360° panorama from the castle ruins. Giant cacti framing the turquoise sea below. One of the French Riviera's most Instagrammed locations.</p>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="mb-xl container">
      <div class="text-center bg-light p-5 rounded">
        <h2 class="mb-4">Experience the Corniche Magic</h2>
        <p class="lead mb-4">
          A unique experience where your chauffeur becomes your guide. Create memories that will last a lifetime.
        </p>
        <div class="d-flex justify-content-center gap-3">
          <a href="/en/booking" class="btn btn-primary">Book Scenic Drive</a>
          <a href="https://wa.me/33616552811" class="btn btn-outline">Request Quote</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
