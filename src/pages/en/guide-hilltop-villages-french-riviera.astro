---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const title = "Best Hilltop Villages French Riviera – Private Driver Guide | ECOFUNDRIVE";
const description = "Discover the most beautiful medieval villages of the French Riviera with your private driver. Èze, Saint-Paul-de-Vence, Gourdon. Panormaic tours.";
const keywords = [
  'hilltop villages french riviera',
  'visit Eze private driver',
  'Saint-Paul-de-Vence transfer',
  'Gourdon village tour',
  'french riviera countryside tour'
];
---

<BaseLayout
  title={title}
  description={description}
  currentPage="guide-hilltop-villages-french-riviera"
  canonical="/en/guide-hilltop-villages-french-riviera"
  lang="en"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Home", url: "/en" },
    { name: "Guides", url: "/en/guides" },
    { name: "Hilltop Villages", url: "/en/guide-hilltop-villages-french-riviera" }
  ]}
  schema={{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "image": "https://www.ecofundrive.com/assets/img/guides/villages-perches.webp",
    "author": { "@type": "Organization", "name": "ECOFUNDRIVE" }
  }}
>
  <PageHero 
    title="The Hilltop Villages"
    subtitle="Medieval gems between sea and sky. Èze, Saint-Paul, Gourdon... Discover the authentic soul of the Riviera."
    backgroundImage="/assets/img/guides/villages-perches.webp"
    badge="SIGHTSEEING • HISTORY • PANORAMA"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="The Soul of the Riviera"
      image="/assets/img/guides/villages-perches.webp"
      alt="Eze Village Panorama"
      imageSide="right"
      ctaText="Book a Tour"
      ctaLink="/en/booking"
    >
      <p class="fade-in-section">
        Far from the coastal crowds, the Nice hinterland hides suspended treasures: the <strong>hilltop villages</strong>. Medieval fortresses, "eagles' nests," or artist havens, they offer breathtaking panoramas and a deep dive into history.
      </p>
      <p class="fade-in-section">
        Access to these sites is often winding and parking is scarce. With your private driver, enjoy the <strong>scenic drive</strong> in total comfort and get dropped off right at the village gates.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">🏰 Èze Village</span>
        <span class="distance-badge">🎨 Saint-Paul-de-Vence</span>
        <span class="distance-badge">⛰️ Gourdon</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Your Tailor-Made Tour</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">⏱️</span><h3>Half Day</h3><p>4h discovery. Ideal to combine 2 nearby villages (e.g., Èze & La Turbie).</p></div>
          <div class="service-card"><span class="service-icon">☀️</span><h3>Full Day</h3><p>8h total immersion with a gourmet lunch in a village.</p></div>
          <div class="service-card"><span class="service-icon">📸</span><h3>Photo Stops</h3><p>Your driver knows the best viewpoints for your memories.</p></div>
          <div class="service-card"><span class="service-icon">🛍️</span><h3>Art & Crafts</h3><p>Free time to visit art galleries, perfumeries, and artisans.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">The Must-See Top 3</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/guides/villages-perches.webp" alt="Èze Village" title="1. Èze Village" description="The 'Eagle's Nest'. Exotic garden at the summit, medieval alleys, and 360° sea view. An absolute must." link="/en/eze-private-driver" />
        <CategoryCard image="/assets/img/hero/hero-mariage.webp" alt="Saint-Paul-de-Vence" title="2. Saint-Paul-de-Vence" description="The City of Artists. Chagall, Matisse... 16th-century ramparts, Maeght Foundation, and art galleries." link="/en/saint-paul-de-vence-private-driver" />
        <CategoryCard image="/assets/img/destinations/destination-cannes.webp" alt="Gourdon" title="3. Gourdon" description="The Balcony of the Riviera. Impregnable fortress offering a unique view over 80km of coastline." link="/en/booking" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Escape to the Countryside</h2>
        <p>Create your custom itinerary. Our chauffeurs are at your service.</p>
        <div class="cta-buttons">
          <a href="/en/booking" class="btn-gold">Book My Excursion</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp Advice</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">More Discovery Guides</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/en/guide-scenic-road-nice-eze-monaco" class="text-dark hover-gold">The 3 Corniches</a>
        <a href="/en/guide-one-day-in-monaco" class="text-dark hover-gold">Monaco in 1 Day</a>
        <a href="/en/nice-private-driver" class="text-dark hover-gold">Nice Guide</a>
        <a href="/en/guides" class="text-dark hover-gold">All Guides</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #d4af37; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
