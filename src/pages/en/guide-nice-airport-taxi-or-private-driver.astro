---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const title = "Nice Airport: Taxi, Uber or Private Driver? 2026 Guide | ECOFUNDRIVE";
const description = "Complete comparison for your transfer from Nice Airport (NCE). Taxi, Uber, Bus or Private Driver (VTC)? Prices, pros, cons and best choice for 2026.";
const keywords = [
  'Nice airport taxi',
  'Nice airport private driver',
  'Nice airport Uber',
  'taxi vs VTC Nice',
  'Nice airport transfer price'
];
---

<BaseLayout
  title={title}
  description={description}
  currentPage="guide-nice-airport-taxi-or-private-driver"
  canonical="/en/guide-nice-airport-taxi-or-private-driver"
  lang="en"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Home", url: "/en" },
    { name: "Guides", url: "/en/guides" },
    { name: "Taxi vs Driver", url: "/en/guide-nice-airport-taxi-or-private-driver" }
  ]}
  schema={{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "image": "https://www.ecofundrive.com/assets/img/hero/hero-aeroport-nice.webp",
    "author": { "@type": "Organization", "name": "ECOFUNDRIVE" }
  }}
>
  <PageHero 
    title="Nice Airport Transfer Guide"
    subtitle="Taxi, Uber, Bus or Private Driver? We compare every option to help you start your Riviera trip stress-free."
    backgroundImage="/assets/img/hero/hero-aeroport-nice.webp"
    badge="2026 GUIDE • PRICES • TIPS"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="The Airport Dilemma"
      image="/assets/img/hero/hero-aeroport-nice.webp"
      alt="Nice Airport Arrivals"
      imageSide="right"
      ctaText="Check VTC Prices"
      ctaLink="/en/booking"
    >
      <p class="fade-in-section">
        Landing at <strong>Nice Côte d'Azur (NCE)</strong> is just the beginning. The real challenge is reaching your hotel in Nice, Cannes, or Monaco smoothly.
      </p>
      <p class="fade-in-section">
        You have 4 main options: the <strong>Official Taxi</strong> queue, app-based <strong>Uber/Bolt</strong>, the public <strong>Tram/Bus</strong>, or a pre-booked <strong>Private Driver (VTC)</strong>. Each has its pros and cons depending on your budget and needs.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">🚕 Taxi: Fixed Price</span>
        <span class="distance-badge">📱 Uber: Variable</span>
        <span class="distance-badge">🤵 VTC: Premium</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">At-a-Glance Comparison</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">🚕</span><h3>Taxi</h3><p><strong>Pros:</strong> No booking needed.<br><strong>Cons:</strong> Long queues, standard cars, no meet & greet.</p></div>
          <div class="service-card"><span class="service-icon">📱</span><h3>Uber</h3><p><strong>Pros:</strong> App convenience.<br><strong>Cons:</strong> <strong>Surge pricing</strong>, erratic quality, no airport pickup at gate.</p></div>
          <div class="service-card"><span class="service-icon">🤵</span><h3>VTC Pro</h3><p><strong>Pros:</strong> Fixed price, name board at gate, luxury car.<br><strong>Cons:</strong> Must book in advance.</p></div>
          <div class="service-card"><span class="service-icon">🚌</span><h3>Tram</h3><p><strong>Pros:</strong> Cheap (€1.50).<br><strong>Cons:</strong> Crowded, slow, DIY luggage.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Why Choose a Private Driver?</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/services/service-aeroport.webp" alt="Meet and Greet" title="👋 Meet & Greet" description="Don't look for your driver. We wait for you at the arrivals gate with a name sign. Even if your flight is late." link="/en/booking" />
        <CategoryCard image="/assets/img/about/vehicule-premium.webp" alt="Premium Comfort" title="✨ Premium Comfort" description="Travel in a pristine Mercedes E-Class or V-Class Van. Water, chargers, and Wi-Fi on board." link="/en/booking" />
        <CategoryCard image="/assets/img/services/service-business.png" alt="Fixed Price" title="💎 Fixed Price" description="Know the cost before you fly. No meter anxiety, no surge pricing, no hidden fees." link="/en/booking" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Start Your Trip with Excellence</h2>
        <p>Book your professional driver for the price of a standard taxi.</p>
        <div class="cta-buttons">
          <a href="/en/booking" class="btn-gold">Book Transfer</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp Quote</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Popular Transfers</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/en/nice-airport-to-cannes-transfer" class="text-dark hover-gold">Nice to Cannes</a>
        <a href="/en/nice-airport-to-monaco-transfer" class="text-dark hover-gold">Nice to Monaco</a>
        <a href="/en/nice-airport-to-saint-tropez-transfer" class="text-dark hover-gold">Nice to St-Tropez</a>
        <a href="/en/nice-private-driver" class="text-dark hover-gold">Nice City</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #d4af37; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
