---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PricingRequest from '../../components/PricingRequest.astro';

const title = "Nice Airport to Saint-Tropez Transfer | VTC Chauffeur Service";
const description = "Luxury car transfer from Nice Airport to Saint-Tropez. Mercedes V-Class & Limousines. Reliable private driver service for your holidays in Saint-Tropez.";
const keywords = [
  'Nice airport Saint-Tropez transfer',
  'chauffeur Saint-Tropez',
  'taxi nice airport saint tropez',
  'mercedes v class saint tropez'
];

const breadcrumbItems = [
  { name: "Home", url: "/en" },
  { name: "Nice Airport to St-Tropez", url: "/en/nice-airport-to-saint-tropez-transfer" }
];
---

<BaseLayout 
  title={title}
  description={description}
  keywords={keywords}
  currentPage="nice-airport-to-saint-tropez-transfer"
  canonical="/en/nice-airport-to-saint-tropez-transfer"
  breadcrumbItems={breadcrumbItems}
>
  <main id="main-content">
    
    <!-- Hero Section -->
    <section class="page-hero">
      <div class="container">
        <h1>Nice Airport to Saint-Tropez</h1>
        <p class="lead">The most comfortable way to reach the Gulf of Saint-Tropez.</p>
        <div class="hero-actions">
           <a href="#booking" class="btn-primary">Book Transfer</a>
           <a href="https://wa.me/33616552811" class="btn-whatsapp">WhatsApp Quote</a>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="content-section">
      <div class="container">
        <div class="grid-2-cols">
           
           <div class="text-content">
              <h2>Seamless Journey to Saint-Tropez</h2>
              <p>
                Reaching Saint-Tropez from Nice Airport can be challenging due to traffic. ECOFUNDRIVE provides a <strong>stress-free private transfer</strong> service in luxury air-conditioned vehicles.
              </p>
              <p>
                Relax in our Mercedes V-Class (ideal for groups/family) or Tesla Sedan while our experienced driver navigates the best route to your villa or hotel in Saint-Tropez, Ramatuelle, or Gassin.
              </p>
              
              <ul class="features-list">
                 <li><strong>Door-to-Door:</strong> Direct drop-off at your villa/hotel.</li>
                 <li><strong>Luxury Vans:</strong> Mercedes V-Class for up to 7 passengers + luggage.</li>
                 <li><strong>Traffic Knowledge:</strong> We know the shortcuts to avoid summer jams.</li>
                 <li><strong>Refreshments:</strong> Water and chargers on board.</li>
              </ul>
           </div>

           <div class="image-content">
              <img src="/assets/img/destinations/destination-saint-tropez.webp" alt="Saint Tropez Luxury Transfer" class="rounded-img shadow-lg" />
           </div>

        </div>
      </div>
    </section>

    <!-- Pricing / Booking -->
    <section id="booking" class="booking-section">
      <div class="container">
        <h2 class="text-center">Get Your Fixed Price</h2>
        <PricingRequest lang="en" />
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="why-us-section">
      <div class="container">
         <h2 class="text-center mb-lg">Your Best Choice for Saint-Tropez</h2>
         <div class="grid-3-cols">
            <div class="benefit-card">
               <h3>Comfort & Space</h3>
               <p>Long rides require comfort. Our vehicles offer ample legroom and luggage space for your stay.</p>
            </div>
            <div class="benefit-card">
               <h3>Reliability</h3>
               <p>No waiting at the airport. Your driver tracks your flight and welcomes you upon arrival.</p>
            </div>
            <div class="benefit-card">
               <h3>Flexibility</h3>
               <p>Plans changed? We offer free cancellation up to 24 hours before pickup.</p>
            </div>
         </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .page-hero {
    background: #1a1a1a;
    color: white;
    padding: 6rem 0;
    text-align: center;
    background-image: url('/assets/img/hero/hero-mariage.webp');
    background-size: cover;
    background-position: center;
    position: relative;
  }
  
  .page-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.5);
  }
  
  .page-hero .container { position: relative; z-index: 2; }

  .page-hero h1 { font-size: 3rem; margin-bottom: 1rem; color: #d4af37; }
  .page-hero .lead { font-size: 1.2rem; margin-bottom: 2rem; color: #eee; }

  .hero-actions { display: flex; gap: 1rem; justify-content: center; }

  .btn-primary {
     background: #d4af37; color: black; padding: 0.8rem 2rem; border-radius: 50px; text-decoration: none; font-weight: bold;
  }
  .btn-whatsapp {
     background: #25D366; color: white; padding: 0.8rem 2rem; border-radius: 50px; text-decoration: none; font-weight: bold;
  }

  .content-section { padding: 4rem 0; }
  
  .grid-2-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  
  @media (max-width: 768px) {
     .grid-2-cols { grid-template-columns: 1fr; }
  }

  .features-list { margin-top: 1.5rem; list-style: none; padding: 0; }
  .features-list li { margin-bottom: 0.8rem; padding-left: 1.5rem; position: relative; }
  .features-list li::before { content: '✓'; color: #d4af37; position: absolute; left: 0; }

  .rounded-img { width: 100%; border-radius: 12px; }
  .shadow-lg { box-shadow: 0 10px 30px rgba(0,0,0,0.15); }

  .booking-section { background: #f9f9f9; padding: 4rem 0; }
  
  .why-us-section { padding: 4rem 0; }
  .benefit-card { padding: 2rem; border: 1px solid #eee; border-radius: 12px; text-align: center; }
  .benefit-card h3 { color: #d4af37; margin-bottom: 1rem; }
  
  .text-center { text-align: center; }
  .mb-lg { margin-bottom: 2rem; }
</style>
