---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const title = "Travel Guides & Tips | ECOFUNDRIVE French Riviera Chauffeur";
const description = "Plan your trip to the French Riviera with our expert guides. Itineraries for Nice, Cannes, Monaco, transport tips, family activities, and event guides.";
const keywords = [
  'French Riviera travel guides',
  'Nice travel tips',
  'Cannes congress guide',
  'family trip Cote d Azur',
  'Monaco sightseeing guide',
  'luxury transport tips'
];
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  currentPage="guides"
  canonical="/en/guides"
  lang="en"
  breadcrumbItems={[
    { name: "Home", url: "/en" },
    { name: "Guides", url: "/en/guides" }
  ]}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-xl">French Riviera Travel Guides & Tips</h1>
      <p class="lead text-center mb-xl">Prepare your stay with our expert insights: itineraries, practical tips, and local secrets to discover the Côte d'Azur in style.</p>
    </div>

    <SectionImageText
      title="Explore the Riviera with a Local Expert"
      image="/assets/img/guides/villages-perches.jpg"
      alt="Hilltop village French Riviera"
      imageSide="right"
      ctaText="Book Your Tour"
      ctaLink="/en/booking"
    >
      <p>
        Beyond providing premium transport, we love sharing our passion for this beautiful region. Whether you're looking for the best restaurants, hidden gems, or advice on optimizing your schedule, our chauffeurs are here to help.
      </p>
      <p>
        Browse our comprehensive guides for visiting Nice, Cannes, Monaco, and navigating the busy summer season with ease.
      </p>
    </SectionImageText>

    <!-- Destination Guides -->
    <section class="container py-xl">
      <h2 class="text-center mb-lg">Destination Guides</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/nice-vieux-nice.jpg"
          alt="Nice Guide"
          title="What to do in Nice?"
          description="Complete itinerary for visiting Nice in 1 to 3 days: Old Town, Promenade des Anglais, Castle Hill."
          link="/en/guide-nice-in-1-to-3-days"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-cannes.png"
          alt="Cannes Guide"
          title="Visit Cannes"
          description="Must-see spots in Cannes: La Croisette, Le Suquet, Lérins Islands."
          link="/en/guide-what-to-do-in-cannes"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.png"
          alt="Monaco Guide"
          title="Monaco in One Day"
          description="The perfect 1-day itinerary: Prince's Palace, Casino, Oceanographic Museum."
          link="/en/guide-one-day-in-monaco"
        />
        <CategoryCard
          image="/assets/img/guides/villages-perches.jpg"
          alt="Hilltop Villages"
          title="Hilltop Villages"
          description="Discover the charm of Eze, Saint-Paul-de-Vence, and Gourdon."
          link="/en/guide-hilltop-villages-french-riviera"
        />
      </div>
    </section>

    <!-- Events & Professional -->
    <section class="container py-xl bg-light rounded-lg">
      <h2 class="text-center mb-lg">Events & Business</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/cannes-palais-festivals.png"
          alt="Cannes Congress"
          title="Cannes Congress Transport"
          description="Essential guide for MIPIM, Cannes Lions, and Film Festival attendees."
          link="/en/guide-cannes-congress-transport"
        />
        <CategoryCard
          image="/assets/img/guides/grand-prix-monaco.jpg"
          alt="Monaco Grand Prix"
          title="Monaco Grand Prix"
          description="How to navigate Monaco during the F1 Grand Prix weekend."
          link="/en/guide-monaco-grand-prix-transport"
        />
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Long Distance Transfer"
          title="Long Distance Transfers"
          description="Comfortable travel to Milan, Geneva, or Saint-Tropez."
          link="/en/guide-long-distance-transfers"
        />
      </div>
    </section>

    <!-- Family & Practical -->
    <section class="container py-xl">
      <h2 class="text-center mb-lg">Practical Advice & Family</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/hero/hero-family.jpg"
          alt="Family Day Riviera"
          title="Family Day Guide"
          description="Best activities for kids: Marineland, Oceanographic Museum, and beaches."
          link="/en/guide-family-day-french-riviera"
        />
        <CategoryCard
          image="/assets/img/services/service-aeroport.webp"
          alt="Nice Airport Transfer"
          title="Taxi vs Private Driver"
          description="Why choose a pre-booked chauffeur over a taxi at Nice Airport."
          link="/en/guide-nice-airport-taxi-or-private-driver"
        />
        <CategoryCard
          image="/assets/img/hero/hero-traffic.jpg"
          alt="Traffic Guide"
          title="High Season Traffic"
          description="Tips to avoid traffic jams during summer in French Riviera."
          link="/en/guide-high-season-traffic-french-riviera"
        />
      </div>
    </section>
  </main>
</BaseLayout>
