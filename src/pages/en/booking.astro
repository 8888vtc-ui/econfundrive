---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Booking | ECOFUNDRIVE – Chauffeur Privé VTC Côte d'Azur";
const description = "Service VTC sur la Côte d'Azur. Chauffeur privé professionnel pour vos déplacements. Service ECOFUNDRIVE professionnel 24h/24. Véhicules premium, chauffeurs ...";
const keywords = [
  'VTC',
  'chauffeur privé',
  "Côte d\'Azur",
  "VTC Côte d'Azur",
  'transport premium'
];
---

<BaseLayout title={title} description={description} currentPage="booking"
  canonical="/en/booking"
>
  <main class="page-content">
    <div class="container">
      <h1>{title}</h1>
      <p>{description}</p>
      <section>
        <h2>Booking</h2>
        <p>To book your private VTC driver:</p>
        <div class="contact-buttons">
          <a href="tel:+33616552811" class="btn btn-primary">+33 6 16 55 28 11</a>
          <a href="https://wa.me/33616552811" class="btn btn-outline" target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </section>
    </div>
  
    <section class="mb-xl">
      <h2>Why choose ECOFUNDRIVE?</h2>
      <p>ECOFUNDRIVE is your trusted partner for all your travel needs on the French Riviera. With years of experience, we offer a premium, punctual, and professional service. Our expert drivers know the region perfectly and welcome you for a comfortable and stress-free journey.</p>
      <p>Whether you need an airport transfer, a business service, or a chauffeur at disposal for your sightseeing tours, ECOFUNDRIVE meets all your transport needs with excellence.</p>
      <a href="/en/services" class="btn-primary">Discover our services</a>
    </section>
  
    <section class="mb-xl">
      <h2>Related Pages</h2>
      <p>Discover our other services: <a href="/en/services">services</a> | <a href="/en/nice-private-driver">nice-private-driver</a> | <a href="/en/contact">contact</a></p>
    </section>
  
    <section class="mb-xl">
      <h2>Our services on the French Riviera</h2>
      <p>ECOFUNDRIVE offers a complete range of VTC services to meet all your transport needs. Discover our solutions adapted to every situation.</p>
      <a href="/en/services" class="btn-primary">See all our services</a>
    </section>
  </main>
</BaseLayout>


