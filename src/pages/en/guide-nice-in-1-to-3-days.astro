---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const title = "What to Do in Nice in 1 to 3 Days – Itineraries & Transport | ECOFUNDRIVE";
const description = "Visit Nice in 1, 2 or 3 days. Old Nice, Promenade des Anglais, Castle Hill, excursions to Èze & Monaco. Optimized guide with private driver.";
const keywords = [
  'visit Nice 1 day',
  'Nice 3 day itinerary',
  'what to do Nice weekend',
  'Nice sightseeing private driver',
  'excursion from Nice'
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": "https://www.ecofundrive.com/assets/img/destinations/vtc-nice.webp",
  "author": { "@type": "Organization", "name": "ECOFUNDRIVE" }
};
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="guide-nice-in-1-to-3-days"
  canonical="/en/guide-nice-in-1-to-3-days"
  lang="en"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Home", url: "/en" },
    { name: "Guides", url: "/en/guides" },
    { name: "Visit Nice", url: "/en/guide-nice-in-1-to-3-days" }
  ]}
  schema={schema}
>
  <PageHero 
    title="Visiting Nice: The Guide"
    subtitle="From the Promenade des Anglais to the hills of Cimiez. Optimize your 1 to 3 day stay on the French Riviera."
    backgroundImage="/assets/img/destinations/vtc-nice.webp"
    badge="ITINERARIES • CULTURE • RELAXATION"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Day 1: The Soul of Nissa la Bella"
      image="/assets/img/destinations/vtc-nice.webp"
      alt="Promenade des Anglais"
      imageSide="right"
      ctaText="City Center Transfer"
      ctaLink="/en/booking"
    >
      <p class="fade-in-section">
        <strong>Morning:</strong> Dive into <strong>Old Nice</strong>. Get lost in the colorful alleys, smell the spices at the Cours Saleya market, and taste a hot socca at Thérésa's.
      </p>
      <p class="fade-in-section">
        <strong>Afternoon:</strong> Climb <strong>Castle Hill</strong> for the iconic view over the Baie des Anges. Walk back down to stroll along the mythical <strong>Promenade des Anglais</strong> at sunset.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Old Nice</span>
        <span class="distance-badge">🌊 Promenade</span>
        <span class="distance-badge">🏰 Castle Hill</span>
      </div>
    </SectionImageText>

    <SectionImageText
      title="Day 2: Art, Culture & Shopping"
      image="/assets/img/fun-buzz/2025-Volkswagen-ID.-Buzz_Cabana_Blue-VW-Bus.webp"
      alt="Nice Matisse Museum"
      imageSide="left"
      ctaText="Museum Transfer"
      ctaLink="/en/booking"
    >
      <p class="fade-in-section">
        <strong>Morning:</strong> Head to the heights of <strong>Cimiez</strong>. This aristocratic district houses the Roman Arena and the superb <strong>Matisse Museum</strong>.
      </p>
      <p class="fade-in-section">
        <strong>Afternoon:</strong> Chic shopping in the Golden Square (Carré d'Or) or visit the Marc Chagall Museum near the station. End with a drink on the Negresco rooftop.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">🎨 Matisse & Chagall</span>
        <span class="distance-badge">🏛️ Cimiez</span>
        <span class="distance-badge">🛍️ Golden Square</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Day 3: Private Excursions</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">🏰</span><h3>Èze & Monaco</h3><p>Medieval morning in Èze, princely afternoon in Monte-Carlo.</p></div>
          <div class="service-card"><span class="service-icon">🍷</span><h3>Wine Route</h3><p>Discover the Bellet vineyards on the Nice hills.</p></div>
          <div class="service-card"><span class="service-icon">⛵</span><h3>Cap Ferrat</h3><p>Visit Villa Ephrussi de Rothschild and coastal walk.</p></div>
          <div class="service-card"><span class="service-icon">🎨</span><h3>Saint-Paul</h3><p>Artistic getaway in the authentic hinterland.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">The Essentials</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/fun-buzz/OIPint.jpg" alt="Nice Airport" title="✈️ Arriving in Nice" description="Book your airport transfer in advance to avoid taxi queues." link="/en/booking" />
        <CategoryCard image="/assets/img/destinations/destination-nice.png" alt="Nice Hotels" title="🏨 Where to Stay?" description="Our top picks: Negresco (Luxury), Radisson Blu (View), Beau Rivage (Center)." link="/en/booking" />
        <CategoryCard image="/assets/img/services/service-business.png" alt="Nice Evening" title="🍽️ Restaurants" description="From Michelin stars to Nice bistros. Ask your driver for tips." link="/en/booking" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Plan Your Nice Stay</h2>
        <p>A private driver for your transfers and excursions.</p>
        <div class="cta-buttons">
          <a href="/en/booking" class="btn-gold">Book Now</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Related Guides</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/en/guide-hilltop-villages-french-riviera" class="text-dark hover-gold">Hilltop Villages</a>
        <a href="/en/guide-one-day-in-monaco" class="text-dark hover-gold">Monaco in 1 Day</a>
        <a href="/en/nice-private-driver" class="text-dark hover-gold">Nice VTC</a>
        <a href="/en/eze-private-driver" class="text-dark hover-gold">Èze VTC</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #00b0f0; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(0, 176, 240, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(0, 176, 240, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #00b0f0; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #00b0f0, #66d0f7); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #00b0f0; color: #00b0f0; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
