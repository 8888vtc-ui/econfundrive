---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';

const title = "Nice in 1 to 3 Days: Complete Itinerary | ECOFUNDRIVE";
const description = "Day-by-day itineraries to explore Nice: Old Town, Promenade des Anglais, Cimiez museums, and day trips to Monaco & Eze. Private driver available.";
const keywords = [
  'Nice itinerary 3 days',
  'what to do Nice France',
  'Nice sightseeing tour',
  'private driver Nice',
  'Nice day trips'
];
---

<BaseLayout
  title={title}
  description={description}
  currentPage="guide-nice-in-1-to-3-days"
  canonical="/en/guide-nice-in-1-to-3-days"
  lang="en"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Home", url: "/en" },
    { name: "Guides", url: "/en/guides" },
    { name: "Nice 1-3 Days", url: "/en/guide-nice-in-1-to-3-days" }
  ]}
  schema={{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "image": "https://www.ecofundrive.com/assets/img/destinations/vtc-nice.webp",
    "author": { "@type": "Organization", "name": "ECOFUNDRIVE" },
    "publisher": {
      "@type": "Organization",
      "name": "ECOFUNDRIVE",
      "logo": { "@type": "ImageObject", "url": "https://www.ecofundrive.com/assets/img/logo/logo.png" }
    },
    "datePublished": "2024-03-01",
    "dateModified": new Date().toISOString().split('T')[0]
  }}
>
  <main class="page-content">
    <div class="container py-lg">
      <h1 class="text-center mb-xl">Nice in 1, 2 or 3 Days: Your Perfect Itinerary</h1>
      <p class="lead text-center mb-xl">
        The Queen of the Riviera awaits. Azure skies, pastel-colored buildings, world-class art, and that legendary Mediterranean light that inspired Matisse and Chagall. Here's how to make the most of your time.
      </p>
    </div>

    <!-- DAY 1 -->
    <SectionImageText
      title="Day 1: The Essentials"
      image="/assets/img/destinations/vtc-nice.webp"
      alt="Promenade des Anglais Nice"
      imageSide="right"
      ctaText="Airport Transfer"
      ctaLink="/en/booking"
    >
      <p>
        <strong>Morning:</strong> Start in <strong>Vieux Nice</strong> (Old Town). Lose yourself in the labyrinth of colorful streets. Visit the baroque Cathédrale Sainte-Réparate, browse the flower market on <strong>Cours Saleya</strong>, and try the legendary socca (chickpea pancake) at Chez Thérésa.
      </p>
      <p>
        <strong>Afternoon:</strong> Climb to <strong>Castle Hill</strong> (or take the free elevator) for panoramic views that will take your breath away. Descend along the Quai des États-Unis to the iconic <strong>Promenade des Anglais</strong>. Rent a blue chair and watch the world go by.
      </p>
      <p>
        <strong>Evening:</strong> Aperitif on a terrace overlooking the Bay of Angels. Dinner in Old Nice – try Olive et Artichaut for Michelin-starred cuisine at accessible prices.
      </p>
    </SectionImageText>

    <!-- DAY 2 -->
    <SectionImageText
      title="Day 2: Art & Elegance"
      image="/assets/img/hero/hero-business.webp"
      alt="Matisse Museum Nice"
      imageSide="left"
      ctaText="Full Day Driver"
      ctaLink="/en/booking"
    >
      <p>
        <strong>Morning:</strong> Head to <strong>Cimiez</strong>, Nice's elegant hill neighborhood. Visit the <strong>Matisse Museum</strong> (free entry!), stroll through the monastery gardens with their stunning views, and explore the Roman Arena ruins.
      </p>
      <p>
        <strong>Afternoon:</strong> Return to the city center for the <strong>Chagall Museum</strong> – his breathtaking biblical message paintings are a must-see. Then shop on Avenue Jean Médecin or explore the antique dealers of the Carré d'Or.
      </p>
      <p>
        <strong>Evening:</strong> Sunset drinks at the Radisson Blu rooftop bar (free access). Dinner at the Port, watching yachts bob in the harbor.
      </p>
    </SectionImageText>

    <!-- DAY 3 -->
    <section class="mb-xl container">
      <h2 class="text-center mb-lg">Day 3: Day Trip Adventures</h2>
      <p class="text-center mb-lg">
        With a private driver, explore the Riviera's treasures without the stress of parking or timetables.
      </p>
      <div class="grid-3-cols">
        <div class="card-content bg-light p-4 rounded">
          <h3 class="mb-3">🏔️ Option 1: Eze + Monaco</h3>
          <p>The perched village of Eze (Exotic Garden + Fragonard perfumery), then Monaco (Casino, Palace, Port). Half or full day.</p>
          <a href="/en/guide-one-day-in-monaco" class="card-link">Monaco Guide →</a>
        </div>
        <div class="card-content bg-light p-4 rounded">
          <h3 class="mb-3">🎨 Option 2: Hilltop Villages</h3>
          <p>Saint-Paul-de-Vence (art galleries), Vence (Matisse Chapel), and Tourrettes-sur-Loup. An artistic circuit.</p>
          <a href="/en/guide-hilltop-villages-french-riviera" class="card-link">Villages Guide →</a>
        </div>
        <div class="card-content bg-light p-4 rounded">
          <h3 class="mb-3">🌸 Option 3: Grasse & Beyond</h3>
          <p>World capital of perfume. Create your own fragrance at Molinard or Galimard. Lunch in charming Mougins.</p>
          <a href="/en/grasse-private-driver" class="card-link">Grasse Transfer →</a>
        </div>
      </div>
    </section>

    <!-- VTC ADVANTAGE -->
    <SectionImageText
      title="Your Private Driver in Nice"
      image="/assets/img/services/service-business.webp"
      alt="Private chauffeur Nice"
      imageSide="right"
      ctaText="Book Your Driver"
      ctaLink="/en/booking"
    >
      <p>
        <strong>Airport Transfer:</strong> Step off your flight and into comfort. VIP meet & greet, help with luggage, direct transfer to your hotel in a premium vehicle.
      </p>
      <p>
        <strong>Full Day Service:</strong> For Day 3 excursions, book a chauffeur for the day. Fixed price, total flexibility, zero parking stress. Your driver becomes your local guide.
      </p>
    </SectionImageText>

    <!-- CTA FINAL -->
    <section class="mb-xl container">
      <div class="text-center bg-light p-5 rounded">
        <h2 class="mb-4">Ready to Discover Nice?</h2>
        <p class="lead mb-4">
          From airport pickup to day trips, we're your trusted local partner.
        </p>
        <div class="d-flex justify-content-center gap-3">
          <a href="/en/booking" class="btn btn-primary">Book My Transfer</a>
          <a href="/en/nice-private-driver" class="btn btn-outline">Nice Rates</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
