---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const title = "Grasse Private Driver – Perfume Capital Tour | ECOFUNDRIVE";
const description = "Private driver to Grasse, the world capital of perfume. Fragonard, Galimard, Molinard factory tours. Day trips from Nice, Cannes. Premium chauffeur service.";
const keywords = [
  'Grasse private driver',
  'perfume tour Grasse',
  'Nice to Grasse transfer',
  'Fragonard factory tour',
  'Grasse perfumeries'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="en-grasse-private-driver"
  canonical="/en/grasse-private-driver"
  lang="en"
  breadcrumbItems={[
    { name: "Home", url: "/en" },
    { name: "Grasse Private Driver", url: "/en/grasse-private-driver" }
  ]}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    <SectionImageText
      title="Your Private Driver to Grasse"
      image="/assets/img/destinations/destination-nice.webp"
      alt="Private driver Grasse perfume capital"
      imageSide="right"
      ctaText="Book Your Grasse Tour"
      ctaLink="/en/booking"
    >
      <p class="fade-in-section">
        <strong>Grasse</strong> is the world capital of perfume, nestled in the hills above Cannes. For over 400 years, this Provençal town has been the heart of the French fragrance industry, home to legendary perfume houses like <strong>Fragonard, Galimard, and Molinard</strong>.
      </p>
      <p class="fade-in-section">
        A visit to Grasse offers a unique sensory experience: tour historic perfume factories, create your own fragrance in workshops, and stroll through the charming old town filled with the scent of jasmine and roses.
      </p>
      <p class="fade-in-section">
        ECOFUNDRIVE provides <strong>private driver tours to Grasse</strong> from Nice, Cannes, or anywhere on the Riviera. Perfect for fragrance enthusiasts and those seeking an authentic Provençal experience.
      </p>
      <ul class="fade-in-section">
        <li>Perfume factory tours (Fragonard, Galimard, Molinard)</li>
        <li>Perfume creation workshops</li>
        <li>Old Town exploration with flower markets</li>
        <li>Combined tour: Grasse + hilltop villages</li>
        <li>Transfers from Nice (45 min) or Cannes (25 min)</li>
        <li>Flexible half-day or full-day options</li>
      </ul>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Grasse Tour Rates</h2>
      <div class="cta-box">
        <a href="/en/booking" class="btn-primary">Get a Free Quote</a>
      </div>
      <p class="text-center mt-md"><em>Factory tours are free. Workshop fees are additional (approx. €50-100).</em></p>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">What to See in Grasse</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Fragonard Perfume Grasse"
          title="Fragonard Factory"
          description="The most famous perfume house. Free factory tour, museum, and boutique. Learn the art of perfume-making."
          link="/en/booking"
        />
        <CategoryCard
          image="/assets/img/services/service-evenements.webp"
          alt="Galimard Grasse"
          title="Galimard Studios"
          description="Create your own perfume in a 2-hour workshop. A unique souvenir to take home."
          link="/en/booking"
        />
        <CategoryCard
          image="/assets/img/about/vehicule-premium.webp"
          alt="Grasse Old Town"
          title="Historic Old Town"
          description="Medieval streets, Provençal markets, stunning views over the Riviera. Charming cafés."
          link="/en/booking"
        />
      </div>
    </section>

    <section class="mb-xl fade-in-section">
      <h2 class="text-center mb-lg">Frequently Asked Questions</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-question">Are the perfume factory tours free?</h3>
          <div class="faq-answer">
            <p>Yes, all three major perfume houses (<strong>Fragonard, Galimard, Molinard</strong>) offer free guided factory tours. Perfume creation workshops have an additional fee (€50-100).</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">How long should I spend in Grasse?</h3>
          <div class="faq-answer">
            <p>We recommend <strong>3-4 hours minimum</strong> to visit one or two perfumeries and explore the old town. For a workshop experience, allow a full half-day.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Can you combine Grasse with other destinations?</h3>
          <div class="faq-answer">
            <p>Absolutely! Popular combinations include <strong>Grasse + Mougins</strong> (gourmet lunch), <strong>Grasse + Gourdon</strong> (dramatic hilltop village), or <strong>Grasse + Saint-Paul-de-Vence</strong> (art galleries).</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Nearby Destinations</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/en/cannes-private-driver" class="text-dark hover-gold">Cannes Private Driver</a>
        <a href="/en/nice-private-driver" class="text-dark hover-gold">Nice Private Driver</a>
        <a href="/en/guide-hilltop-villages-french-riviera" class="text-dark hover-gold">Hilltop Villages</a>
        <a href="/en/eze-private-driver" class="text-dark hover-gold">Eze Tour</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
