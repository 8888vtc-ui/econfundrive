---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "EcoFunDrive Launches Premium Sustainable Chauffeur Service | Press Release";
const description = "EcoFunDrive redefines luxury transport on the French Riviera with a 100% hybrid & electric fleet. Discover our new sustainable VTC services for Nice, Cannes, and Monaco.";
const keywords = ['EcoFunDrive press release', 'sustainable luxury transport', 'green VTC Nice', 'electric chauffeur service', 'Volkswagen ID Buzz private driver French Riviera'];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": "EcoFunDrive Redefines Luxury Transport with Premium Green Fleet",
  "image": [
    "https://www.ecofundrive.com/assets/img/fun-buzz/2025-Volkswagen-ID.-Buzz_Cabana_Blue-VW-Bus.webp"
  ],
  "datePublished": new Date().toISOString(),
  "dateModified": new Date().toISOString(),
  "author": [{
    "@type": "Organization",
    "name": "EcoFunDrive",
    "url": "https://www.ecofundrive.com"
  }]
};
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  schema={articleSchema}
  lang="en"
>
  <main class="container py-xl">
    <article class="prose max-w-4xl mx-auto">
      <div class="mb-lg">
        <span class="text-sm font-bold text-gold uppercase tracking-wider">For Immediate Release</span>
        <h1 class="mt-2 mb-4">EcoFunDrive Redefines Luxury Transport on the French Riviera with Premium Hybrid & Electric Fleet</h1>
        <p class="text-gray-600 italic">NICE, France – {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
      </div>

      <div class="content space-y-6 text-lg">
        <p><strong>EcoFunDrive</strong>, a rising leader in premium VTC (Voiture de Transport avec Chauffeur) services, today announces the expansion of its sustainable luxury transport operations across the French Riviera. Catering to an international clientele attending major events like the <strong>Cannes Film Festival</strong>, <strong>MIPIM</strong>, and the <strong>Monaco Grand Prix</strong>, EcoFunDrive bridges the gap between high-end comfort and environmental responsibility.</p>

        <p>With a fleet composed exclusively of recent <strong>Volkswagen ID Buzz</strong> and <strong>Van VW ID Buzz-Benz</strong> (Class E, Class S, Class V) vehicles, the company offers a zero-compromise solution for business travelers and tourists seeking reliability, discretion, and style.</p>

        <blockquote class="bg-gray-50 border-l-4 border-gold p-6 my-8">
          <p class="mb-0 text-xl font-medium">"The French Riviera is a global showcase for luxury, but it also faces significant environmental challenges," said the spokesperson for EcoFunDrive. "Our mission is to prove that you don't have to choose between a premium chauffeur experience and a lower carbon footprint. Whether it's a transfer from Nice Airport to Monaco or a daily disposal for the Cannes Lions, we provide a silent, smooth, and sophisticated service."</p>
        </blockquote>

        <h3>Key Highlights of EcoFunDrive Services:</h3>
        <ul class="list-disc pl-6 space-y-2">
          <li><strong>Strategic Coverage:</strong> Serving the entire Côte d'Azur corridor, including Nice, Cannes, Monaco, Antibes, and Saint-Tropez.</li>
          <li><strong>Airport Mastery:</strong> Specialized "Meet & Greet" services at <strong>Nice Côte d'Azur Airport (NCE)</strong>, ensuring seamless connections for international arrivals.</li>
          <li><strong>Event Expertise:</strong> Dedicated logistical support for congresses (MIPIM, TFWA, ILTM) and festivals.</li>
          <li><strong>Family & Safety:</strong> All vehicles equipped with complimentary child seats, catering to the growing market of family luxury tourism.</li>
          <li><strong>Transparent Pricing:</strong> Fixed-rate fares known in advance, offering a competitive and honest alternative to traditional taxi meters.</li>
        </ul>

        <div class="mt-12 p-8 bg-gray-50 rounded-lg">
          <h3 class="h4 mb-4">About EcoFunDrive</h3>
          <p class="mb-4">Based in Villeneuve-Loubet/Nice, EcoFunDrive is a licensed VTC operator specialized in private chauffeur services. The company prides itself on its team of multilingual professional drivers (English, French, Russian, Italian) and its commitment to punctuality and customer satisfaction.</p>
          
          <div class="border-t border-gray-200 pt-4 mt-4">
            <p class="font-bold mb-2">Media Contact:</p>
            <p>EcoFunDrive Press Relations<br>
            Email: <a href="mailto:8888VTC@gmail.com" class="text-gold hover:underline">8888VTC@gmail.com</a><br>
            Phone/WhatsApp: <a href="https://wa.me/33616552811" class="text-gold hover:underline">+33 6 16 55 28 11</a><br>
            Website: <a href="https://www.ecofundrive.com" class="text-gold hover:underline">https://www.ecofundrive.com</a></p>
          </div>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .text-gold { color: #00b0f0; }
  .border-gold { border-color: #00b0f0; }
  .prose h3 { font-size: 1.5rem; font-weight: 700; margin-top: 2rem; margin-bottom: 1rem; }
</style>
