---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';

const title = "Yacht Equipment & Spare Parts Delivery – Antibes & Côte d'Azur | ECOFUNDRIVE";
const description = "Fast pickup and delivery of yacht equipment, spare parts, chandlery supplies, and courier parcels to any marina on the Côte d'Azur. Same-day service, fixed prices.";
const keywords = [
  'yacht equipment delivery Antibes',
  'yacht spare parts delivery French Riviera',
  'marine equipment delivery Côte d Azur',
  'yacht chandlery delivery Port Vauban',
  'boat parts delivery Antibes',
  'tender equipment delivery French Riviera'
];
---

<BaseLayout
  title={title}
  description={description}
  currentPage="en-yacht-equipment"
  canonical="/en/yacht-equipment-delivery-antibes"
  lang="en"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Home", url: "/en" },
    { name: "Yacht Provisioning", url: "/en/yacht-provisioning-delivery-antibes" },
    { name: "Equipment Delivery", url: "/en/yacht-equipment-delivery-antibes" }
  ]}
  schema={{"@context":"https://schema.org","@type":"Service","name":"Yacht Equipment Delivery","provider":{"@type":"Organization","name":"ECOFUNDRIVE","telephone":"+33616552811"},"areaServed":"Antibes, French Riviera","description":"Pickup and delivery of marine equipment, spare parts, tender accessories, and courier parcels to yachts."}}
>
  <main id="main-content">
    <section class="hero-section">
      <div class="hero-content">
        <span class="hero-badge">⚓ YACHT EQUIPMENT • PICKUP & DELIVERY</span>
        <h1>Yacht Equipment & Spare Parts Delivery</h1>
        <p class="hero-subtitle">We collect from chandleries, marine suppliers, courier depots and deliver straight to your yacht. Same-day service across the French Riviera.</p>
        <div class="hero-cta">
          <a href="https://wa.me/33616552811" class="btn btn-whatsapp btn-lg">💬 WhatsApp Us</a>
          <a href="tel:+33616552811" class="btn btn-outline btn-lg">📞 Call Now</a>
        </div>
      </div>
    </section>

    <article class="guide-content container py-xl">
      <div class="article-body">

        <p class="lead"><strong>When your yacht needs parts, supplies, or equipment urgently, ECOFUNDRIVE gets it to you fast.</strong> Our van picks up from any marine supplier, chandlery, hardware store, or courier depot (DHL, FedEx, UPS, TNT) on the Côte d'Azur and delivers directly to your yacht's gangway. Fixed price, same-day service, no waiting around.</p>

        <h2>What We Collect & Deliver</h2>

        <div class="equipment-grid">
          <div class="equip-card">
            <h3>⚓ Deck & Rigging</h3>
            <p>Lines, fenders, shackles, deck fittings, anchor chain, navigation lights, safety equipment (flares, life jackets).</p>
          </div>
          <div class="equip-card">
            <h3>🔧 Engine & Mechanical</h3>
            <p>Filters, belts, impellers, zincs, hydraulic fluid, lubricants, water pumps, exhaust components.</p>
          </div>
          <div class="equip-card">
            <h3>🚤 Tender & Outboard</h3>
            <p>Outboard spares, propellers, fuel tanks, tender tubes, repair kits, inflatable accessories.</p>
          </div>
          <div class="equip-card">
            <h3>🔌 Electronics & Electrical</h3>
            <p>Batteries, cable, connectors, antennas, plotters, AIS transponders, LED lighting.</p>
          </div>
          <div class="equip-card">
            <h3>🧹 Cleaning & Interior</h3>
            <p>Professional cleaning products, polishes, teak treatments, linen, towels, amenities.</p>
          </div>
          <div class="equip-card">
            <h3>📦 Courier Parcels</h3>
            <p>DHL, FedEx, UPS, TNT depot pickups. We collect your packages and bring them straight to the yacht.</p>
          </div>
        </div>

        <h2>Suppliers We Collect From</h2>

        <div class="suppliers-list">
          <div class="supplier-item"><strong>Accastillage Diffusion</strong> — Antibes, marine hardware & deck supplies</div>
          <div class="supplier-item"><strong>Comptoir Nautique</strong> — Antibes, professional marine supplies</div>
          <div class="supplier-item"><strong>Uship / SailShop</strong> — Chandlery, safety equipment</div>
          <div class="supplier-item"><strong>Yachting Store Antibes</strong> — Electronics, navigation, outboard parts</div>
          <div class="supplier-item"><strong>Leroy Merlin / Castorama</strong> — Hardware, tools, DIY supplies</div>
          <div class="supplier-item"><strong>DHL / FedEx / UPS depots</strong> — Package collection Nice, Antibes, Cannes</div>
          <div class="supplier-item"><strong>Any supplier you specify</strong> — We pick up from anywhere on the Côte d'Azur</div>
        </div>

        <h2>Pricing</h2>

        <table class="tarif-table">
          <thead><tr><th>Service</th><th>Price</th><th>Duration</th></tr></thead>
          <tbody>
            <tr><td>Single pickup & delivery (Antibes area)</td><td class="price-cell">€35–50</td><td>≈ 45 min</td></tr>
            <tr><td>Single pickup & delivery (Cannes / Nice)</td><td class="price-cell">€50–75</td><td>≈ 1–1.5 hours</td></tr>
            <tr><td>Multi-stop pickup run (2–3 suppliers)</td><td class="price-cell">€60–90</td><td>≈ 2 hours</td></tr>
            <tr><td>Courier depot collection (DHL/FedEx)</td><td class="price-cell">€35–60</td><td>≈ 1 hour</td></tr>
            <tr><td>Half-day equipment runner (4h)</td><td class="price-cell">€150–200</td><td>4 hours</td></tr>
            <tr><td>Full-day equipment runner (8h)</td><td class="price-cell">€250–350</td><td>8 hours</td></tr>
          </tbody>
        </table>

        <h2>Why Use ECOFUNDRIVE for Equipment Delivery?</h2>

        <ul class="benefits-list">
          <li><strong>Same-day delivery</strong> — Call in the morning, have your parts by afternoon</li>
          <li><strong>Spacious van</strong> — Our VW ID Buzz handles bulky items: outboard motors, fenders, crates of supplies</li>
          <li><strong>Multi-stop runs</strong> — Chandlery + hardware store + courier depot in one trip, one price</li>
          <li><strong>Quayside delivery</strong> — Direct to your gangway, no carrying from the car park</li>
          <li><strong>Photo confirmation</strong> — We WhatsApp you photos of what we've collected before leaving the supplier</li>
          <li><strong>Available 7 days</strong> — Including weekends during season</li>
        </ul>

        <h2>Frequently Asked Questions</h2>

        <div class="faq-list">
          <div class="faq-item">
            <h3 class="faq-question">Can you pick up a heavy outboard motor or large equipment?</h3>
            <div class="faq-answer"><p>Our VW ID Buzz has a large flat cargo area and can handle items up to approximately 200 kg. For extremely heavy or oversized equipment (generators, crane parts), we can arrange a larger vehicle on request.</p></div>
          </div>
          <div class="faq-item">
            <h3 class="faq-question">Can you pay for the equipment on our behalf?</h3>
            <div class="faq-answer"><p>Yes, for orders up to €500 we can pay at the supplier and you reimburse us on delivery. For larger amounts, we recommend you pre-pay the supplier directly or provide a company card.</p></div>
          </div>
          <div class="faq-item">
            <h3 class="faq-question">How fast can you do an urgent delivery?</h3>
            <div class="faq-answer"><p>For urgent requests within the Antibes area, we can typically collect and deliver within 1–2 hours. For suppliers in Nice or Cannes, allow 2–3 hours.</p></div>
          </div>
          <div class="faq-item">
            <h3 class="faq-question">Do you deliver to yachts in the boatyard during refit?</h3>
            <div class="faq-answer"><p>Yes. We deliver to yachts in refit at Port Vauban, Antibes Yacht Services, Compositeworks, and other yards in the area. We can also handle regular delivery runs during the refit season (October–April).</p></div>
          </div>
        </div>

      </div>
    </article>

    <section class="cta-section fade-in-section">
      <div class="container text-center">
        <h2>Need Parts Delivered to Your Yacht?</h2>
        <p class="lead mb-lg">Tell us what you need and where to collect it. We'll handle the rest.</p>
        <div class="cta-buttons">
          <a href="https://wa.me/33616552811" class="btn btn-whatsapp btn-lg">💬 WhatsApp</a>
          <a href="tel:+33616552811" class="btn btn-gold btn-lg">📞 Call Us</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero-section { background: linear-gradient(135deg, rgba(0,20,40,0.85), rgba(0,40,80,0.7)), url('/assets/img/fun-buzz/OIPblack.jpg'); background-size: cover; background-position: center; padding: 8rem 2rem; text-align: center; color: white; }
  .hero-badge { display: inline-block; background: rgba(0,176,240,0.2); border: 1px solid rgba(0,176,240,0.4); padding: 0.5rem 1.5rem; border-radius: 50px; font-size: 0.85rem; font-weight: 600; margin-bottom: 1.5rem; color: #66d0f7; }
  .hero-section h1 { font-size: 2.5rem; margin-bottom: 1rem; text-shadow: 2px 2px 4px rgba(0,0,0,0.5); }
  .hero-subtitle { font-size: 1.15rem; margin-bottom: 2rem; opacity: 0.9; max-width: 700px; margin-left: auto; margin-right: auto; }
  .hero-cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .btn { padding: 1rem 2rem; border-radius: 50px; text-decoration: none; font-weight: 600; transition: all 0.3s ease; display: inline-block; }
  .btn-whatsapp { background: #25D366; color: white; }
  .btn-whatsapp:hover { background: #1da851; }
  .btn-gold { background: #00b0f0; color: #000; }
  .btn-outline { border: 2px solid white; color: white; }
  .btn-outline:hover { background: white; color: #000; }
  .btn-lg { padding: 1.25rem 2.5rem; font-size: 1.1rem; }
  .guide-content { max-width: 900px; margin: 0 auto; }
  .article-body { font-size: 1.05rem; line-height: 1.8; }
  .article-body h2 { color: #00b0f0; margin-top: 3rem; margin-bottom: 1rem; font-size: 1.8rem; }
  .lead { font-size: 1.15rem; color: #444; }
  .equipment-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin: 2rem 0; }
  .equip-card { background: #f9f9f9; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #00b0f0; }
  .equip-card h3 { margin-top: 0; color: #1a1a1a; }
  .suppliers-list { display: grid; gap: 0.75rem; margin: 2rem 0; }
  .supplier-item { background: #f9f9f9; padding: 1rem 1.5rem; border-radius: 8px; }
  .price-cell { font-weight: 700; color: #00b0f0; }
  .benefits-list { list-style: none; padding: 0; }
  .benefits-list li { padding: 0.75rem 0; border-bottom: 1px solid #eee; }
  .benefits-list li:last-child { border-bottom: none; }
  .cta-section { background: linear-gradient(135deg, #001428, #002850); padding: 4rem 2rem; color: white; }
  .cta-section h2 { color: white; }
  .cta-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  @media (max-width: 768px) { .hero-section { padding: 5rem 1rem; } .hero-section h1 { font-size: 1.8rem; } }
</style>
