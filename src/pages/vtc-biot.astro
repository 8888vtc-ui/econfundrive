---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Biot – Chauffeur Privé Verriers & Marineland | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Biot. Village des verriers, Marineland, Sophia Antipolis. Entre Antibes et Nice. Service premium 24/7.";
const keywords = [
  'VTC Biot',
  'chauffeur privé Biot',
  'VTC Marineland',
  'transfert Antibes Biot',
  'VTC verreries Biot'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-biot"
  canonical="/vtc-biot"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Biot", url: "/vtc-biot" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Proposez-vous des navettes Marineland ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous assurons les transferts vers Marineland et tous les parcs de la zone."}},{"@type":"Question","name":"Peut-on visiter les verreries ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous vous déposons à la Verrerie de Biot et dans les ateliers d'art du village."}}]}}
>
  <PageHero 
    title="VTC Biot"
    subtitle="Le village des métiers d'art. Verreries légendaires, Marineland et proximité de Sophia Antipolis."
    backgroundImage="/assets/img/destinations/destination-nice.webp"
    badge="ARTISANAT • MARINELAND • TECH"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Verre Bullé & Innovation"
      image="/assets/img/fun-buzz/OIPblan.jpg"
      alt="VTC Biot"
      imageSide="right"
      ctaText="Réserver un transfert"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Biot</strong> est mondialement connu pour son artisanat du <strong>verre bullé</strong> et ses ateliers d'art. En contrebas, le parc <strong>Marineland</strong> attire les familles, tandis que Sophia Antipolis rassemble l'innovation technologique.
      </p>
      <p class="fade-in-section">
        ECOFUNDRIVE s'adapte à tous vos besoins : navettes familiales, transferts business ou excursions touristiques dans ce village provençal authentique.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Sophia : 5 min</span>
        <span class="distance-badge">📍 Antibes : 10 min</span>
        <span class="distance-badge">📍 Nice : 30 min</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Services à Biot</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">🐬</span><h3>Marineland</h3><p>Navettes familiales vers le parc marin. Sièges bébé gratuits.</p></div>
          <div class="service-card"><span class="service-icon">🏺</span><h3>Verreries</h3><p>Excursions découverte des ateliers de maîtres verriers.</p></div>
          <div class="service-card"><span class="service-icon">💼</span><h3>Sophia Antipolis</h3><p>Liaisons rapides vers le technopôle pour professionnels.</p></div>
          <div class="service-card"><span class="service-icon">🎨</span><h3>Musée Léger</h3><p>Visite du musée national Fernand Léger.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez Biot</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/destinations/destination-nice.webp" alt="Verrerie Biot" title="🏺 La Verrerie" description="Découvrez le secret du verre bullé, tradition locale depuis 1956. Visite des ateliers." link="/reservation" />
        <CategoryCard image="/assets/img/fun-buzz/OIPblan.jpg" alt="Marineland" title="🐬 Marineland" description="Le plus grand parc marin d'Europe. Spectacles d'orques, dauphins et otaries." link="/reservation" />
        <CategoryCard image="/assets/img/fun-buzz/interieur.jpg" alt="Musée Fernand Léger" title="🎨 Musée Fernand Léger" description="Collection unique de l'artiste cubiste dans un bâtiment aux mosaïques monumentales." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC à Biot</h2>
        <p>Famille, culture ou business. Un service adapté à chaque occasion.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-antibes" class="text-dark hover-gold">VTC Antibes</a>
        <a href="/vtc-sophia-antipolis" class="text-dark hover-gold">VTC Sophia</a>
        <a href="/vtc-villeneuve-loubet" class="text-dark hover-gold">VTC Villeneuve</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #00b0f0; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(0, 176, 240, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(0, 176, 240, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #00b0f0; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #00b0f0, #66d0f7); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #00b0f0; color: #00b0f0; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
