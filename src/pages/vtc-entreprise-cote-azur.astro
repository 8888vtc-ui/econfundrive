---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Entreprise Côte d'Azur – Service Chauffeur Privé Business | ECOFUNDRIVE";
const description = "Solutions de transport d'affaires VTC sur la Côte d'Azur. Transferts gare/aéroport, mise à disposition, délégation VIP. Facturation mensuelle simplifiée.";
const keywords = [
  'VTC, entreprise',
  'chauffeur privé business',
  'VTC Côte d\'Azur société',
  'transport d\'affaires Nice',
  'contrat entreprise VTC'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-entreprise-cote-azur"
  canonical="/vtc-entreprise-cote-azur"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "Entreprise", url: "/vtc-entreprise-cote-azur" }
  ]}
>
  <PageHero 
    title="Service VTC Business"
    subtitle="L'excellence pour vos déplacements professionnels. Ponctualité, discrétion et confort de travail."
    backgroundImage="/assets/img/services/service-business.webp"
    badge="BUSINESS • CORPORATE • EVENTS"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Partenaire de votre Mobilité"
      image="/assets/img/services/service-business.webp"
      alt="VTC Business"
      imageSide="right"
      ctaText="Ouvrir un Compte Pro"
      ctaLink="/contact"
    >
      <p class="fade-in-section">
        Optimisez les déplacements de vos collaborateurs et clients avec ECOFUNDRIVE. Nous proposons une solution de transport <strong>fiable, premium et flexible</strong> pour les entreprises de la Côte d'Azur (Sophia Antipolis, Nice, Cannes, Monaco).
      </p>
      <p class="fade-in-section">
        Le temps de trajet devient du temps de travail grâce au confort de nos véhicules (Wi-Fi, chargeurs, silence). Simplifiez votre gestion avec nos <strong>solutions de facturation mensuelle</strong>.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📊 Facturation centralisée</span>
        <span class="distance-badge">⏱️ Priorité réservation</span>
        <span class="distance-badge">🤵 Chauffeurs bilingues</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Services Corporate</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">✈️</span><h3>Aéroport & Gare</h3><p>Accueil personnalisé clients et collaborateurs avec pancarte.</p></div>
          <div class="service-card"><span class="service-icon">🤝</span><h3>Séminaires</h3><p>Logistique transport pour vos congrès et événements.</p></div>
          <div class="service-card"><span class="service-icon">⏱️</span><h3>Mise à Disposition</h3><p>Chauffeur dédié pour vos roadshows ou tournées de RDV.</p></div>
          <div class="service-card"><span class="service-icon">📂</span><h3>Compte Pro</h3><p>Paiement différé et facturation détaillée fin de mois.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Pôles d'Activité Desservis</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/destinations/destination-nice.webp" alt="Sophia Antipolis" title="🖥️ Sophia Antipolis" description="Liaisons quotidiennes vers la 1ère technopole d'Europe à Valbonne/Biot." link="/vtc-sophia-antipolis" />
        <CategoryCard image="/assets/img/destinations/destination-nice.webp" alt="Nice Écovallée" title="🏢 Nice Écovallée" description="Desserte du quartier d'affaires Grand Arénas et de l'aéroport." link="/vtc-nice" />
        <CategoryCard image="/assets/img/destinations/cannes-palais-festivals.webp" alt="Cannes Congrès" title="🎬 Cannes Congrès" description="Transport lors des salons : MIPIM, Festival, Cannes Lions, ILTM..." link="/vtc-cannes" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Devenir Partenaire Business</h2>
        <p>Contactez-nous pour ouvrir un compte entreprise et bénéficier de tarifs préférentiels.</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn-gold">Contacter le Service Pro</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #d4af37; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
