---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const title = "Трансфер Сен-Тропе – Личный Водитель Пампелон & Пляжи | ECOFUNDRIVE";
const description = "Премиум трансфер в Сен-Тропе. Пляжи Пампелон, Club 55, Nikki Beach, порт, Place des Lices. Трансферы из Ниццы и Канн.";
const keywords = [
  'трансфер Сен-Тропе',
  'личный водитель Сен-Тропе',
  'трансфер Ницца Сен-Тропе',
  'VTC Пампелон',
  'водитель Club 55'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="ru-saint-tropez"
  canonical="/ru/transfer-saint-tropez"
  lang="ru"
  breadcrumbItems={[
    { name: "Главная", url: "/ru" },
    { name: "Трансфер Сен-Тропе", url: "/ru/transfer-saint-tropez" }
  ]}
  schema={{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Сколько времени от Ниццы до Сен-Тропе?","acceptedAnswer":{"@type":"Answer","text":"Трансфер аэропорт Ниццы → Сен-Тропе занимает около 1ч30-2ч (110 км). Летом рассчитывайте до 2ч30 из-за трафика."}},{"@type":"Question","name":"Предлагаете ли вы трансферы на пляжи Пампелон?","acceptedAnswer":{"@type":"Answer","text":"Да, мы обслуживаем все пляжи Пампелон: Club 55, Nikki Beach, Bagatelle, Tahiti Beach."}},{"@type":"Question","name":"Забираете ли вы клиентов после вечеринок?","acceptedAnswer":{"@type":"Answer","text":"Конечно! Наш сервис 24/24 особенно ценится для возвращения после вечеринок в Сен-Тропе."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    <SectionImageText
      title="Ваш Личный Водитель в Сен-Тропе"
      image="/assets/img/destinations/destination-saint-tropez.webp"
      alt="Трансфер личный водитель Сен-Тропе порт"
      imageSide="right"
      ctaText="Забронировать Трансфер"
      ctaLink="/ru/kontakt"
    >
      <p class="fade-in-section">
        <strong>Сен-Тропе</strong> — живая легенда Лазурного Берега. Эта маленькая рыбацкая деревня, ставшая мировой джет-сет столицей, сохранила свое провансальское очарование.
      </p>
      <p class="fade-in-section">
        Но Сен-Тропе также означает пробки и невозможную парковку, особенно летом. ECOFUNDRIVE предлагает <strong>идеальное решение</strong>: личный водитель доставит вас куда нужно.
      </p>
      <ul class="fade-in-section">
        <li>Трансферы из аэропорта Ниццы (1ч30-2ч)</li>
        <li>Трансферы из Канн (1ч15)</li>
        <li>Шаттлы на пляжи Пампелон (Club 55, Nikki Beach)</li>
        <li>Ночной сервис и возврат после вечеринок</li>
        <li>Аренда на весь день</li>
      </ul>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Тарифы на Трансферы в Сен-Тропе</h2>
      <div class="cta-box">
        <a href="/ru/kontakt" class="btn-primary">Запросить цену</a>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Откройте Сен-Тропе</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Пляжи Пампелон"
          title="Пляжи Пампелон"
          description="5 км золотого песка, легендарные клубы: Club 55, Nikki Beach, Bagatelle."
          link="/ru/kontakt"
        />
        <CategoryCard
          image="/assets/img/services/service-evenements.webp"
          alt="Порт Сен-Тропе"
          title="Легендарный Порт"
          description="Яхты мечты, оживленные террасы, красочные фасады. Декорации Бриджит Бардо."
          link="/ru/kontakt"
        />
        <CategoryCard
          image="/assets/img/about/vehicule-premium.webp"
          alt="Place des Lices"
          title="Place des Lices"
          description="Провансальский рынок, партии в петанк, кафе Sénéquier. Сердце Сен-Тропе."
          link="/ru/kontakt"
        />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Часто Задаваемые Вопросы</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-question">Сколько времени от Ниццы до Сен-Тропе?</h3>
          <div class="faq-answer">
            <p>Трансфер <strong>аэропорт Ниццы → Сен-Тропе</strong> занимает около <strong>1ч30-2ч</strong> (110 км). Летом рассчитывайте до 2ч30 из-за трафика.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Предлагаете ли вы трансферы на пляжи Пампелон?</h3>
          <div class="faq-answer">
            <p>Да, мы обслуживаем <strong>все пляжи Пампелон</strong>: Club 55, Nikki Beach, Bagatelle, Tahiti Beach.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Забираете ли вы клиентов после вечеринок?</h3>
          <div class="faq-answer">
            <p>Конечно! Наш <strong>сервис 24/24</strong> особенно ценится для возвращения после вечеринок в Сен-Тропе.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Ближайшие Направления</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/ru" class="text-dark hover-gold">Трансфер Ницца</a>
        <a href="/ru/transfer-cannes" class="text-dark hover-gold">Трансфер Канны</a>
        <a href="/ru/transfer-monaco" class="text-dark hover-gold">Трансфер Монако</a>
        <a href="/ru/transfer-eze" class="text-dark hover-gold">Тур в Эз</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .cta-box { text-align: center; padding: 2rem; background: #f9f9f9; border-radius: 12px; }
  .btn-primary {
    display: inline-block;
    background: #d4af37;
    color: #000;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
  }
  .btn-primary:hover { background: #b8941f; transform: translateY(-2px); }
</style>
