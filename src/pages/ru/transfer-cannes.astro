---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

import PricingRequest from '../../components/PricingRequest.astro';
const title = "Трансфер Канны – Личный Водитель Фестивали & Круазет | ECOFUNDRIVE";
const description = "Премиум трансфер в Канны. Каннский кинофестиваль, MIPIM, Круазет, Дворец Фестивалей. Русскоговорящий водитель 24/7. Трансферы из Ниццы.";
const keywords = [
  'трансфер Канны',
  'личный водитель Канны',
  'Каннский фестиваль трансфер',
  'VTC Круазет',
  'MIPIM Канны водитель'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="ru-cannes"
  canonical="/ru/transfer-cannes"
  lang="ru"
  breadcrumbItems={[
    { name: "Главная", url: "/ru" },
    { name: "Трансфер Канны", url: "/ru/transfer-cannes" }
  ]}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    <SectionImageText
      title="Ваш Личный Водитель в Каннах"
      image="/assets/img/destinations/cannes-palais-festivals.png"
      alt="Трансфер личный водитель Канны Круазет"
      imageSide="right"
      ctaText="Забронировать Трансфер"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Канны</strong> — синоним гламура, роскоши и международных событий. Родина легендарного <strong>Каннского кинофестиваля</strong>, город привлекает знаменитостей, бизнес-лидеров и взыскательных путешественников круглый год. Знаменитый <strong>Бульвар Круазет</strong>, бутики класса люкс и живописные пляжи делают Канны культовым направлением Ривьеры.
      </p>
      <p class="fade-in-section">
        Помимо Фестиваля, Канны принимают крупные международные мероприятия, включая <strong>MIPIM</strong> (недвижимость), <strong>MIPTV</strong> (телевидение), <strong>Cannes Lions</strong> (реклама) и многочисленные конгрессы во Дворце Фестивалей.
      </p>
      <ul class="fade-in-section">
        <li>Трансферы аэропорт Ниццы - Канны (35-45 мин)</li>
        <li>Специальный сервис Каннский кинофестиваль</li>
        <li>Транспорт MIPIM, MIPTV, Cannes Lions</li>
        <li>Трансферы в отели Круазет</li>
        <li>Экскурсии в Монако, Сен-Тропе</li>
        <li>Вечерние мероприятия и красная дорожка</li>
      </ul>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Тарифы на Трансферы в Канны</h2>
      <PricingRequest />
      <p class="text-center mt-md"><em>Цены могут меняться во время крупных мероприятий. Бронируйте заранее на период Фестиваля.</em></p>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Главные События в Каннах</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Каннский кинофестиваль"
          title="Каннский Кинофестиваль"
          description="Самый престижный кинофестиваль мира. Трансферы на красную дорожку, вечеринки, яхтенные мероприятия."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="MIPIM Канны"
          title="MIPIM Недвижимость"
          description="Ведущая мировая конференция по недвижимости. Трансферы из аэропорта, встречи с клиентами, нетворкинг."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/about/vehicule-premium.webp"
          alt="Cannes Lions"
          title="Cannes Lions"
          description="Глобальный фестиваль рекламного креатива. Представительский транспорт, вечеринки, трансферы в отели."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Часто Задаваемые Вопросы</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-question">Сколько времени занимает трансфер из аэропорта Ниццы в Канны?</h3>
          <div class="faq-answer">
            <p>Трансфер из аэропорта Ниццы в Канны занимает примерно <strong>35-45 минут</strong> в зависимости от трафика (около 35 км по автостраде A8).</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Предоставляете ли вы сервис во время Каннского кинофестиваля?</h3>
          <div class="faq-answer">
            <p>Да, мы предлагаем премиум-сервис во время Каннского кинофестиваля (обычно в середине мая). Рекомендуем бронировать <strong>за 2-3 месяца</strong> из-за очень высокого спроса.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Ваши водители говорят по-русски?</h3>
          <div class="faq-answer">
            <p>Да, у нас есть русскоговорящие водители. По запросу мы можем предоставить водителя, владеющего русским языком.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Ближайшие Направления</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/ru" class="text-dark hover-gold">Трансфер Ницца</a>
        <a href="/ru/transfer-monaco" class="text-dark hover-gold">Трансфер Монако</a>
        <a href="/ru/transfer-saint-tropez" class="text-dark hover-gold">Трансфер Сен-Тропе</a>
        <a href="/vtc-antibes" class="text-dark hover-gold">Трансфер Антиб</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
