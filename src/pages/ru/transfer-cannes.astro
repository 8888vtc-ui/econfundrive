---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const title = "Трансфер Канны – Личный Водитель Фестивали & Круазет | ECOFUNDRIVE";
const description = "Премиум трансфер в Канны. Каннский кинофестиваль, MIPIM, Круазет, Дворец Фестивалей. Русскоговорящий водитель 24/7. Трансферы из Ниццы.";
const keywords = [
  'трансфер Канны',
  'личный водитель Канны',
  'Каннский фестиваль трансфер',
  'VTC Круазет',
  'MIPIM Канны водитель'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="ru-cannes"
  canonical="/ru/transfer-cannes"
  lang="ru"
  breadcrumbItems={[
    { name: "Главная", url: "/ru" },
    { name: "Трансфер Канны", url: "/ru/transfer-cannes" }
  ]}
  schema={{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Сколько времени занимает трансфер из аэропорта Ниццы в Канны?","acceptedAnswer":{"@type":"Answer","text":"Трансфер из аэропорта Ниццы в Канны занимает примерно 35-45 минут в зависимости от трафика (около 35 км по автостраде A8)."}},{"@type":"Question","name":"Предоставляете ли вы сервис во время Каннского кинофестиваля?","acceptedAnswer":{"@type":"Answer","text":"Да, мы предлагаем премиум-сервис во время Каннского кинофестиваля. Рекомендуем бронировать за 2-3 месяца."}},{"@type":"Question","name":"Ваши водители говорят по-русски?","acceptedAnswer":{"@type":"Answer","text":"Да, у нас есть русскоговорящие водители. По запросу мы можем предоставить водителя, владеющего русским языком."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    <SectionImageText
      title="Ваш Личный Водитель в Каннах"
      image="/assets/img/destinations/cannes-palais-festivals.webp"
      alt="Трансфер личный водитель Канны Круазет"
      imageSide="right"
      ctaText="Забронировать Трансфер"
      ctaLink="/ru/kontakt"
    >
      <p class="fade-in-section">
        <strong>Канны</strong> — синоним гламура, роскоши и международных событий. Родина легендарного <strong>Каннского кинофестиваля</strong>, город привлекает знаменитостей, бизнес-лидеров и взыскательных путешественников круглый год.
      </p>
      <p class="fade-in-section">
        Помимо Фестиваля, Канны принимают крупные международные мероприятия, включая <strong>MIPIM</strong> (недвижимость), <strong>MIPTV</strong> (телевидение), <strong>Cannes Lions</strong> (реклама).
      </p>
      <ul class="fade-in-section">
        <li>Трансферы аэропорт Ниццы - Канны (35-45 мин)</li>
        <li>Специальный сервис Каннский кинофестиваль</li>
        <li>Транспорт MIPIM, MIPTV, Cannes Lions</li>
        <li>Трансферы в отели Круазет</li>
        <li>Экскурсии в Монако, Сен-Тропе</li>
      </ul>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Тарифы на Трансферы в Канны</h2>
      <div class="cta-box">
        <a href="/ru/kontakt" class="btn-primary">Запросить цену</a>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Главные События в Каннах</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/fun-buzz/OIP.jpg"
          alt="Каннский кинофестиваль"
          title="Каннский Кинофестиваль"
          description="Самый престижный кинофестиваль мира. Трансферы на красную дорожку, вечеринки, яхтенные мероприятия."
          link="/ru/kontakt"
        />
        <CategoryCard
          image="/assets/img/fun-buzz/OIPblan.jpg"
          alt="MIPIM Канны"
          title="MIPIM Недвижимость"
          description="Ведущая мировая конференция по недвижимости. Трансферы из аэропорта, встречи с клиентами."
          link="/ru/kontakt"
        />
        <CategoryCard
          image="/assets/img/fun-buzz/DB2022AU00771_web_1600.jpg"
          alt="Cannes Lions"
          title="Cannes Lions"
          description="Глобальный фестиваль рекламного креатива. Представительский транспорт, трансферы в отели."
          link="/ru/kontakt"
        />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Часто Задаваемые Вопросы</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-question">Сколько времени занимает трансфер из аэропорта Ниццы в Канны?</h3>
          <div class="faq-answer">
            <p>Трансфер из аэропорта Ниццы в Канны занимает примерно <strong>35-45 минут</strong> в зависимости от трафика (около 35 км по автостраде A8).</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Предоставляете ли вы сервис во время Каннского кинофестиваля?</h3>
          <div class="faq-answer">
            <p>Да, мы предлагаем <strong>премиум-сервис</strong> во время Каннского кинофестиваля. Рекомендуем бронировать за 2-3 месяца.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Ваши водители говорят по-русски?</h3>
          <div class="faq-answer">
            <p>Да, у нас есть <strong>русскоговорящие водители</strong>. По запросу мы можем предоставить водителя, владеющего русским языком.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Ближайшие Направления</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/ru" class="text-dark hover-gold">Трансфер Ницца</a>
        <a href="/ru/transfer-monaco" class="text-dark hover-gold">Трансфер Монако</a>
        <a href="/ru/transfer-saint-tropez" class="text-dark hover-gold">Трансфер Сен-Тропе</a>
        <a href="/ru/transfer-antibes" class="text-dark hover-gold">Трансфер Антиб</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .cta-box { text-align: center; padding: 2rem; background: #f9f9f9; border-radius: 12px; }
  .btn-primary {
    display: inline-block;
    background: #00b0f0;
    color: #000;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
  }
  .btn-primary:hover { background: #006b8c; transform: translateY(-2px); }
</style>
