---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const title = "Трансфер Ницца – Личный Водитель Аэропорт & Лазурный Берег | ECOFUNDRIVE";
const description = "Премиум трансфер в Ницце. Аэропорт Ницца Лазурный Берег, Английская набережная, Старый город. Русскоговорящий водитель 24/7.";
const keywords = [
  'трансфер Ницца',
  'личный водитель Ницца',
  'трансфер аэропорт Ниццы',
  'VTC Лазурный Берег',
  'русский водитель Ницца'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="ru-transfer-nice"
  canonical="/ru/transfer-nizza"
  lang="ru"
  breadcrumbItems={[
    { name: "Главная", url: "/ru" },
    { name: "Трансфер Ницца", url: "/ru/transfer-nizza" }
  ]}
  schema={{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Сколько стоит трансфер из аэропорта Ниццы в центр?","acceptedAnswer":{"@type":"Answer","text":"Трансфер из аэропорта Ниццы в центр города стоит приблизительно 35€ (около 7 км, 15-20 минут). Цена включает встречу и помощь с багажом."}},{"@type":"Question","name":"Отслеживаете ли вы рейсы?","acceptedAnswer":{"@type":"Answer","text":"Да, мы отслеживаем все рейсы. Если рейс задерживается, мы автоматически корректируем время встречи."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    <SectionImageText
      title="Ваш Личный Водитель в Ницце"
      image="/assets/img/destinations/destination-nice.png"
      alt="Трансфер личный водитель Ницца Английская набережная"
      imageSide="right"
      ctaText="Забронировать Трансфер"
      ctaLink="/ru/kontakt"
    >
      <p class="fade-in-section">
        <strong>Ницца</strong> — яркая столица Лазурного Берега. От знаменитой <strong>Английской набережной</strong> до красочного <strong>Старого города</strong> и панорамы с <strong>Замковой горы</strong>, Ницца дарит незабываемые впечатления.
      </p>
      <p class="fade-in-section">
        <strong>Аэропорт Ницца Лазурный Берег</strong> — это ворота всей Ривьеры. ECOFUNDRIVE предоставляет <strong>премиум-трансферы</strong> в любую точку побережья.
      </p>
      <ul class="fade-in-section">
        <li>Трансферы из аэропорта Ниццы с встречей</li>
        <li>Экскурсии по городу и достопримечательностям</li>
        <li>Трансферы в Монако, Канны, Сен-Тропе</li>
        <li>Панорамные туры по Корнишам</li>
        <li>Профессиональные русскоговорящие водители</li>
      </ul>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Тарифы на Трансферы из Аэропорта Ниццы</h2>
      <div class="cta-box">
        <a href="/ru/kontakt" class="btn-primary">Запросить цену</a>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Откройте Ниццу</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/fun-buzz/OIPint.jpg"
          alt="Английская набережная Ницца"
          title="Английская Набережная"
          description="Знаменитая 7-километровая набережная. Лазурные воды, архитектура Belle Époque."
          link="/ru/kontakt"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-saint-tropez.webp"
          alt="Старый город Ницца"
          title="Старый Город"
          description="Красочные барочные здания, оживленные рынки, аутентичные рестораны."
          link="/ru/kontakt"
        />
        <CategoryCard
          image="/assets/img/fun-buzz/espace.jpg"
          alt="Замковая гора Ницца"
          title="Замковая Гора"
          description="Панорамные виды на Залив Ангелов, порт и Старый город."
          link="/ru/kontakt"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Направления на Лазурном Берегу</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/ru/transfer-monaco" class="text-dark hover-gold">Монако</a>
        <a href="/ru/transfer-cannes" class="text-dark hover-gold">Канны</a>
        <a href="/ru/transfer-saint-tropez" class="text-dark hover-gold">Сен-Тропе</a>
        <a href="/ru" class="text-dark hover-gold">Все Направления</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .cta-box { text-align: center; padding: 2rem; background: #f9f9f9; border-radius: 12px; }
  .btn-primary {
    display: inline-block;
    background: #00b0f0;
    color: #000;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
  }
</style>
