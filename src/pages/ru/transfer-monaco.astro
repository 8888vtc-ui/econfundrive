---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const title = "Трансфер Монако – Личный Водитель Монте-Карло | ECOFUNDRIVE";
const description = "Премиум трансфер в Монако. Казино Монте-Карло, Гран-При F1, Порт Эркюль, 5-звездочные отели. Русскоговорящий водитель. Трансферы из Ниццы.";
const keywords = [
  'трансфер Монако',
  'личный водитель Монако',
  'трансфер Ницца Монако',
  'VTC Монте-Карло',
  'русский водитель Монако'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="ru-monaco"
  canonical="/ru/transfer-monaco"
  lang="ru"
  breadcrumbItems={[
    { name: "Главная", url: "/ru" },
    { name: "Трансфер Монако", url: "/ru/transfer-monaco" }
  ]}
  schema={{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Сколько времени занимает трансфер из аэропорта Ниццы в Монако?","acceptedAnswer":{"@type":"Answer","text":"Трансфер из аэропорта Ниццы в Монако занимает примерно 30-45 минут в зависимости от трафика (около 30 км)."}},{"@type":"Question","name":"Вы предоставляете услуги во время Гран-При Монако?","acceptedAnswer":{"@type":"Answer","text":"Да, мы предоставляем премиум услуги во время Гран-При Монако. Рекомендуем бронировать за несколько месяцев."}},{"@type":"Question","name":"Ваши водители говорят по-русски?","acceptedAnswer":{"@type":"Answer","text":"Да, у нас есть русскоговорящие водители. По запросу мы можем предоставить водителя, владеющего русским языком."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    <SectionImageText
      title="Ваш Личный Водитель в Монако"
      image="/assets/img/destinations/destination-monaco.png"
      alt="Трансфер личный водитель Монако Монте-Карло"
      imageSide="right"
      ctaText="Забронировать Трансфер"
      ctaLink="/ru/kontakt"
    >
      <p class="fade-in-section">
        <strong>Монако</strong>, гламурное княжество на Лазурном Берегу, воплощает роскошь, элегантность и престиж. Посещаете ли вы <strong>Казино Монте-Карло</strong>, участвуете в <strong>Гран-При Ф1</strong>, или остановились в одном из люксовых отелей — вы заслуживаете премиум-сервиса.
      </p>
      <p class="fade-in-section">
        ECOFUNDRIVE предоставляет <strong>премиум трансферы в Монако</strong>, идеальные для поездок из аэропорта Ниццы, деловых встреч, особых мероприятий и исследования средиземноморского побережья.
      </p>
      <ul class="fade-in-section">
        <li>Трансфер аэропорт Ниццы - Монако (30-45 мин)</li>
        <li>Специальный сервис на Гран-При Монако</li>
        <li>Трансферы в люксовые отели и на яхты</li>
        <li>Бизнес и корпоративные перевозки</li>
        <li>Профессиональные русскоговорящие водители</li>
        <li>Премиум автомобили (Tesla, Mercedes S-Class)</li>
      </ul>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Тарифы на Трансферы в Монако</h2>
      <div class="cta-box">
        <a href="/ru/kontakt" class="btn-primary">Запросить цену</a>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Откройте Монако с Личным Водителем</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Казино Монте-Карло"
          title="Казино Монте-Карло"
          description="Икона стиля Belle Époque, символ гламура Монако. Вечерние трансферы для посещения казино."
          link="/ru/kontakt"
        />
        <CategoryCard
          image="/assets/img/services/service-aeroport.webp"
          alt="Гран-При Монако"
          title="Гран-При Формулы 1"
          description="Специальный сервис на самую престижную гонку мира. Бронируйте за несколько месяцев."
          link="/ru/kontakt"
        />
        <CategoryCard
          image="/assets/img/about/vehicule-premium.webp"
          alt="Порт Эркюль Монако"
          title="Порт Эркюль и Яхты"
          description="Трансферы к суперяхтам и Monaco Yacht Show. Высадка прямо у причала."
          link="/ru/kontakt"
        />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Часто Задаваемые Вопросы</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-question">Сколько времени занимает трансфер из аэропорта Ниццы в Монако?</h3>
          <div class="faq-answer">
            <p>Трансфер из <strong>аэропорта Ниццы в Монако</strong> занимает примерно <strong>30-45 минут</strong> в зависимости от трафика (около 30 км по живописной дороге).</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Вы предоставляете услуги во время Гран-При Монако?</h3>
          <div class="faq-answer">
            <p>Да, мы предоставляем <strong>премиум услуги во время Гран-При Монако</strong>. Рекомендуем бронировать за 2-3 месяца из-за высокого спроса.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Ваши водители говорят по-русски?</h3>
          <div class="faq-answer">
            <p>Да, у нас есть <strong>русскоговорящие водители</strong>. По запросу мы можем предоставить водителя, владеющего русским языком.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Ближайшие Направления</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/ru" class="text-dark hover-gold">Трансфер Ницца</a>
        <a href="/ru/transfer-cannes" class="text-dark hover-gold">Трансфер Канны</a>
        <a href="/ru/transfer-eze" class="text-dark hover-gold">Тур в Эз</a>
        <a href="/ru/transfer-saint-tropez" class="text-dark hover-gold">Сен-Тропе</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .cta-box { text-align: center; padding: 2rem; background: #f9f9f9; border-radius: 12px; }
  .btn-primary {
    display: inline-block;
    background: #d4af37;
    color: #000;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
  }
  .btn-primary:hover { background: #b8941f; transform: translateY(-2px); }
</style>
