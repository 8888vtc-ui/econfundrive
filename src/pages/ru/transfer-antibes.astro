---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const title = "Трансфер Антиб – Личный Водитель Порт Вобан & Кап | ECOFUNDRIVE";
const description = "Премиум трансфер в Антиб и Жуан-ле-Пен. Порт Вобан, Кап д'Антиб, Jazz à Juan, Музей Пикассо. Трансферы из Ниццы.";
const keywords = [
  'трансфер Антиб',
  'личный водитель Антиб',
  'VTC Жуан-ле-Пен',
  'трансфер Порт Вобан',
  'водитель Кап д Антиб'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="ru-transfer-antibes"
  canonical="/ru/transfer-antibes"
  lang="ru"
  breadcrumbItems={[
    { name: "Главная", url: "/ru" },
    { name: "Трансфер Антиб", url: "/ru/transfer-antibes" }
  ]}
  schema={{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Сколько времени до Антиба от аэропорта Ниццы?","acceptedAnswer":{"@type":"Answer","text":"Трансфер из аэропорта Ниццы в Антиб занимает около 20-30 минут (около 20 км). Антиб расположен между Ниццей и Каннами."}},{"@type":"Question","name":"Предоставляете ли вы сервис для Порта Вобан?","acceptedAnswer":{"@type":"Answer","text":"Да, мы регулярно работаем с экипажами яхт и посетителями Порта Вобан, крупнейшего порта для суперяхт в Европе."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    <SectionImageText
      title="Ваш Личный Водитель в Антибе"
      image="/assets/img/destinations/destination-nice.webp"
      alt="Трансфер личный водитель Антиб Порт Вобан"
      imageSide="right"
      ctaText="Забронировать Трансфер"
      ctaLink="/ru/kontakt"
    >
      <p class="fade-in-section">
        <strong>Антиб</strong> — очаровательный прибрежный город с богатым историческим наследием. Сегодня он знаменит <strong>Портом Вобан</strong>, крупнейшим портом для суперяхт в Европе, и <strong>Музеем Пикассо</strong>.
      </p>
      <p class="fade-in-section">
        <strong>Кап д'Антиб</strong> является домом для эксклюзивных отелей, включая легендарный Hôtel du Cap-Eden-Roc.
      </p>
      <ul class="fade-in-section">
        <li>Трансферы из аэропорта Ниццы (20-30 мин)</li>
        <li>Сервис Порт Вобан и экипажи яхт</li>
        <li>Доступ к отелям Кап д'Антиб</li>
        <li>Специальный сервис Jazz à Juan (июль)</li>
      </ul>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Тарифы на Трансферы в Антиб</h2>
      <div class="cta-box">
        <a href="/ru/kontakt" class="btn-primary">Запросить цену</a>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Откройте Антиб</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/fun-buzz/681263469_10241088269927762_2493126442291772736_n.jpg"
          alt="Порт Вобан Антиб"
          title="Порт Вобан"
          description="Крупнейший порт Европы для суперяхт."
          link="/ru/kontakt"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-saint-tropez.webp"
          alt="Кап д'Антиб"
          title="Кап д'Антиб"
          description="Эксклюзивный полуостров с виллами миллиардеров."
          link="/ru/kontakt"
        />
        <CategoryCard
          image="/assets/img/fun-buzz/OIPhh.jpg"
          alt="Музей Пикассо Антиб"
          title="Музей Пикассо"
          description="Замок Гримальди с коллекцией Пикассо."
          link="/ru/kontakt"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Ближайшие Направления</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/ru/transfer-nizza" class="text-dark hover-gold">Трансфер Ницца</a>
        <a href="/ru/transfer-cannes" class="text-dark hover-gold">Трансфер Канны</a>
        <a href="/ru/transfer-monaco" class="text-dark hover-gold">Трансфер Монако</a>
        <a href="/ru" class="text-dark hover-gold">Все Направления</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .cta-box { text-align: center; padding: 2rem; background: #f9f9f9; border-radius: 12px; }
  .btn-primary {
    display: inline-block;
    background: #00b0f0;
    color: #000;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
  }
</style>
