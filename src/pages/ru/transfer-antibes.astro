---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

import PricingRequest from '../../components/PricingRequest.astro';
const title = "Трансфер Антиб – Личный Водитель Порт Вобан & Кап | ECOFUNDRIVE";
const description = "Премиум трансфер в Антиб и Жуан-ле-Пен. Порт Вобан, Кап д'Антиб, Jazz à Juan, Музей Пикассо. Трансферы из Ниццы.";
const keywords = [
  'трансфер Антиб',
  'личный водитель Антиб',
  'VTC Жуан-ле-Пен',
  'трансфер Порт Вобан',
  'водитель Кап д Антиб'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="ru-transfer-antibes"
  canonical="/ru/transfer-antibes"
  lang="ru"
  breadcrumbItems={[
    { name: "Главная", url: "/ru" },
    { name: "Трансфер Антиб", url: "/ru/transfer-antibes" }
  ]}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    <SectionImageText
      title="Ваш Личный Водитель в Антибе"
      image="/assets/img/destinations/destination-nice.png"
      alt="Трансфер личный водитель Антиб Порт Вобан"
      imageSide="right"
      ctaText="Забронировать Трансфер"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Антиб</strong> — очаровательный прибрежный город с богатым историческим наследием, восходящим к древнегреческим временам. Сегодня он знаменит <strong>Портом Вобан</strong>, крупнейшим портом для суперяхт в Европе, очаровательным <strong>Старым городом</strong> и <strong>Музеем Пикассо</strong>.
      </p>
      <p class="fade-in-section">
        Его полуостров-близнец <strong>Кап д'Антиб</strong> является домом для красивейших вилл и самых эксклюзивных отелей Ривьеры, включая легендарный Hôtel du Cap-Eden-Roc.
      </p>
      <ul class="fade-in-section">
        <li>Трансферы из аэропорта Ниццы (20-30 мин)</li>
        <li>Сервис Порт Вобан и экипажи яхт</li>
        <li>Доступ к отелям Кап д'Антиб</li>
        <li>Трансферы София Антиполис (15 мин)</li>
        <li>Специальный сервис Jazz à Juan (июль)</li>
        <li>Музей Пикассо и Старый город</li>
      </ul>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Тарифы на Трансферы в Антиб</h2>
      <PricingRequest />
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Откройте Антиб</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Порт Вобан Антиб"
          title="Порт Вобан"
          description="Крупнейший порт Европы для суперяхт. Уникальная атмосфера среди самых престижных судов мира."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-saint-tropez.webp"
          alt="Кап д'Антиб"
          title="Кап д'Антиб"
          description="Эксклюзивный полуостров с виллами миллиардеров. Hôtel du Cap-Eden-Roc, скрытые бухты, прибрежная тропа."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/about/vehicule-premium.webp"
          alt="Музей Пикассо Антиб"
          title="Старый Город & Музей Пикассо"
          description="Провансальский рынок, бастионы, очаровательные переулки. Замок Гримальди хранит Музей Пикассо."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Ближайшие Направления</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/ru/transfer-nizza" class="text-dark hover-gold">Трансфер Ницца</a>
        <a href="/ru/transfer-cannes" class="text-dark hover-gold">Трансфер Канны</a>
        <a href="/ru/transfer-monaco" class="text-dark hover-gold">Трансфер Монако</a>
        <a href="/ru" class="text-dark hover-gold">Все Направления</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
