---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const title = "Трансфер Лазурный берег – Личный Водитель Ницца Монако | ECOFUNDRIVE";
const description = "Премиум трансфер на Лазурном Берегу. Аэропорт Ниццы, Монако, Канны, Сен-Тропе. Русскоговорящий водитель 24/7. Люксовые автомобили.";
const keywords = [
  'трансфер Лазурный берег',
  'личный водитель Ницца',
  'трансфер аэропорт Ниццы',
  'VTC Монако',
  'русский водитель Ницца',
  'трансфер Канны'
];

const servicesRU = [
  { icon: "✈️", title: "Трансфер из аэропорта", desc: "Персональная встреча в аэропорту Ниццы с табличкой. Отслеживание рейсов включено." },
  { icon: "🏨", title: "Трансфер в отели", desc: "Сервис от двери до двери для всех ID Buzzовых отелей Лазурного Берега." },
  { icon: "⏰", title: "Почасовая аренда", desc: "Ваш личный водитель на полдня или целый день. Идеально для экскурсий и шопинга." },
  { icon: "💼", title: "Бизнес-поездки", desc: "Корпоративные перевозки, деловые встречи, конгрессы и мероприятия." },
  { icon: "💒", title: "Свадьбы", desc: "Элегантный сервис для вашего особенного дня. Украшенные автомобили по запросу." },
  { icon: "🗺️", title: "Панорамные туры", desc: "Откройте Ривьеру: Ницца, Эз, Монако, горные деревни, виноградники." }
];

const tarifeRU = [
  { ot: "Аэропорт Ниццы", do: "Центр Ниццы", vremya: "15-20 мин", cena: "Цена по запросу" },
  { ot: "Аэропорт Ниццы", do: "Монако", vremya: "30-45 мин", cena: "Цена по запросу" },
  { ot: "Аэропорт Ниццы", do: "Канны", vremya: "35-45 мин", cena: "Цена по запросу" },
  { ot: "Аэропорт Ниццы", do: "Сен-Тропе", vremya: "1ч30-2ч", cena: "Цена по запросу" },
  { ot: "Ницца", do: "Эз + Монако (тур)", vremya: "4ч", cena: "Цена по запросу" },
  { ot: "Канны", do: "Монако", vremya: "55-70 мин", cena: "Цена по запросу" }
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="ru-index"
  canonical="/ru"
  lang="ru"
  breadcrumbItems={[
    { name: "Главная", url: "/ru" }
  ]}
  schema={{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Как забронировать личного водителя?","acceptedAnswer":{"@type":"Answer","text":"Вы можете забронировать онлайн через нашу форму бронирования, через WhatsApp по номеру +33 6 16 55 28 11 или позвонив нам напрямую. Мы подтверждаем все бронирования в течение 1 часа."}},{"@type":"Question","name":"Ваши водители говорят по-русски?","acceptedAnswer":{"@type":"Answer","text":"Да, у нас есть русскоговорящие водители. По запросу мы можем предоставить водителя, владеющего русским языком."}},{"@type":"Question","name":"Предоставляете ли вы детские кресла?","acceptedAnswer":{"@type":"Answer","text":"Конечно. Мы предоставляем автокресла для младенцев, детей и бустеры бесплатно. Просто укажите возраст детей при бронировании."}}]}}
>
  <main id="main-content">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-content">
        <h1 class="hero-title">Ваш Личный Водитель на Лазурном Берегу</h1>
        <p class="hero-subtitle">Трансферы из аэропорта, панорамные туры и ID Buzzовые перевозки. Ницца • Канны • Монако • Сен-Тропе</p>
        <div class="hero-cta">
          <a href="/ru/kontakt" class="btn btn-gold">Забронировать Трансфер</a>
          <a href="tel:+33616552811" class="btn btn-outline">Позвонить +33 6 16 55 28 11</a>
        </div>
      </div>
    </section>

    <!-- Services Grid -->
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Наши Премиум Услуги</h2>
      <p class="text-center mb-xl lead">Ощутите роскошь перемещения по Лазурному Берегу с ECOFUNDRIVE</p>
      <div class="services-grid">
        {servicesRU.map((service) => (
          <div class="service-card">
            <span class="service-icon">{service.icon}</span>
            <h3>{service.title}</h3>
            <p>{service.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Popular Routes -->
    <section class="container py-xl bg-light rounded-lg fade-in-section">
      <h2 class="text-center mb-lg">Популярные Маршруты и Цены</h2>
      <table class="tarif-table">
        <thead>
          <tr><th>Откуда</th><th>Куда</th><th>Время</th><th>Цена от</th></tr>
        </thead>
        <tbody>
          {tarifeRU.map((route) => (
            <tr>
              <td>{route.ot}</td>
              <td>{route.do}</td>
              <td>{route.vremya}</td>
              <td class="price-cell">{route.cena}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="text-center mt-md"><em>Фиксированные цены без скрытых платежей. Персональная встреча включена.</em></p>
    </section>

    <!-- Destinations -->
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Исследуйте Лазурный Берег</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/destination-nice.webp"
          alt="Трансфер Ницца"
          title="Ницца"
          description="Столица Лазурного Берега. Старый город, Английская набережная, Замковый холм."
          link="/ru/transfer-nizza"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.webp"
          alt="Трансфер Монако"
          title="Монако"
          description="Гламур княжества. Казино Монте-Карло, Гран-При, порт Эркюль."
          link="/ru/transfer-monaco"
        />
        <CategoryCard
          image="/assets/img/destinations/cannes-palais-festivals.webp"
          alt="Трансфер Канны"
          title="Канны"
          description="Родина знаменитого кинофестиваля. Круазет, Дворец Фестивалей, бутики."
          link="/ru/transfer-cannes"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-saint-tropez.webp"
          alt="Трансфер Сен-Тропе"
          title="Сен-Тропе"
          description="Легендарный курорт. Пляж Пампелон, Club 55, очаровательный старый порт."
          link="/ru/transfer-saint-tropez"
        />
        <CategoryCard
          image="/assets/img/fun-buzz/681263469_10241088269927762_2493126442291772736_n.jpg"
          alt="Тур в Эз"
          title="Эз и Парфюмерии"
          description="Средневековая деревня с потрясающими видами. Фабрика духов Фрагонар."
          link="/vtc-eze"
        />
        <CategoryCard
          image="/assets/img/fun-buzz/OIPhh.jpg"
          alt="Трансфер Антиб"
          title="Антиб и Кап д'Антиб"
          description="Очаровательный старый город, суперяхты в Порт Вобан, Музей Пикассо."
          link="/ru/transfer-antibes"
        />
      </div>
    </section>

    <!-- Why Choose Us -->
    <SectionImageText
      title="Почему Выбирают ECOFUNDRIVE?"
      image="/assets/img/fun-buzz/OIPblack.jpg"
      alt="Профессиональный водитель Лазурный Берег"
      imageSide="right"
      ctaText="Забронировать"
      ctaLink="/ru/kontakt"
    >
      <ul class="benefits-list fade-in-section">
        <li><strong>Фиксированные цены</strong> – Знайте стоимость заранее, без сюрпризов</li>
        <li><strong>Премиум автомобили</strong> – Van VW ID Buzz 7 places, Van VW ID Buzz S-Class, просторные минивэны</li>
        <li><strong>Профессиональные водители</strong> – Обученные, владеющие русским языком</li>
        <li><strong>Персональная встреча</strong> – С табличкой с вашим именем при прибытии</li>
        <li><strong>Отслеживание рейсов</strong> – Корректируем время встречи при задержке рейса</li>
        <li><strong>Доступны 24/7</strong> – Ранние рейсы, ночные возвращения – мы всегда на связи</li>
        <li><strong>Бесплатная отмена</strong> – До 24 часов до поездки с полным возвратом</li>
      </ul>
    </SectionImageText>

    <!-- CTA Section -->
    <section class="cta-section fade-in-section">
      <div class="container text-center">
        <h2>Готовы Путешествовать с Комфортом?</h2>
        <p class="lead mb-lg">Закажите личного водителя и путешествуйте по Лазурному Берегу со стилем</p>
        <div class="cta-buttons">
          <a href="/ru/kontakt" class="btn btn-gold btn-lg">Забронировать Онлайн</a>
          <a href="https://wa.me/33616552811" class="btn btn-whatsapp btn-lg">Написать в WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Часто Задаваемые Вопросы</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-question">Как забронировать личного водителя?</h3>
          <div class="faq-answer">
            <p>Вы можете забронировать онлайн через нашу <a href="/ru/kontakt">форму бронирования</a>, через WhatsApp по номеру +33 6 16 55 28 11 или позвонив нам напрямую. Мы подтверждаем все бронирования в течение 1 часа.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Ваши водители говорят по-русски?</h3>
          <div class="faq-answer">
            <p>Да, у нас есть русскоговорящие водители. По запросу мы можем предоставить водителя, владеющего русским языком.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Предоставляете ли вы детские кресла?</h3>
          <div class="faq-answer">
            <p>Конечно. Мы предоставляем автокресла для младенцев, детей и бустеры бесплатно. Просто укажите возраст детей при бронировании.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero-section {
    background: linear-gradient(135deg, rgba(0,0,0,0.7), rgba(0,0,0,0.5)), url('/assets/img/fun-buzz/OIPhh.jpg');
    background-size: cover;
    background-position: center;
    padding: 8rem 2rem;
    text-align: center;
    color: white;
  }
  .hero-title { font-size: 2.5rem; margin-bottom: 1rem; text-shadow: 2px 2px 4px rgba(0,0,0,0.5); }
  .hero-subtitle { font-size: 1.25rem; margin-bottom: 2rem; opacity: 0.9; }
  .hero-cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .btn { padding: 1rem 2rem; border-radius: 50px; text-decoration: none; font-weight: 600; transition: all 0.3s ease; }
  .btn-gold { background: #00b0f0; color: #000; }
  .btn-gold:hover { background: #006b8c; transform: translateY(-2px); }
  .btn-outline { border: 2px solid white; color: white; }
  .btn-outline:hover { background: white; color: #000; }
  .btn-whatsapp { background: #25D366; color: white; }
  .btn-lg { padding: 1.25rem 2.5rem; font-size: 1.1rem; }
  .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
  .service-card { background: #f9f9f9; padding: 2rem; border-radius: 12px; text-align: center; transition: transform 0.3s ease; }
  .service-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
  .service-icon { font-size: 2.5rem; display: block; margin-bottom: 1rem; }
  .service-card h3 { margin-bottom: 0.5rem; color: #00b0f0; }
  
  .price-cell { font-weight: 700; color: #00b0f0; }
  .bg-light { background: #f9f9f9; padding: 2rem; }
  .benefits-list { list-style: none; padding: 0; }
  .benefits-list li { padding: 0.75rem 0; border-bottom: 1px solid #eee; }
  .cta-section { background: linear-gradient(135deg, #00b0f0, #006b8c); padding: 4rem 2rem; color: #000; }
  .cta-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .cta-section .btn-gold { background: #000; color: #00b0f0; }
</style>
