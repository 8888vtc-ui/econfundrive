---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "Guides & Conseils Voyage | ECOFUNDRIVE – Côte d'Azur";
const description = "Préparez votre séjour sur la Côte d'Azur avec nos guides experts. Itinéraires, conseils pratiques, événements et astuces pour découvrir la French Riviera autrement.";
const keywords = [
  'guide voyage Côte d\'Azur',
  'que faire Nice Cannes Monaco',
  'itinéraire French Riviera',
  'conseils transport Côte d\'Azur',
  'événements Côte d\'Azur'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="guides"
  canonical="/guides"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Guides", url: "/guides" }
  ]}
>
  <PageHero 
    title="Guides & Conseils Voyage"
    subtitle="Votre compagnon de voyage sur la Côte d'Azur. Itinéraires, bonnes adresses et astuces d'initiés pour un séjour inoubliable."
    backgroundImage="/assets/img/guides/villages-perches.webp"
    badge="EXPERTISE LOCALE • CONSEILS GRATUITS"
  />

  <main id="main-content" class="page-content">
    
    <!-- INTRO -->
    <SectionImageText
      title="Explorez la Côte d'Azur avec ECOFUNDRIVE"
      image="/assets/img/hero/hero-home.webp"
      alt="Vue panoramique Côte d'Azur"
      imageSide="right"
      ctaText="Réserver une excursion"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        Au-delà du simple transport, nous souhaitons partager avec vous notre <strong>passion pour notre région</strong>. Nos chauffeurs sont de véritables guides locaux qui connaissent chaque recoin de la Riviera.
      </p>
      <p class="fade-in-section">
        Que vous cherchiez les meilleures adresses, des idées d'excursions ou des conseils pour optimiser vos déplacements, nos guides sont là pour vous inspirer. Nice, Cannes, Monaco, Saint-Tropez et les trésors cachés de l'arrière-pays n'auront plus de secrets pour vous.
      </p>
    </SectionImageText>

    <!-- GUIDES PAR DESTINATION -->
    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Guides par Destination</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/nice-vieux-nice.webp"
          alt="Guide Nice"
          title="Que faire à Nice ?"
          description="Itinéraire pour visiter Nice en 1 à 3 jours : Vieux-Nice, Promenade des Anglais, Colline du Château, marchés et musées."
          link="/guide-que-faire-a-nice-1-3-jours"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-cannes.webp"
          alt="Guide Cannes"
          title="Visiter Cannes"
          description="Les incontournables de Cannes : la Croisette, le Suquet, les îles de Lérins. Guide complet pour un séjour réussi."
          link="/guide-que-faire-a-cannes"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.webp"
          alt="Guide Monaco"
          title="Monaco en 1 jour"
          description="Le guide complet pour une journée parfaite à Monaco : Palais, Casino de Monte-Carlo, Musée Océanographique."
          link="/guide-monaco-en-une-journee"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-saint-tropez.webp"
          alt="Guide Saint-Tropez"
          title="Découvrir Saint-Tropez"
          description="Plages mythiques, port animé, citadelle. Tout ce qu'il faut savoir pour profiter de Saint-Tropez et son golfe."
          link="/guide-decouvrir-saint-tropez-golfe"
        />
        <CategoryCard
          image="/assets/img/guides/villages-perches.webp"
          alt="Villages perchés"
          title="Villages Perchés"
          description="Èze, Saint-Paul-de-Vence, Gourdon, Tourrettes-sur-Loup... Explorez les joyaux médiévaux de l'arrière-pays."
          link="/guide-villages-perches-cote-azur"
        />
        <CategoryCard
          image="/assets/img/services/service-aeroport.webp"
          alt="Circuit Nice Eze Monaco"
          title="Circuit Nice - Èze - Monaco"
          description="Notre excursion la plus populaire ! La Moyenne Corniche, le village d'Èze, les parfumeries, puis Monaco."
          link="/guide-route-panoramique-nice-eze-monaco"
        />
      </div>
    </section>

    <!-- ÉVÉNEMENTS -->
    <section class="events-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Événements & Lifestyle</h2>
        <div class="grid-3-cols">
          <CategoryCard
            image="/assets/img/destinations/cannes-palais-festivals.webp"
            alt="Festival de Cannes"
            title="🎬 Festival de Cannes"
            description="Guide pratique pour vos déplacements pendant le Festival de Cannes. Navigation, hébergement, conseils VIP."
            link="/guide-vtc-festival-cannes"
          />
          <CategoryCard
            image="/assets/img/guides/grand-prix-monaco.webp"
            alt="Grand Prix de Monaco"
            title="🏎️ Grand Prix F1"
            description="Comment se déplacer et où se loger pendant le Grand Prix de Monaco. Réservez tôt, c'est complet !"
            link="/guide-grand-prix-monaco-deplacements"
          />
          <CategoryCard
            image="/assets/img/services/service-evenements.webp"
            alt="Événements Côte d'Azur"
            title="📅 Agenda 2026"
            description="Les grands événements à ne pas manquer sur la Côte d'Azur : festivals, salons, concerts, régates."
            link="/guide-evenements-cote-azur"
          />
        </div>
      </div>
    </section>

    <!-- CONSEILS PRATIQUES -->
    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Conseils Pratiques VTC</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/services/service-aeroport.webp"
          alt="VTC ou Taxi"
          title="VTC ou Taxi à Nice ?"
          description="Comparatif objectif pour choisir le meilleur mode de transport à l'aéroport de Nice. Prix, confort, fiabilité."
          link="/guide-vtc-ou-taxi-aeroport-nice"
        />
        <CategoryCard
          image="/assets/img/about/chauffeur-professionnel.webp"
          alt="Choisir son VTC"
          title="Bien choisir son VTC"
          description="Les critères pour sélectionner un chauffeur privé de confiance : licence, avis, véhicule, réactivité."
          link="/guide-choisir-vtc-cote-azur"
        />
        <CategoryCard
          image="/assets/img/hero/hero-business.webp"
          alt="Budget Transport"
          title="Budget Transport"
          description="Estimez le coût de vos déplacements sur la Côte d'Azur. Comparatif VTC, taxi, bus, TER, location."
          link="/guide-budget-transport-cote-azur"
        />
      </div>
    </section>

    <!-- FAMILY -->
    <section class="container py-xl fade-in-section">
      <div class="family-section">
        <div class="family-content">
          <h2>🧒 Voyager en Famille ?</h2>
          <p>Découvrez notre guide spécial famille avec les meilleures activités pour les enfants : Marineland, Musée Océanographique, plages surveillées, et nos conseils pour voyager sereinement avec poussettes et sièges auto.</p>
          <a href="/guide-journee-famille-cote-d-azur" class="btn-gold">Guide Famille →</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Besoin d'un Conseil Personnalisé ?</h2>
        <p>Notre équipe est disponible 24/7 pour répondre à vos questions et vous aider à planifier votre séjour idéal sur la Côte d'Azur.</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn-gold">Nous Contacter</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .section-title {
    font-size: 2rem;
    color: #1a1a1a;
    position: relative;
  }
  
  .section-title::after {
    content: '';
    display: block;
    width: 60px;
    height: 3px;
    background: #d4af37;
    margin: 1rem auto 0;
  }
  
  .events-section {
    background: linear-gradient(135deg, #0a0c17 0%, #1a1a2e 100%);
    margin: 3rem 0;
  }
  
  .family-section {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(212, 175, 55, 0.05) 100%);
    border-radius: 20px;
    padding: 3rem;
    border-left: 4px solid #d4af37;
  }
  
  .family-content h2 {
    margin-bottom: 1rem;
    color: #1a1a1a;
  }
  
  .family-content p {
    color: #555;
    margin-bottom: 1.5rem;
    max-width: 600px;
  }
  
  .cta-premium {
    background: linear-gradient(135deg, #0a0c17 0%, #1a1a2e 100%);
    border-radius: 20px;
    padding: 4rem 2rem;
    text-align: center;
    color: white;
    position: relative;
    overflow: hidden;
  }
  
  .cta-premium::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, #d4af37, transparent);
  }
  
  .cta-premium h2 {
    color: white;
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  
  .cta-premium p {
    color: #aaa;
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto 2rem;
  }
  
  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .btn-gold {
    background: linear-gradient(135deg, #d4af37, #f0d78c);
    color: #000;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s;
    display: inline-block;
  }
  
  .btn-gold:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
  }
  
  .btn-outline {
    border: 2px solid #d4af37;
    color: #d4af37;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
  }
  
  .btn-outline:hover {
    background: #d4af37;
    color: #000;
  }
</style>
