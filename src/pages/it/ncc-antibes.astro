---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const title = "NCC Antibes – Autista Privato Porto Vauban & Cap | ECOFUNDRIVE";
const description = "Servizio NCC premium ad Antibes e Juan-les-Pins. Porto Vauban, Cap d'Antibes, Jazz à Juan, Musée Picasso. Trasferimenti da Nizza.";
const keywords = [
  'NCC Antibes',
  'autista privato Antibes',
  'NCC Juan-les-Pins',
  'trasferimento Porto Vauban',
  'autista Cap d Antibes'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="it-ncc-antibes"
  canonical="/it/ncc-antibes"
  lang="it"
  breadcrumbItems={[
    { name: "Home", url: "/it" },
    { name: "NCC Antibes", url: "/it/ncc-antibes" }
  ]}
  schema={{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Quanto tempo ci vuole dall'aeroporto di Nizza ad Antibes?","acceptedAnswer":{"@type":"Answer","text":"Il trasferimento dall'aeroporto di Nizza ad Antibes dura circa 20-30 minuti (circa 20 km). Antibes si trova tra Nizza e Cannes."}},{"@type":"Question","name":"Offrite servizio per Porto Vauban?","acceptedAnswer":{"@type":"Answer","text":"Sì, lavoriamo regolarmente con gli equipaggi di yacht e visitatori di Porto Vauban, il più grande porto per superyacht d'Europa."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tariffe e Preventivi</h2>
      <div class="cta-box">
        <a href="/it/contatto" class="btn-primary">Richiedi un preventivo</a>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Scoprite Antibes</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/destination-nice.webp"
          alt="Porto Vauban Antibes"
          title="Porto Vauban"
          description="Il più grande porto d'Europa per superyacht. Atmosfera unica tra le navi più prestigiose del mondo."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/fun-buzz/espace.jpg"
          alt="Cap d'Antibes"
          title="Cap d'Antibes"
          description="Penisola esclusiva con ville miliardarie. Hôtel du Cap-Eden-Roc, calette nascoste, sentiero litoraneo."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/fun-buzz/OIPblan.jpg"
          alt="Musée Picasso Antibes"
          title="Città Vecchia & Museo Picasso"
          description="Mercato provenzale, bastioni, vicoli affascinanti. Il castello Grimaldi ospita il Museo Picasso."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinazioni Vicine</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/it/ncc-nizza" class="text-dark hover-gold">NCC Nizza</a>
        <a href="/it/ncc-cannes" class="text-dark hover-gold">NCC Cannes</a>
        <a href="/it/ncc-monaco" class="text-dark hover-gold">NCC Monaco</a>
        <a href="/it" class="text-dark hover-gold">Tutte le Destinazioni</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
</style>
