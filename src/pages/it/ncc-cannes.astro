---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

import PricingRequest from '../../components/PricingRequest.astro';
const title = "NCC Cannes – Autista Privato Festival & Croisette | ECOFUNDRIVE";
const description = "Servizio NCC premium a Cannes. Festival del Cinema, MIPIM, La Croisette, Palais des Festivals. Autista privato italiano 24/7. Trasferimenti da Nizza.";
const keywords = [
  'NCC Cannes',
  'autista privato Cannes',
  'Festival Cannes trasferimento',
  'NCC Croisette',
  'autista MIPIM Cannes'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="it-cannes"
  canonical="/it/ncc-cannes"
  lang="it"
  breadcrumbItems={[
    { name: "Home", url: "/it" },
    { name: "NCC Cannes", url: "/it/ncc-cannes" }
  ]}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tarifs & Devis</h2>
      <PricingRequest lang="it" />
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Grandi Eventi a Cannes</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/cannes-palais-festivals.png"
          alt="Festival Cinema Cannes"
          title="Festival del Cinema"
          description="Il festival cinematografico più prestigioso al mondo. Trasferimenti red carpet, after-party, eventi yacht."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="MIPIM Cannes"
          title="MIPIM Immobiliare"
          description="La principale conferenza immobiliare mondiale. Trasferimenti aeroporto, incontri clienti, networking."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-saint-tropez.webp"
          alt="Cannes Lions"
          title="Cannes Lions"
          description="Festival globale della creatività pubblicitaria. Trasporto executive, feste, transfer hotel."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Domande Frequenti</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-question">Quanto tempo dura il trasferimento dall'aeroporto di Nizza a Cannes?</h3>
          <div class="faq-answer">
            <p>Il trasferimento dall'aeroporto di Nizza a Cannes dura circa <strong>35-45 minuti</strong> a seconda del traffico (circa 35 km via autostrada A8).</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Offrite servizio durante il Festival del Cinema di Cannes?</h3>
          <div class="faq-answer">
            <p>Sì, offriamo servizio NCC premium durante il Festival del Cinema di Cannes (di solito a metà maggio). Consigliamo di prenotare <strong>2-3 mesi in anticipo</strong> per l'altissima domanda.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">I vostri autisti parlano italiano?</h3>
          <div class="faq-answer">
            <p>Sì, abbiamo autisti che parlano italiano fluentemente. Su richiesta, possiamo assicurarvi un autista che parla la vostra lingua.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinazioni Vicine</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/it" class="text-dark hover-gold">NCC Nizza</a>
        <a href="/it/ncc-monaco" class="text-dark hover-gold">NCC Monaco</a>
        <a href="/it/ncc-saint-tropez" class="text-dark hover-gold">NCC Saint-Tropez</a>
        <a href="/vtc-antibes" class="text-dark hover-gold">NCC Antibes</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
