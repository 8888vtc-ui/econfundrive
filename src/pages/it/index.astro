---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const title = "NCC Costa Azzurra – Autista Privato Nizza Monaco Cannes | ECOFUNDRIVE";
const description = "Servizio NCC premium in Costa Azzurra. Trasferimenti aeroporto Nizza, Monaco, Cannes, Saint-Tropez. Autista privato italiano 24/7. Veicoli di lusso.";
const keywords = [
  'NCC Costa Azzurra',
  'autista privato Nizza',
  'trasferimento aeroporto Nizza',
  'NCC Monaco',
  'autista italiano Costa Azzurra',
  'noleggio con conducente Cannes'
];

const servicesIT = [
  { icon: "✈️", title: "Trasferimenti Aeroporto", desc: "Accoglienza personalizzata all'aeroporto di Nizza con cartello nominativo. Monitoraggio voli incluso." },
  { icon: "🏨", title: "Trasferimenti Hotel", desc: "Servizio porta a porta per tutti gli hotel di lusso della Costa Azzurra." },
  { icon: "⏰", title: "A Disposizione", desc: "Il vostro autista privato per mezza giornata o giornata intera. Ideale per visite e shopping." },
  { icon: "💼", title: "Business Travel", desc: "Trasporti aziendali, riunioni d'affari, congressi ed eventi." },
  { icon: "💒", title: "Matrimoni", desc: "Servizio elegante per il vostro giorno speciale. Veicoli decorati su richiesta." },
  { icon: "🗺️", title: "Tour Panoramici", desc: "Scoprite la Riviera: Nizza, Eze, Monaco, villaggi arroccati, cantine." }
];

const tarifeIT = [
  { da: "Aeroporto Nizza", a: "Nizza Centro", durata: "15-20 min", prezzo: "Prezzo su richiesta" },
  { da: "Aeroporto Nizza", a: "Monaco", durata: "30-45 min", prezzo: "Prezzo su richiesta" },
  { da: "Aeroporto Nizza", a: "Cannes", durata: "35-45 min", prezzo: "Prezzo su richiesta" },
  { da: "Aeroporto Nizza", a: "Saint-Tropez", durata: "1h30-2h", prezzo: "Prezzo su richiesta" },
  { da: "Nizza", a: "Eze + Monaco (tour)", durata: "4h", prezzo: "Prezzo su richiesta" },
  { da: "Cannes", a: "Monaco", durata: "55-70 min", prezzo: "Prezzo su richiesta" }
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="it-index"
  canonical="/it"
  lang="it"
  breadcrumbItems={[
    { name: "Home", url: "/it" }
  ]}
  schema={{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Come prenoto un autista privato?","acceptedAnswer":{"@type":"Answer","text":"Potete prenotare online tramite il nostro modulo di prenotazione, via WhatsApp al +33 6 16 55 28 11, o chiamandoci direttamente. Confermiamo tutte le prenotazioni entro 1 ora."}},{"@type":"Question","name":"I vostri autisti parlano italiano?","acceptedAnswer":{"@type":"Answer","text":"Sì, abbiamo autisti che parlano italiano fluentemente. Su richiesta, possiamo assicurare un autista che parla la vostra lingua."}},{"@type":"Question","name":"Fornite seggiolini per bambini?","acceptedAnswer":{"@type":"Answer","text":"Assolutamente. Forniamo seggiolini per neonati, bambini e rialzi gratuitamente. Basta indicare l'età dei bambini al momento della prenotazione."}},{"@type":"Question","name":"Qual è il costo di un trasferimento dall'aeroporto di Nizza?","acceptedAnswer":{"@type":"Answer","text":"Le tariffe dipendono dalla destinazione. Contattateci via WhatsApp o email per un preventivo immediato e senza impegno. I prezzi sono fissi e trasparenti."}}]}}
>
  <main id="main-content">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-content">
        <h1 class="hero-title">Il Vostro Autista Privato in Costa Azzurra</h1>
        <p class="hero-subtitle">Trasferimenti aeroporto, tour panoramici e trasporti di lusso. Nizza • Cannes • Monaco • Saint-Tropez</p>
        <div class="hero-cta">
          <a href="/it/contatto" class="btn btn-gold">Prenota il Trasferimento</a>
          <a href="tel:+33616552811" class="btn btn-outline">Chiama +33 6 16 55 28 11</a>
        </div>
      </div>
    </section>

    <!-- Services Grid -->
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">I Nostri Servizi NCC Premium</h2>
      <p class="text-center mb-xl lead">Scoprite il lusso del trasporto in Costa Azzurra con ECOFUNDRIVE</p>
      <div class="services-grid">
        {servicesIT.map((service) => (
          <div class="service-card">
            <span class="service-icon">{service.icon}</span>
            <h3>{service.title}</h3>
            <p>{service.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Popular Routes -->
    <section class="container py-xl bg-light rounded-lg fade-in-section">
      <h2 class="text-center mb-lg">Tratte Popolari e Tariffe</h2>
      <table class="tarif-table">
        <thead>
          <tr><th>Da</th><th>A</th><th>Durata</th><th>Prezzo da</th></tr>
        </thead>
        <tbody>
          {tarifeIT.map((route) => (
            <tr>
              <td>{route.da}</td>
              <td>{route.a}</td>
              <td>{route.durata}</td>
              <td class="price-cell">{route.prezzo}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="text-center mt-md"><em>Prezzi fissi senza costi nascosti. Servizio di accoglienza incluso.</em></p>
    </section>

    <!-- Destinations -->
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Esplorate la Costa Azzurra</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/destination-nice.webp"
          alt="NCC Nizza"
          title="Nizza"
          description="Capitale della Costa Azzurra. Città Vecchia, Promenade des Anglais, Collina del Castello."
          link="/it/ncc-nizza"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.webp"
          alt="NCC Monaco"
          title="Monaco"
          description="Il glamour della Principauté. Casino di Monte-Carlo, Gran Premio, Port Hercule."
          link="/it/ncc-monaco"
        />
        <CategoryCard
          image="/assets/img/destinations/cannes-palais-festivals.webp"
          alt="NCC Cannes"
          title="Cannes"
          description="Sede del famoso Festival del Cinema. La Croisette, Palais des Festivals, boutique di lusso."
          link="/it/ncc-cannes"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-saint-tropez.webp"
          alt="NCC Saint-Tropez"
          title="Saint-Tropez"
          description="Destinazione jet-set leggendaria. Spiaggia di Pampelonne, Club 55, porto incantevole."
          link="/it/ncc-saint-tropez"
        />
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Tour Eze"
          title="Eze e Profumerie"
          description="Villaggio medievale arroccato con vista mozzafiato. Fabbrica di profumi Fragonard."
          link="/vtc-eze"
        />
        <CategoryCard
          image="/assets/img/about/vehicule-premium.webp"
          alt="NCC Antibes"
          title="Antibes e Cap d'Antibes"
          description="Città vecchia incantevole, superyacht a Port Vauban, Museo Picasso."
          link="/it/ncc-antibes"
        />
      </div>
    </section>

    <!-- Why Choose Us -->
    <SectionImageText
      title="Perché Scegliere ECOFUNDRIVE?"
      image="/assets/img/about/chauffeur-professionnel.webp"
      alt="Autista professionale Costa Azzurra"
      imageSide="right"
      ctaText="Prenota Ora"
      ctaLink="/it/contatto"
    >
      <ul class="benefits-list fade-in-section">
        <li><strong>Prezzi Fissi</strong> – Conoscete la tariffa in anticipo, nessuna sorpresa</li>
        <li><strong>Veicoli Premium</strong> – Tesla Model S, Mercedes Classe S, van spaziosi</li>
        <li><strong>Autisti Professionali</strong> – Formati, multilingue (IT/FR/EN), esperti locali</li>
        <li><strong>Accoglienza Personalizzata</strong> – Con cartello nominativo all'arrivo</li>
        <li><strong>Monitoraggio Voli</strong> – Adattiamo l'orario di pickup se necessario</li>
        <li><strong>Disponibili 24/7</strong> – Voli mattutini, rientri notturni, sempre presenti</li>
        <li><strong>Cancellazione Gratuita</strong> – Fino a 24 ore prima con rimborso completo</li>
      </ul>
    </SectionImageText>

    <!-- CTA Section -->
    <section class="cta-section fade-in-section">
      <div class="container text-center">
        <h2>Pronti a Viaggiare con Stile?</h2>
        <p class="lead mb-lg">Prenotate il vostro autista privato e viaggiate in Costa Azzurra con eleganza</p>
        <div class="cta-buttons">
          <a href="/it/contatto" class="btn btn-gold btn-lg">Prenota Online</a>
          <a href="https://wa.me/33616552811" class="btn btn-whatsapp btn-lg">Contattaci su WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Domande Frequenti</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-question">Come prenoto un autista privato?</h3>
          <div class="faq-answer">
            <p>Potete prenotare online tramite il nostro <a href="/it/contatto">modulo di prenotazione</a>, via WhatsApp al +33 6 16 55 28 11, o chiamandoci direttamente. Confermiamo tutte le prenotazioni entro 1 ora.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">I vostri autisti parlano italiano?</h3>
          <div class="faq-answer">
            <p>Sì, abbiamo autisti che parlano italiano fluentemente. Su richiesta, possiamo assicurare un autista che parla la vostra lingua.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Fornite seggiolini per bambini?</h3>
          <div class="faq-answer">
            <p>Assolutamente. Forniamo seggiolini per neonati, bambini e rialzi gratuitamente. Basta indicare l'età dei bambini al momento della prenotazione.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Qual è il costo di un trasferimento dall'aeroporto di Nizza?</h3>
          <div class="faq-answer">
            <p>Le tariffe dipendono dalla destinazione. Contattateci via WhatsApp o email per un preventivo immediato e senza impegno. I prezzi sono fissi e trasparenti.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero-section {
    background: linear-gradient(135deg, rgba(0,0,0,0.7), rgba(0,0,0,0.5)), url('/assets/img/hero/hero-aeroport-nice.png');
    background-size: cover;
    background-position: center;
    padding: 8rem 2rem;
    text-align: center;
    color: white;
  }
  .hero-title { font-size: 2.5rem; margin-bottom: 1rem; text-shadow: 2px 2px 4px rgba(0,0,0,0.5); }
  .hero-subtitle { font-size: 1.25rem; margin-bottom: 2rem; opacity: 0.9; }
  .hero-cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .btn { padding: 1rem 2rem; border-radius: 50px; text-decoration: none; font-weight: 600; transition: all 0.3s ease; }
  .btn-gold { background: #d4af37; color: #000; }
  .btn-gold:hover { background: #b8941f; transform: translateY(-2px); }
  .btn-outline { border: 2px solid white; color: white; }
  .btn-outline:hover { background: white; color: #000; }
  .btn-whatsapp { background: #25D366; color: white; }
  .btn-lg { padding: 1.25rem 2.5rem; font-size: 1.1rem; }
  .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
  .service-card { background: #f9f9f9; padding: 2rem; border-radius: 12px; text-align: center; transition: transform 0.3s ease; }
  .service-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
  .service-icon { font-size: 2.5rem; display: block; margin-bottom: 1rem; }
  .service-card h3 { margin-bottom: 0.5rem; color: #d4af37; }
  
  .price-cell { font-weight: 700; color: #d4af37; }
  .bg-light { background: #f9f9f9; padding: 2rem; }
  .benefits-list { list-style: none; padding: 0; }
  .benefits-list li { padding: 0.75rem 0; border-bottom: 1px solid #eee; }
  .cta-section { background: linear-gradient(135deg, #d4af37, #b8941f); padding: 4rem 2rem; color: #000; }
  .cta-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .cta-section .btn-gold { background: #000; color: #d4af37; }
</style>
