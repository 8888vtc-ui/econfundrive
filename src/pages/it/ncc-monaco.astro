---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionImageText from '../../components/SectionImageText.astro';
import CategoryCard from '../../components/CategoryCard.astro';

import PricingRequest from '../components/PricingRequest.astro';
const title = "NCC Monaco – Autista Privato Monte-Carlo Gran Premio | ECOFUNDRIVE";
const description = "Servizio NCC premium a Monaco. Casino Monte-Carlo, Gran Premio F1, Port Hercules, hotel 5 stelle. Autista privato italiano. Trasferimenti da Nizza.";
const keywords = [
  'NCC Monaco',
  'autista privato Monaco',
  'trasferimento Nizza Monaco',
  'NCC Gran Premio Monaco',
  'autista Monte-Carlo'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="it-monaco"
  canonical="/it/ncc-monaco"
  lang="it"
  breadcrumbItems={[
    { name: "Home", url: "/it" },
    { name: "NCC Monaco", url: "/it/ncc-monaco" }
  ]}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tarifs & Devis</h2>
      <PricingRequest />
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Scoprite Monaco con il Vostro Autista</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.png"
          alt="Casino Monte-Carlo"
          title="Casino di Monte-Carlo"
          description="L'iconico casino Belle Époque, simbolo del glamour di Monaco. Trasferimenti serali per serate al casino."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.png"
          alt="Gran Premio Monaco"
          title="Gran Premio Formula 1"
          description="Servizio NCC dedicato per la gara più prestigiosa del mondo. Prenotate mesi in anticipo."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.png"
          alt="Port Hercule Monaco"
          title="Port Hercule e Yacht"
          description="Trasferimenti verso superyacht e il famoso Monaco Yacht Show. Servizio banchina disponibile."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinazioni Vicine</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/it" class="text-dark hover-gold">NCC Nizza</a>
        <a href="/vtc-cannes" class="text-dark hover-gold">NCC Cannes</a>
        <a href="/vtc-eze" class="text-dark hover-gold">Tour Eze</a>
        <a href="/vtc-saint-tropez" class="text-dark hover-gold">Saint-Tropez</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
