---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import CategoryCard from '../components/CategoryCard.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import SectionImageText from '../components/SectionImageText.astro';

const title = "ECOFUNDRIVE – Chauffeur Privé VTC en Van VW ID Buzz (7 Places) Côte d'Azur";
const description = "Chauffeur privé VTC sur la Côte d'Azur. Découvrez notre Van VW ID Buzz Bleu 100% électrique (7 places). Idéal pour transferts aéroport, groupes & familles.";
const keywords = [
  'chauffeur privé VTC Van',
  'VTC ID Buzz Nice',
  'VTC 7 places Côte d\'Azur',
  'transfert aéroport Nice groupe',
  'Van électrique avec chauffeur',
  "chauffeur Côte d\'Azur",
  'VTC Saint-Tropez minibus',
  'transport premium 7 personnes',
  'VTC famille Nice',
  'mise à disposition chauffeur van',
  'transfert aéroport Cannes groupe',
  'VTC longue distance confort',
  'minibus événement',
  'VTC mariage van',
  "circuit touristique groupe Côte d\'Azur"
];
---

<BaseLayout title={title}
  description={description}
  currentPage="index"
  canonical="/"
  heroImage="/assets/img/fun-buzz/2025-Volkswagen-ID.-Buzz_Cabana_Blue-VW-Bus.webp"

  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien de passagers pouvez-vous transporter ?","acceptedAnswer":{"@type":"Answer","text":"Notre nouveau Van Volkswagen ID Buzz est conçu pour transporter confortablement jusqu'à 7 passagers avec leurs bagages, ce qui est idéal pour les familles ou les groupes d'amis."}},{"@type":"Question","name":"Vos véhicules sont-ils écologiques ?","acceptedAnswer":{"@type":"Answer","text":"Oui absolument, l'ID Buzz est un véhicule 100% électrique. Vous voyagez dans un van spacieux, silencieux et sans émissions de CO2."}},{"@type":"Question","name":"Puis-je demander un siège enfant ou bébé ?","acceptedAnswer":{"@type":"Answer","text":"Bien sûr, l'espace généreux de notre van ID Buzz permet d'installer facilement des sièges enfants et bébés sur simple demande préalable."}}]}}
>
  <HeroBanner
    image="/assets/img/fun-buzz/2025-Volkswagen-ID.-Buzz_Cabana_Blue-VW-Bus.webp"
    alt="Notre nouveau Van VW ID Buzz fun et coloré 7 places sur la Côte d'Azur"
    title="Votre Chauffeur Privé en Van ID Buzz sur la Côte d'Azur"
    subtitle="Voyagez en tribu ! Jusqu'à 7 places dans notre tout nouveau Volkswagen ID Buzz 100% électrique. Couleurs fun, espace, style et bonne humeur."
    ctaText="Réserver votre Van"
    ctaLink="/reservation"
  />

  <main id="main-content">
    <SectionImageText
      title="Découvrez Nos VW ID Buzz Fun et Sympas"
      image="/assets/img/fun-buzz/DB2022AU00771_web_1600.jpg"
      alt="Van Volkswagen ID Buzz de toutes les couleurs fun"
      imageSide="left"
      ctaText="Découvrir notre flotte"
      ctaLink="/a-propos"
    >
      <p class="lead fade-in-section">{description}</p>
      <p class="fade-in-section">
        ECOFUNDRIVE réinvente le transport sur la French Riviera avec sa flotte de <strong>Volkswagen ID Buzz de couleurs vives et funs</strong>. Véritable icône moderne, ce van 100% électrique allie un design néo-rétro irrésistible à un espace intérieur exceptionnel pouvant accueillir <strong>jusqu'à 7 passagers</strong> et leurs bagages.
      </p>
      <p class="fade-in-section">
        Fini les compromis entre l'espace, le style et l'écologie ! Que vous soyez une famille nombreuse arrivant à l'aéroport de Nice, un groupe d'amis en route pour une soirée à Monaco, ou des professionnels recherchant un transport prestigieux, décalé et différent, nos ID Buzz colorés vous feront vivre une expérience inoubliable, dans la bonne humeur et le silence royal de l'électrique.
      </p>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Nos Services Sur Mesure en Van</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/fun-buzz/OIPblan.jpg"
          alt="Transfert aéroport Nice en Van Fun"
          title="Transferts Aéroports pour Groupes"
          description="L'espace bagages généreux de l'ID Buzz est parfait pour accueillir les valises de toute la famille à votre arrivée à l'Aéroport de Nice ou Cannes."
          link="/services#transferts"
        />
        <CategoryCard
          image="/assets/img/fun-buzz/OIPblack.jpg"
          alt="Chauffeur VTC Business Van ID Buzz noir"
          title="Séminaires & Business"
          description="Transportez vos équipes ensemble (jusqu'à 7 collaborateurs) pour vos congrès, salons professionnels ou team-buildings sur la Côte d'Azur."
          link="/services#business"
        />
        <CategoryCard
          image="/assets/img/fun-buzz/OIPhh.jpg"
          alt="Mise à disposition chauffeur privé Van coloré"
          title="Mise à Disposition"
          description="Votre chauffeur et son van à disposition pour la journée : virée shopping, tournois de golf ou événements sportifs entre amis."
          link="/services#disposition"
        />
        <CategoryCard
          image="/assets/img/fun-buzz/OIP.jpg"
          alt="VTC événements mariages navette fun"
          title="Mariages & Événements"
          description="Une navette chic, originale et silencieuse pour transporter vos invités lors de vos événements privés ou du Festival de Cannes."
          link="/services#evenements"
        />
        <CategoryCard
          image="/assets/img/fun-buzz/681263469_10241088269927762_2493126442291772736_n.jpg"
          alt="Circuit touristique Saint-Tropez en famille"
          title="Circuits Touristiques en Famille"
          description="Profitez de la vue panoramique du van pour explorer l'arrière-pays niçois, Saint-Tropez ou Monaco tous ensemble dans le même véhicule."
          link="/services#tourisme"
        />
        <CategoryCard
          image="/assets/img/fun-buzz/682131531_10241074812431333_7704841538393990651_n.jpg"
          alt="Flotte VTC 100% électrique"
          title="100% Éco-responsable"
          description="Faites le choix d'une mobilité zéro émission. Notre flotte électrique préserve la beauté de la Côte d'Azur tout en vous offrant un trajet fun et sympa."
          link="/services#flotte"
        />
      </div>
    </section>

    <!-- FUN STATS SECTION -->
    <section class="buzz-stats fade-in-section">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-item">
            <span class="stat-emoji">⚡</span>
            <span class="stat-number">100%</span>
            <span class="stat-label">Électrique</span>
          </div>
          <div class="stat-item">
            <span class="stat-emoji">🏖️</span>
            <span class="stat-number">7</span>
            <span class="stat-label">Places spacieuses</span>
          </div>
          <div class="stat-item">
            <span class="stat-emoji">👨‍👩‍👧‍👦</span>
            <span class="stat-number">5.0★</span>
            <span class="stat-label">Avis clients</span>
          </div>
          <div class="stat-item">
            <span class="stat-emoji">🌍</span>
            <span class="stat-number">24/7</span>
            <span class="stat-label">Disponible</span>
          </div>
        </div>
      </div>
    </section>

    <SectionImageText
      title="Pourquoi choisir notre Van ID Buzz et ECOFUNDRIVE ?"
      image="/assets/img/fun-buzz/interieur.jpg"
      alt="Intérieur spacieux Van Volkswagen ID Buzz"
      imageSide="right"
      ctaText="Réserver maintenant"
      ctaLink="/reservation"
    >
      <h3 class="fade-in-section">Espace de Vie et Confort Inégalé</h3>
      <p class="fade-in-section">
        Contrairement aux véhicules classiques, le Volkswagen ID Buzz offre une garde au toit impressionnante, d'immenses surfaces vitrées pour admirer le paysage, et une modularité exceptionnelle. Jusqu'à 7 personnes peuvent voyager sans jamais se sentir à l'étroit.
      </p>
      <h3 class="fade-in-section">Un Capital Sympathie Unique</h3>
      <p class="fade-in-section">
        Le look inimitable et les couleurs vives de nos ID Buzz attirent les regards bienveillants et donnent immédiatement le ton fun et relax de vos vacances. C'est le véhicule idéal pour arriver avec le sourire à l'hôtel, ou pour des photos estivales réussies lors de vos circuits.
      </p>
      <h3 class="fade-in-section">Service Chauffeur Premium et Discret</h3>
      <p class="fade-in-section">
        Nos chauffeurs multilingues vous garantissent un trajet en toute sérénité. Ils maîtrisent parfaitement la région pour éviter le trafic estival et sont à votre service pour vous assister avec vos bagages encombrants, poussettes ou équipements sportifs.
      </p>
    </SectionImageText>

    <!-- FUN CTA BANNER -->
    <section class="buzz-cta-banner fade-in-section">
      <div class="container">
        <div class="cta-inner">
          <h2>Prêt à buzzer sur la Riviera ? 🚐</h2>
          <p>Réservez votre Van ID Buzz en 2 minutes. Prix fixe, zéro surprise, maximum de fun.</p>
          <div class="cta-buttons-row">
            <a href="/reservation" class="btn-buzz">Réserver Maintenant</a>
            <a href="https://wa.me/33616552811" class="btn-buzz-outline">💬 WhatsApp</a>
          </div>
        </div>
      </div>
    </section>

    <SectionImageText
      title="Zones desservies sur la Côte d'Azur"
      image="/assets/img/fun-buzz/espace.jpg"
      alt="Espace bagages et passagers du Van ID Buzz"
      imageSide="left"
      ctaText="Voir toutes les destinations"
      ctaLink="/vtc-nice"
    >
      <p class="fade-in-section">
        Notre flotte de Vans ID Buzz dessert l'ensemble de la région Provence-Alpes-Côte d'Azur. Que ce soit pour récupérer votre groupe à l'aéroport de Nice, vous emmener en famille à Saint-Tropez ou transporter vos invités vers Monaco, notre chauffeur est à votre écoute :
      </p>
      <ul class="list-unstyled grid-3-cols fade-in-section">
        <li><a href="/vtc-nice">VTC Nice</a></li>
        <li><a href="/vtc-cannes">VTC Cannes</a></li>
        <li><a href="/vtc-monaco">VTC Monaco</a></li>
        <li><a href="/vtc-antibes">VTC Antibes</a></li>
        <li><a href="/vtc-saint-tropez">VTC Saint-Tropez</a></li>
        <li><a href="/vtc-menton">VTC Menton</a></li>
        <li><a href="/vtc-grasse">VTC Grasse</a></li>
        <li><a href="/vtc-eze">VTC Eze</a></li>
        <li><a href="/vtc-villefranche-sur-mer">VTC Villefranche</a></li>
        <li><a href="/vtc-cap-ferrat">VTC Cap Ferrat</a></li>
        <li><a href="/vtc-sophia-antipolis">VTC Sophia-Antipolis</a></li>
        <li><a href="/vtc-frejus-saint-raphael">VTC Fréjus</a></li>
        <li><a href="/vtc-juan-les-pins">VTC Juan-les-Pins</a></li>
        <li><a href="/vtc-mougins">VTC Mougins</a></li>
        <li><a href="/vtc-vence">VTC Vence</a></li>
        <li><a href="/vtc-saint-paul-de-vence">VTC Saint-Paul</a></li>
        <li><a href="/vtc-beaulieu-sur-mer">VTC Beaulieu</a></li>
        <li><a href="/vtc-villeneuve-loubet">VTC Villeneuve-Loubet</a></li>
      </ul>
    </SectionImageText>

    <section class="mb-xl fade-in-section">
      <h2 class="text-center mb-lg">Questions Fréquentes (FAQ)</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-question">Combien de passagers et de bagages l'ID Buzz peut-il transporter ?</h3>
          <div class="faq-answer">
            <p>
              Notre Van ID Buzz est configuré pour 7 places (6 passagers + le chauffeur). Il dispose également d'un espace très généreux pour les bagages, même avec 6 passagers à bord, parfait pour les transferts vers l'aéroport.
            </p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Pouvez-vous mettre à disposition un siège bébé ou rehausseur ?</h3>
          <div class="faq-answer">
            <p>
              Absolument. Les sièges enfants et bébés s'installent très facilement dans notre van. Demandez-le simplement lors de votre réservation, ce service est gratuit.
            </p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Comment réserver le Van pour un groupe ?</h3>
          <div class="faq-answer">
            <p>
              Contactez-nous directement par téléphone au <a href="tel:+33616552811">06 16 55 28 11</a>, par email à <a href="mailto:8888VTC@gmail.com">8888VTC@gmail.com</a> ou via le formulaire. Indiquez le nombre de personnes et de bagages prévus.
            </p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">S'agit-il vraiment d'un véhicule 100% électrique ?</h3>
          <div class="faq-answer">
            <p>
              Oui ! Le Volkswagen ID Buzz est la réincarnation moderne et 100% électrique du mythique Combi. Vos trajets seront donc particulièrement silencieux et respectueux de la qualité de l'air de la Côte d'Azur.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>


