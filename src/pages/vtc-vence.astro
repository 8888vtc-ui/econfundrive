---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Vence – Chauffeur Privé Chapelle Matisse | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Vence. Chapelle du Rosaire (Matisse), vieille ville médiévale, arrière-pays niçois. Service premium 24/7.";
const keywords = ['VTC Vence', 'chauffeur privé Vence', 'transfert Chapelle Matisse', 'VTC arrière-pays Nice'];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-vence"
  canonical="/vtc-vence"
  keywords={keywords}
  breadcrumbItems={[{ name: "Accueil", url: "/" }, { name: "Services", url: "/services" }, { name: "VTC Vence", url: "/vtc-vence" }]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Qu'est-ce que la Chapelle Matisse ?","acceptedAnswer":{"@type":"Answer","text":"La Chapelle du Rosaire de Vence, entièrement conçue par Henri Matisse (vitraux, céramiques, mobilier). Son chef-d'œuvre ultime."}}]}}
>
  <PageHero title="VTC Vence" subtitle="La cité épiscopale. Chapelle du Rosaire par Matisse, vieille ville fortifiée, source de la Foux." backgroundImage="/assets/img/guides/villages-perches.webp" badge="CHAPELLE MATISSE • MÉDIÉVAL" />

  <main id="main-content" class="page-content">
    <SectionImageText title="Entre Art et Histoire" image="/assets/img/about/vehicule-premium.webp" alt="VTC Vence Chapelle Matisse" imageSide="right" ctaText="Réserver un transfert" ctaLink="/reservation">
      <p class="fade-in-section"><strong>Vence</strong> est une cité épiscopale millénaire dominée par sa cathédrale romane. Mais c'est la <strong>Chapelle du Rosaire</strong>, chef-d'œuvre ultime d'Henri Matisse, qui attire les visiteurs du monde entier.</p>
      <p class="fade-in-section">La vieille ville fortifiée, la place du Peyra et les remparts méritent une visite. ECOFUNDRIVE vous y dépose et revient vous chercher.</p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Saint-Paul : 5 min</span>
        <span class="distance-badge">📍 Nice : 30 min</span>
        <span class="distance-badge">📍 Grasse : 25 min</span>
      </div>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez Vence</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/services/service-business.webp" alt="Chapelle Rosaire" title="🎨 Chapelle du Rosaire" description="Chef-d'œuvre de Matisse. Vitraux, céramiques, mobilier... Tout conçu par l'artiste." link="/reservation" />
        <CategoryCard image="/assets/img/guides/villages-perches.webp" alt="Vieille ville Vence" title="🏛️ Cité Épiscopale" description="Remparts romains, cathédrale romane, ruelles médiévales. 2000 ans d'histoire." link="/reservation" />
        <CategoryCard image="/assets/img/hero/hero-ete.webp" alt="Col de Vence" title="🏔️ Col de Vence" description="Route panoramique vers l'arrière-pays. Randonnées et panoramas exceptionnels." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC à Vence</h2>
        <p>Chapelle Matisse, ville médiévale, arrière-pays... Sans contrainte de parking.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-saint-paul-de-vence" class="text-dark hover-gold">VTC Saint-Paul</a>
        <a href="/vtc-grasse" class="text-dark hover-gold">VTC Grasse</a>
        <a href="/vtc-cagnes-sur-mer" class="text-dark hover-gold">VTC Cagnes</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; font-size: 2rem; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
