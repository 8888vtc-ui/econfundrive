---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

import PricingRequest from '../components/PricingRequest.astro';
const title = "VTC Vence – Chauffeur Privé Chapelle Matisse | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Vence. Chapelle du Rosaire (Matisse), vieille ville médiévale, marchés provençaux. Transferts depuis Nice et l'aéroport. Service premium.";
const keywords = [
  'VTC Vence',
  'chauffeur privé Vence',
  'VTC Chapelle Matisse',
  'transfert aéroport Vence',
  'chauffeur Vence Nice'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-vence"
  canonical="/vtc-vence"
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Vence", url: "/vtc-vence" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien coûte un VTC de Nice à Vence ?","acceptedAnswer":{"@type":"Answer","text":"Nos tarifs sont personnalisés selon le véhicule choisi, l'horaire et le niveau de service. Contactez-nous pour un devis gratuit et sans engagement."}},{"@type":"Question","name":"Proposez-vous des circuits incluant Saint-Paul-de-Vence et Vence ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous proposons des circuits touristiques combinant Vence, Saint-Paul-de-Vence et les villages perchés. Mise à disposition demi-journée ou journée."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tarifs & Devis</h2>
      <PricingRequest />
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Découvrez Vence</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/destination-nice.png"
          alt="Chapelle Matisse Vence"
          title="Chapelle du Rosaire"
          description="Chef-d'œuvre de Matisse, cette chapelle aux vitraux colorés est considérée comme l'aboutissement de son art."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-nice.png"
          alt="Vieille ville Vence"
          title="La Vieille Ville"
          description="Ruelles médiévales, remparts, cathédrale romane et places ombragées où il fait bon flâner."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-nice.png"
          alt="Marché Vence"
          title="Le Marché Provençal"
          description="Chaque mardi et vendredi, le marché anime la place du Grand Jardin avec produits locaux et artisanat."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-saint-paul-de-vence" class="text-dark hover-gold">VTC Saint-Paul-de-Vence</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-cagnes-sur-mer" class="text-dark hover-gold">VTC Cagnes-sur-Mer</a>
        <a href="/guide-villages-perches-cote-d-azur" class="text-dark hover-gold">Villages Perchés</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
