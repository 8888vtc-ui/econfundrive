---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Mougins – Chauffeur Privé Village Gastronomique | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Mougins. Village gastronomique, restaurants étoilés, galeries d'art. Entre Cannes et Grasse. Transferts premium 24/7.";
const keywords = ['VTC Mougins', 'chauffeur privé Mougins', 'transfert restaurant étoilé', 'VTC village gastronomique'];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-mougins"
  canonical="/vtc-mougins"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Mougins", url: "/vtc-mougins" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Pourquoi Mougins est-elle célèbre ?","acceptedAnswer":{"@type":"Answer","text":"Mougins est le village gastronomique par excellence de la Riviera, avec plusieurs restaurants étoilés et un patrimoine artistique (Picasso y vécut ses dernières années)."}},{"@type":"Question","name":"Proposez-vous des transferts restaurants ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous assurons les transferts vers tous les restaurants étoilés du village avec service aller-retour."}}]}}
>
  <PageHero 
    title="VTC Mougins"
    subtitle="Le village gastronomique de la Riviera. Restaurants étoilés, galeries d'art, patrimoine provençal."
    backgroundImage="/assets/img/guides/villages-perches.webp"
    badge="GASTRONOMIE • ART"
  />

  <main id="main-content" class="page-content">
    <SectionImageText
      title="Village Gastronomique & Artistique"
      image="/assets/img/fun-buzz/OIPhh.jpg"
      alt="VTC Mougins village"
      imageSide="right"
      ctaText="Réserver un transfert"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Mougins</strong> est le paradis des gourmets sur la Côte d'Azur. Plusieurs <strong>restaurants étoilés</strong>, des galeries d'art et un charme provençal préservé. Pablo Picasso y vécut ses 12 dernières années.
      </p>
      <p class="fade-in-section">
        Profitez d'un dîner gastronomique sans vous soucier du retour. Nos chauffeurs vous attendent ou reviennent vous chercher à l'heure convenue.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Cannes : 10 min</span>
        <span class="distance-badge">📍 Grasse : 10 min</span>
        <span class="distance-badge">📍 Nice : 30 min</span>
      </div>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez Mougins</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/fun-buzz/espace.jpg" alt="Restaurant Mougins" title="⭐ Tables Étoilées" description="Paloma, L'Amandier et autres restaurants d'exception. La gastronomie au sommet." link="/reservation" />
        <CategoryCard image="/assets/img/guides/villages-perches.webp" alt="Vieux village" title="🏘️ Vieux Village" description="Ruelles médiévales, remparts, galeries d'art. L'esprit de la Provence." link="/reservation" />
        <CategoryCard image="/assets/img/fun-buzz/OIPint.jpg" alt="Festival Mougins" title="🍴 Les Étoiles de Mougins" description="Festival gastronomique annuel réunissant les plus grands chefs." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC à Mougins</h2>
        <p>Dîner étoilé, visite du village... Profitez sans contrainte de conduite.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-cannes" class="text-dark hover-gold">VTC Cannes</a>
        <a href="/vtc-grasse" class="text-dark hover-gold">VTC Grasse</a>
        <a href="/vtc-sophia-antipolis" class="text-dark hover-gold">VTC Sophia</a>
        <a href="/vtc-antibes" class="text-dark hover-gold">VTC Antibes</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #00b0f0; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(0, 176, 240, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; font-size: 2rem; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #00b0f0, #66d0f7); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #00b0f0; color: #00b0f0; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
