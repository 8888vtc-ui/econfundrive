---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Mougins – Chauffeur Privé Village Gastronomique | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Mougins, village gastronomique et artistique. Musée de la Photographie, restaurants étoilés, golf. Proche Cannes et Sophia Antipolis. Service premium.";
const keywords = [
  'VTC Mougins',
  'chauffeur privé Mougins',
  'VTC restaurant Mougins',
  'transfert Cannes Mougins',
  'VTC golf Mougins'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-mougins"
  canonical="/vtc-mougins"
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Mougins", url: "/vtc-mougins" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Mougins est-elle proche de Cannes ?","acceptedAnswer":{"@type":"Answer","text":"Oui, Mougins est située à seulement 8 km de Cannes, soit 15-20 minutes en VTC. C'est la destination gastronomique préférée des participants au Festival de Cannes."}},{"@type":"Question","name":"Proposez-vous des transferts pour les restaurants étoilés de Mougins ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous assurons les transferts vers tous les restaurants de Mougins, dont Le Moulin de Mougins et La Place de Mougins. Service de retour après le dîner inclus sur demande."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tarifs & Devis</h2>
      <div class="cta-box">
        <a href="/contact" class="btn-primary">Demander un devis gratuit</a>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Découvrez Mougins</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/cannes-palais-festivals.png"
          alt="Restaurant gastronomique Mougins"
          title="Gastronomie Étoilée"
          description="Le Moulin de Mougins, Paloma, La Place de Mougins... Un concentré de restaurants d'exception."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Musée Photo Mougins"
          title="Musée de la Photographie"
          description="Collection unique de portraits de Picasso par les plus grands photographes du XXe siècle."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-saint-tropez.webp"
          alt="Golf Mougins"
          title="Les Golfs de Mougins"
          description="Royal Mougins Golf Resort et Cannes-Mougins Golf, deux parcours prestigieux dans un cadre provençal."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-cannes" class="text-dark hover-gold">VTC Cannes</a>
        <a href="/vtc-grasse" class="text-dark hover-gold">VTC Grasse</a>
        <a href="/vtc-sophia-antipolis" class="text-dark hover-gold">VTC Sophia</a>
        <a href="/vtc-antibes" class="text-dark hover-gold">VTC Antibes</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
