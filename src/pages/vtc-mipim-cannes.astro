---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC MIPIM Cannes 2025 – Chauffeur Privé Salon Immobilier | ECOFUNDRIVE";
const description = "Chauffeur privé VTC pour le MIPIM Cannes 2025. Transferts aéroport Nice, navettes Palais des Festivals, mise à disposition. Service business 24/7.";
const keywords = [
  'VTC MIPIM Cannes',
  'chauffeur MIPIM',
  'transfert MIPIM Cannes',
  'VTC salon immobilier Cannes',
  'chauffeur privé MIPIM 2025'
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "MIPIM Cannes 2025",
  "startDate": "2025-03-11",
  "endDate": "2025-03-14",
  "location": {
    "@type": "Place",
    "name": "Palais des Festivals",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Cannes",
      "addressCountry": "FR"
    }
  },
  "description": "Le MIPIM est le plus grand salon international de l'immobilier. ECOFUNDRIVE propose des services VTC premium pour les participants."
};
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-mipim-cannes"
  canonical="/vtc-mipim-cannes"
  schema={schema}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC MIPIM Cannes", url: "/vtc-mipim-cannes" }
  ]}
>
  <PageHero 
    title="VTC MIPIM Cannes 2025"
    subtitle="Le rendez-vous mondial de l'immobilier. Transferts VIP, mise à disposition et navettes aéroport."
    backgroundImage="/assets/img/destinations/cannes-palais-festivals.png"
    badge="11-14 MARS 2025 • BUSINESS • PALAIS DES FESTIVALS"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Transport MIPIM Premium"
      image="/assets/img/about/vehicule-premium.webp"
      alt="VTC Business Cannes"
      imageSide="right"
      ctaText="Réserver VTC MIPIM"
      ctaLink="/contact"
    >
      <p class="fade-in-section">
        Le <strong>MIPIM</strong> est l'événement business de l'année à Cannes. Avec plus de 26 000 participants, la mobilité est un enjeu clé.
      </p>
      <p class="fade-in-section">
        ECOFUNDRIVE vous offre une solution de transport fiable et haut de gamme. Véhicules business (Berline ou Van), chauffeurs en costume, confidentialité et réservation prioritaire pour vos transferts aéroport et RDV.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">✈️ Aéroport Nice : 45 min</span>
        <span class="distance-badge">📅 Dates : 11-14 Mars</span>
        <span class="distance-badge">💼 Service : 24h/24</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Solutions Business MIPIM</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">✈️</span><h3>Transfert Aéroport</h3><p>Accueil pancarte à Nice Côte d'Azur pour vous et vos équipes.</p></div>
          <div class="service-card"><span class="service-icon">⏱️</span><h3>Mise à Disposition</h3><p>Chauffeur dédié à l'heure ou à la journée pour vos RDV.</p></div>
          <div class="service-card"><span class="service-icon">🥂</span><h3>Soirées Privées</h3><p>Navettes vers les villas, yachts et hôtels pour vos événements.</p></div>
          <div class="service-card"><span class="service-icon">👥</span><h3>Groupes</h3><p>Vans Mercedes Classe V pour délégations jusqu'à 7 pax.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">L'Offre MIPIM</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/hero/hero-aeroport-nice.png" alt="Aéroport Nice" title="✈️ Navette Aéroport" description="La liaison la plus rapide et confortable entre NCE et la Croisette." link="/contact" />
        <CategoryCard image="/assets/img/services/service-business.png" alt="Chauffeur Privé" title="💼 Chauffeur Dédié" description="Optimisez votre temps. Votre chauffeur vous attend entre chaque rendez-vous." link="/contact" />
        <CategoryCard image="/assets/img/destinations/destination-monaco.png" alt="Soirée Cannes" title="🍸 Transferts Soirée" description="Profitez des cocktails networking en toute sécurité. Retour hôtel 24/7." link="/contact" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez pour le MIPIM 2025</h2>
        <p>Disponibilité limitée durant le congrès. Anticipez vos déplacements.</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn-gold">Demander un Devis</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Voir aussi</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-cannes" class="text-dark hover-gold">VTC Cannes</a>
        <a href="/transfert-nice-aeroport-cannes" class="text-dark hover-gold">Transfert Nice → Cannes</a>
        <a href="/guide-vtc-festival-cannes" class="text-dark hover-gold">Festival de Cannes</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #d4af37; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
