---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Cagnes-sur-Mer – Chauffeur Privé Musée Renoir | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Cagnes-sur-Mer. Haut-de-Cagnes, Musée Renoir, hippodrome. Entre Nice et Antibes. Service premium 24/7.";
const keywords = ['VTC Cagnes-sur-Mer', 'chauffeur privé Cagnes', 'VTC Musée Renoir', 'transfert hippodrome Côte Azur'];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-cagnes-sur-mer"
  canonical="/vtc-cagnes-sur-mer"
  keywords={keywords}
  breadcrumbItems={[{ name: "Accueil", url: "/" }, { name: "Services", url: "/services" }, { name: "VTC Cagnes-sur-Mer", url: "/vtc-cagnes-sur-mer" }]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Qu'est-ce que le Haut-de-Cagnes ?","acceptedAnswer":{"@type":"Answer","text":"Village médiéval perché avec château-musée, ruelles pittoresques et vue panoramique. L'un des plus beaux villages perchés de la Riviera."}}]}}
>
  <PageHero title="VTC Cagnes-sur-Mer" subtitle="Du village médiéval à la mer. Haut-de-Cagnes, Musée Renoir, hippodrome de la Côte d'Azur." backgroundImage="/assets/img/guides/villages-perches.webp" badge="RENOIR • HAUT-DE-CAGNES" />

  <main id="main-content" class="page-content">
    <SectionImageText title="Entre Village et Plage" image="/assets/img/fun-buzz/OIP.jpg" alt="VTC Cagnes-sur-Mer" imageSide="right" ctaText="Réserver un transfert" ctaLink="/reservation">
      <p class="fade-in-section"><strong>Cagnes-sur-Mer</strong> offre trois visages : le <strong>Haut-de-Cagnes</strong> médiéval perché, le <strong>Cros-de-Cagnes</strong> traditionnel des pêcheurs, et le bord de mer moderne. Le <strong>Musée Renoir</strong>, dans la maison où l'artiste vécut ses 12 dernières années, est un lieu magique.</p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Nice : 15 min</span>
        <span class="distance-badge">📍 Antibes : 10 min</span>
        <span class="distance-badge">📍 Saint-Paul : 10 min</span>
      </div>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez Cagnes</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/fun-buzz/2025-Volkswagen-ID.-Buzz_Cabana_Blue-VW-Bus.webp" alt="Musée Renoir" title="🎨 Musée Renoir" description="Maison-atelier du maître impressionniste. Oliviers centenaires, vue sublime, sérénité." link="/reservation" />
        <CategoryCard image="/assets/img/guides/villages-perches.webp" alt="Haut-de-Cagnes" title="🏰 Haut-de-Cagnes" description="Village médiéval fortifié, château Grimaldi, ruelles pittoresques, panoramas." link="/reservation" />
        <CategoryCard image="/assets/img/hero/hero-ete.webp" alt="Hippodrome" title="🏇 Hippodrome" description="Unique hippodrome de la Côte d'Azur. Courses en bord de mer de décembre à mars." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC à Cagnes</h2>
        <p>Village, musée, hippodrome ou plage. Découvrez les trois visages de Cagnes.</p>
        <div class="cta-buttons"><a href="/reservation" class="btn-gold">Réserver</a><a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a></div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-saint-paul-de-vence" class="text-dark hover-gold">VTC Saint-Paul</a>
        <a href="/vtc-antibes" class="text-dark hover-gold">VTC Antibes</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-vence" class="text-dark hover-gold">VTC Vence</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #00b0f0; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(0, 176, 240, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #00b0f0, #66d0f7); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #00b0f0; color: #00b0f0; padding: 1rem 2rem; border-radius: 50px; text-decoration: none; }
</style>
