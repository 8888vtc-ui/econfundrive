---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

import PricingRequest from '../components/PricingRequest.astro';
const title = "VTC Cagnes-sur-Mer – Chauffeur Privé Hippodrome & Renoir | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Cagnes-sur-Mer. Hippodrome de la Côte d'Azur, Haut-de-Cagnes, musée Renoir, plages. Transferts aéroport Nice. Service premium 24h/24.";
const keywords = [
  'VTC Cagnes-sur-Mer',
  'chauffeur privé Cagnes',
  'transfert aéroport Cagnes-sur-Mer',
  'VTC Hippodrome Côte Azur',
  'chauffeur Haut-de-Cagnes',
  'VTC plage Cagnes'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-cagnes-sur-mer"
  canonical="/vtc-cagnes-sur-mer"
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Cagnes-sur-Mer", url: "/vtc-cagnes-sur-mer" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien coûte un VTC de l'aéroport de Nice à Cagnes-sur-Mer ?","acceptedAnswer":{"@type":"Answer","text":"Nos tarifs sont personnalisés selon le véhicule choisi, l'horaire et le niveau de service. Contactez-nous pour un devis gratuit et sans engagement."}},{"@type":"Question","name":"Proposez-vous des transferts pour l'Hippodrome de la Côte d'Azur ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous assurons les transferts vers l'Hippodrome pour les courses et événements. Réservation recommandée les jours de grandes courses."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tarifs & Devis</h2>
      <PricingRequest />
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Découvrez Cagnes-sur-Mer</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/destination-nice.png"
          alt="Haut-de-Cagnes village médiéval"
          title="Le Haut-de-Cagnes"
          description="Village médiéval perché avec le Château Grimaldi, ruelles pittoresques et vue panoramique sur la mer."
          link="/guide-villages-perches-cote-d-azur"
        />
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Hippodrome Côte d'Azur"
          title="L'Hippodrome"
          description="Le plus grand hippodrome de la Côte d'Azur. Courses de chevaux et événements toute l'année."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/services/service-evenements.webp"
          alt="Musée Renoir Cagnes"
          title="Domaine des Collettes"
          description="La dernière demeure du peintre Auguste Renoir, transformée en musée au milieu des oliviers."
          link="/reservation"
        />
      </div>
    </section>

    <section class="mb-xl fade-in-section">
      <h2 class="text-center mb-lg">Questions Fréquentes</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-question">Combien de temps pour aller de l'aéroport de Nice à Cagnes-sur-Mer ?</h3>
          <div class="faq-answer">
            <p>Le trajet aéroport Nice → Cagnes-sur-Mer prend environ <strong>15-25 minutes</strong> en VTC selon le trafic. Cagnes est idéalement située à mi-chemin entre Nice et Antibes.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Proposez-vous un service pour l'Hippodrome ?</h3>
          <div class="faq-answer">
            <p>Oui, nous assurons les transferts vers l'Hippodrome de la Côte d'Azur pour les courses et événements. Pour les grandes courses, réservez à l'avance pour garantir votre chauffeur.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-antibes" class="text-dark hover-gold">VTC Antibes</a>
        <a href="/vtc-villeneuve-loubet" class="text-dark hover-gold">VTC Villeneuve-Loubet</a>
        <a href="/vtc-saint-laurent-du-var" class="text-dark hover-gold">VTC Saint-Laurent-du-Var</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
