---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Cagnes-sur-Mer – Chauffeur Privé Hippodrome & Renoir | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Cagnes-sur-Mer. Hippodrome de la Côte d'Azur, Haut-de-Cagnes, musée Renoir, plages. Transferts aéroport Nice. Service premium 24h/24.";
const keywords = [
  'VTC Cagnes-sur-Mer',
  'chauffeur privé Cagnes',
  'transfert aéroport Cagnes-sur-Mer',
  'VTC Hippodrome Côte Azur',
  'chauffeur Haut-de-Cagnes',
  'VTC plage Cagnes'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-cagnes-sur-mer"
  canonical="/vtc-cagnes-sur-mer"
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Cagnes-sur-Mer", url: "/vtc-cagnes-sur-mer" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien coûte un VTC de l'aéroport de Nice à Cagnes-sur-Mer ?","acceptedAnswer":{"@type":"Answer","text":"Le transfert aéroport Nice → Cagnes-sur-Mer coûte environ 35-45€ selon le véhicule. Cagnes est située à seulement 15 km de l'aéroport."}},{"@type":"Question","name":"Proposez-vous des transferts pour l'Hippodrome de la Côte d'Azur ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous assurons les transferts vers l'Hippodrome pour les courses et événements. Réservation recommandée les jours de grandes courses."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    <SectionImageText
      title="Votre Chauffeur Privé à Cagnes-sur-Mer"
      image="/assets/img/destinations/destination-nice.png"
      alt="VTC chauffeur privé Cagnes-sur-Mer"
      imageSide="right"
      ctaText="Réserver votre VTC"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Cagnes-sur-Mer</strong> est une ville balnéaire prisée située entre Nice et Antibes. Avec son charmant village médiéval du <strong>Haut-de-Cagnes</strong>, son célèbre <strong>Hippodrome de la Côte d'Azur</strong> et le <strong>musée Renoir</strong>, elle attire visiteurs et résidents toute l'année.
      </p>
      <p class="fade-in-section">
        ECOFUNDRIVE vous propose un <strong>service VTC premium à Cagnes-sur-Mer</strong>, idéal pour vos transferts aéroport, vos sorties au hippodrome ou vos visites touristiques. Nos chauffeurs connaissent parfaitement la ville et ses accès.
      </p>
      <ul class="fade-in-section">
        <li>Transferts aéroport Nice (15 min en VTC)</li>
        <li>Service pour l'Hippodrome de la Côte d'Azur</li>
        <li>Visites du Haut-de-Cagnes et musée Renoir</li>
        <li>Accès aux plages et restaurants du Cros-de-Cagnes</li>
        <li>Navettes vers Polygone Riviera et Sophia Antipolis</li>
      </ul>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tarifs VTC Cagnes-sur-Mer</h2>
      <table class="tarif-table">
        <thead>
          <tr><th>Destination</th><th>Distance</th><th>Durée</th><th>Tarif estimé</th></tr>
        </thead>
        <tbody>
          <tr><td>Aéroport Nice → Cagnes-sur-Mer</td><td>15 km</td><td>15-25 min</td><td>40€</td></tr>
          <tr><td>Cagnes → Nice Centre</td><td>12 km</td><td>15-20 min</td><td>35€</td></tr>
          <tr><td>Cagnes → Antibes</td><td>8 km</td><td>10-15 min</td><td>25€</td></tr>
          <tr><td>Cagnes → Cannes</td><td>25 km</td><td>25-35 min</td><td>55€</td></tr>
          <tr><td>Cagnes → Monaco</td><td>30 km</td><td>30-45 min</td><td>75€</td></tr>
          <tr><td>Cagnes → Sophia Antipolis</td><td>12 km</td><td>15-20 min</td><td>35€</td></tr>
        </tbody>
      </table>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Découvrez Cagnes-sur-Mer</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/destination-nice.png"
          alt="Haut-de-Cagnes village médiéval"
          title="Le Haut-de-Cagnes"
          description="Village médiéval perché avec le Château Grimaldi, ruelles pittoresques et vue panoramique sur la mer."
          link="/guide-villages-perches-cote-d-azur"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-nice.png"
          alt="Hippodrome Côte d'Azur"
          title="L'Hippodrome"
          description="Le plus grand hippodrome de la Côte d'Azur. Courses de chevaux et événements toute l'année."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-nice.png"
          alt="Musée Renoir Cagnes"
          title="Domaine des Collettes"
          description="La dernière demeure du peintre Auguste Renoir, transformée en musée au milieu des oliviers."
          link="/reservation"
        />
      </div>
    </section>

    <section class="mb-xl fade-in-section">
      <h2 class="text-center mb-lg">Questions Fréquentes</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-question">Combien de temps pour aller de l'aéroport de Nice à Cagnes-sur-Mer ?</h3>
          <div class="faq-answer">
            <p>Le trajet aéroport Nice → Cagnes-sur-Mer prend environ <strong>15-25 minutes</strong> en VTC selon le trafic. Cagnes est idéalement située à mi-chemin entre Nice et Antibes.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Proposez-vous un service pour l'Hippodrome ?</h3>
          <div class="faq-answer">
            <p>Oui, nous assurons les transferts vers l'Hippodrome de la Côte d'Azur pour les courses et événements. Pour les grandes courses, réservez à l'avance pour garantir votre chauffeur.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-antibes" class="text-dark hover-gold">VTC Antibes</a>
        <a href="/vtc-villeneuve-loubet" class="text-dark hover-gold">VTC Villeneuve-Loubet</a>
        <a href="/vtc-saint-laurent-du-var" class="text-dark hover-gold">VTC Saint-Laurent-du-Var</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .tarif-table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  .tarif-table th, .tarif-table td { padding: 0.75rem; text-align: left; border-bottom: 1px solid #eee; }
  .tarif-table th { background: #f5f5f5; font-weight: 600; }
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
