---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Roquebrune-Cap-Martin – Chauffeur Privé Château & Cap | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Roquebrune-Cap-Martin. Château médiéval, Cap Martin excluif, sentier Le Corbusier. Transferts Monaco premium 24/7.";
const keywords = [
  'VTC Roquebrune-Cap-Martin',
  'chauffeur privé Roquebrune',
  'VTC Cap Martin',
  'transfert Monaco Roquebrune',
  'VTC château Roquebrune'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-roquebrune-cap-martin"
  canonical="/vtc-roquebrune-cap-martin"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Roquebrune-Cap-Martin", url: "/vtc-roquebrune-cap-martin" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Le château se visite-t-il ?","acceptedAnswer":{"@type":"Answer","text":"Oui, le château médiéval du Xe siècle est ouvert au public. Vue spectaculaire sur Monaco."}},{"@type":"Question","name":"Assurez-vous les transferts Cap Martin ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous desservons les villas privées du Cap Martin en toute discrétion."}}]}}
>
  <PageHero 
    title="VTC Roquebrune-Cap-Martin"
    subtitle="Entre ciel et mer. Village médiéval perché, château millénaire et villas exclusives du Cap Martin."
    backgroundImage="/assets/img/destinations/destination-monaco.webp"
    badge="MÉDIÉVAL • CAP MARTIN • LE CORBUSIER"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Histoire & Luxe"
      image="/assets/img/destinations/destination-nice.png"
      alt="VTC Roquebrune"
      imageSide="right"
      ctaText="Réserver un transfert"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Roquebrune-Cap-Martin</strong> domine la Principauté de Monaco. Son village médiéval abrite le <strong>plus vieux château de France</strong>, tandis que le Cap Martin cache des villas somptueuses dans une pinède préservée.
      </p>
      <p class="fade-in-section">
        Le sentier littoral, dit <strong>Promenade Le Corbusier</strong>, offre des vues à couper le souffle. ECOFUNDRIVE assure vos déplacements entre le village, le cap et Monaco.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Monaco : 10 min</span>
        <span class="distance-badge">📍 Menton : 10 min</span>
        <span class="distance-badge">📍 Nice : 25 min</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Services Roquebrune</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">🏰</span><h3>Château</h3><p>Excursion au village médiéval et son donjon millénaire.</p></div>
          <div class="service-card"><span class="service-icon">🏡</span><h3>Cap Martin</h3><p>Transferts discrets vers les villas et le Grand Hôtel.</p></div>
          <div class="service-card"><span class="service-icon">🚶</span><h3>Le Corbusier</h3><p>Dépose départ sentier littoral ou visite cabanon.</p></div>
          <div class="service-card"><span class="service-icon">🎾</span><h3>Monte-Carlo</h3><p>Accès rapide au Masters de Tennis (situé à Roquebrune).</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez Roquebrune</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/destinations/destination-monaco.png" alt="Château Roquebrune" title="🏰 Château Médiéval" description="Forteresse du Xe siècle surplombant Monaco. Un voyage dans le temps avec vue panoramique." link="/reservation" />
        <CategoryCard image="/assets/img/services/service-business.webp" alt="Cap Martin" title="🌲 Le Cap Martin" description="Presqu'île de rêve où séjournèrent l'impératrice Eugénie et Coco Chanel." link="/reservation" />
        <CategoryCard image="/assets/img/destinations/destination-nice.png" alt="Cabanon Le Corbusier" title="architecture Le Corbusier" description="Le célèbre cabanon de l'architecte, classé UNESCO, sur le sentier littoral." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC à Roquebrune</h2>
        <p>Histoire, nature ou soirée à Monaco. Voyagez en confort premium.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-monaco" class="text-dark hover-gold">VTC Monaco</a>
        <a href="/vtc-menton" class="text-dark hover-gold">VTC Menton</a>
        <a href="/vtc-eze" class="text-dark hover-gold">VTC Eze</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #d4af37; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
