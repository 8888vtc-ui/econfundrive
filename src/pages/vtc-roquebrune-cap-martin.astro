---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

import PricingRequest from '../components/PricingRequest.astro';
const title = "VTC Roquebrune-Cap-Martin – Chauffeur Privé Presqu'île | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Roquebrune-Cap-Martin. Cap Martin, plages, villas Belle Époque, sentier Le Corbusier. Entre Monaco et Menton. Service premium 24h/24.";
const keywords = [
  'VTC Roquebrune-Cap-Martin',
  'chauffeur privé Roquebrune',
  'VTC Cap Martin',
  'transfert Monaco Roquebrune',
  'chauffeur Menton Roquebrune'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-roquebrune-cap-martin"
  canonical="/vtc-roquebrune-cap-martin"
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Roquebrune-Cap-Martin", url: "/vtc-roquebrune-cap-martin" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Roquebrune-Cap-Martin est-elle proche de Monaco ?","acceptedAnswer":{"@type":"Answer","text":"Oui, Roquebrune-Cap-Martin jouxte Monaco. Le Cap Martin est à 5 minutes en VTC du Casino de Monte-Carlo."}},{"@type":"Question","name":"Proposez-vous des transferts vers les hôtels de Roquebrune ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous desservons tous les hôtels et villas de Roquebrune-Cap-Martin, dont le Vista Palace et les résidences du Cap Martin."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tarifs & Devis</h2>
      <PricingRequest />
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Découvrez Roquebrune-Cap-Martin</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.png"
          alt="Village Roquebrune"
          title="Le Village Médiéval"
          description="Ruelles pavées, château du Xe siècle (le plus ancien de France), vue spectaculaire sur Monaco et la mer."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/services/service-business.webp"
          alt="Cap Martin"
          title="Le Cap Martin"
          description="Presqu'île exclusive aux villas Belle Époque. Lieu de villégiature de l'aristocratie européenne."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/hero/hero-mariage.webp"
          alt="Cabanon Le Corbusier"
          title="Cabanon Le Corbusier"
          description="La minuscule maison-atelier de l'architecte, classée au patrimoine mondial de l'UNESCO."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-monaco" class="text-dark hover-gold">VTC Monaco</a>
        <a href="/vtc-menton" class="text-dark hover-gold">VTC Menton</a>
        <a href="/vtc-beaulieu-sur-mer" class="text-dark hover-gold">VTC Beaulieu</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
