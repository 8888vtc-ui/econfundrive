---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Sophia Antipolis – Chauffeur Privé Technopole | ECOFUNDRIVE";
const description = "Chauffeur privé VTC pour Sophia Antipolis. Technopole, entreprises tech, congrès, séminaires. Transferts aéroport Nice. Service business premium 24/7.";
const keywords = ['VTC Sophia Antipolis', 'chauffeur privé technopole', 'transfert aéroport Sophia', 'VTC business Sophia'];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-sophia-antipolis"
  canonical="/vtc-sophia-antipolis"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Sophia Antipolis", url: "/vtc-sophia-antipolis" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien de temps aéroport → Sophia ?","acceptedAnswer":{"@type":"Answer","text":"Le transfert Nice Aéroport → Sophia Antipolis prend environ 25-35 minutes."}},{"@type":"Question","name":"Proposez-vous des comptes entreprise ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous proposons des comptes corporate avec facturation mensuelle pour les entreprises de la technopole."}}]}}
>
  <PageHero 
    title="VTC Sophia Antipolis"
    subtitle="La Silicon Valley européenne. Transport premium pour entreprises tech, congrès et séminaires."
    backgroundImage="/assets/img/services/service-business.webp"
    badge="TECHNOPOLE • BUSINESS"
  />

  <main id="main-content" class="page-content">
    <SectionImageText
      title="Votre Partenaire Transport Business"
      image="/assets/img/about/chauffeur-professionnel.webp"
      alt="VTC Sophia Antipolis business"
      imageSide="right"
      ctaText="Demander un devis entreprise"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Sophia Antipolis</strong> est la première technopole d'Europe, regroupant plus de 2 500 entreprises et 36 000 emplois. ECOFUNDRIVE est le partenaire transport privilégié des entreprises de la tech.
      </p>
      <p class="fade-in-section">
        <strong>Comptes entreprise</strong> disponibles : facturation mensuelle, reporting, véhicules dédiés pour vos visiteurs VIP et dirigeants.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Aéroport : 30 min</span>
        <span class="distance-badge">📍 Nice : 25 min</span>
        <span class="distance-badge">📍 Cannes : 20 min</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Services Business</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">✈️</span><h3>Transferts Aéroport</h3><p>Accueil VIP, suivi de vol, dépose directe sur la technopole.</p></div>
          <div class="service-card"><span class="service-icon">💼</span><h3>Comptes Entreprise</h3><p>Facturation mensuelle, reporting, tarifs négociés.</p></div>
          <div class="service-card"><span class="service-icon">🎯</span><h3>Séminaires & Events</h3><p>Navettes groupées pour événements d'entreprise.</p></div>
          <div class="service-card"><span class="service-icon">🕐</span><h3>Mise à Disposition</h3><p>Chauffeur dédié à la journée pour vos visiteurs.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Ouvrez un Compte Entreprise</h2>
        <p>Simplifiez les déplacements de vos collaborateurs et visiteurs.</p>
        <div class="cta-buttons">
          <a href="/vtc-entreprise-cote-azur" class="btn-gold">En savoir plus</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-antibes" class="text-dark hover-gold">VTC Antibes</a>
        <a href="/vtc-mougins" class="text-dark hover-gold">VTC Mougins</a>
        <a href="/vtc-biot" class="text-dark hover-gold">VTC Biot</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-cannes" class="text-dark hover-gold">VTC Cannes</a>
        <a href="/vtc-grasse" class="text-dark hover-gold">VTC Grasse</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; display: block; margin-bottom: 1rem; }
  .service-card h3 { color: #d4af37; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; font-size: 2rem; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>