---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "À Propos d'ECOFUNDRIVE | Votre Chauffeur Privé de Confiance";
const description = "Découvrez l'histoire et les valeurs d'ECOFUNDRIVE. Une vision du transport VTC basée sur l'excellence, la discrétion et le service sur-mesure.";
const keywords = [
  'VTC luxe Nice',
  'chauffeur privé Côte d\'Azur',
  'histoire ECOFUNDRIVE',
  'valeurs transport VTC',
  'service premium VTC'
];

const breadcrumbItems = [
  { name: "Accueil", url: "/" },
  { name: "À Propos", url: "/a-propos" }
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="a-propos"
  canonical="/a-propos"
  breadcrumbItems={breadcrumbItems}
>
  <main id="main-content">
    
    <!-- HERO SECTION -->
    <section class="about-hero">
      <div class="hero-bg"></div>
      <div class="hero-overlay"></div>
      <div class="container hero-content fade-in-section">
        <h1>L'Art du Transport Privé</h1>
        <p class="lead">Plus qu'un simple trajet, nous vous offrons une expérience de mobilité exclusive sur la Côte d'Azur.</p>
      </div>
    </section>

    <!-- MISSION SECTION -->
    <section class="mission-section">
      <div class="container">
        <div class="mission-grid">
          <div class="mission-text fade-in-section">
            <span class="eyebrow">NOTRE VISION</span>
            <h2>L'Excellence comme Standard</h2>
            <p>
              Fondée avec la conviction que le transport privé doit allier confort absolu, fiabilité sans faille et touche humaine, ECOFUNDRIVE s'est imposée comme une référence sur la Côte d'Azur.
            </p>
            <p>
              Nous ne nous contentons pas de vous conduire d'un point A à un point B. Nous anticipons vos besoins, nous connaissons les meilleurs itinéraires pour éviter le trafic, et nous veillons à ce que chaque minute passée à bord soit un moment de détente ou de productivité.
            </p>
            <div class="signature">
              <p class="founder-name">L'Équipe ECOFUNDRIVE</p>
              <p class="founder-title">Service VTC Premium</p>
            </div>
          </div>
          <div class="mission-image fade-in-section">
             <!-- Placeholder image chauffeur -->
             <img src="/assets/img/hero/chauffeur-luxe-background.webp" alt="Chauffeur privé ouvrant la porte" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- VALUES GRID -->
    <section class="values-section">
      <div class="container">
        <div class="section-header text-center fade-in-section">
          <h2>Nos Piliers de Qualité</h2>
          <div class="divider"></div>
        </div>
        
        <div class="values-grid">
          <div class="value-card fade-in-section">
            <div class="value-number">01</div>
            <h3>Discrétion</h3>
            <p>Votre vie privée est sacrée. Nos chauffeurs s'engagent à une confidentialité totale concernant vos conversations et déplacements.</p>
          </div>
          
          <div class="value-card fade-in-section">
            <div class="value-number">02</div>
            <h3>Ponctualité</h3>
            <p>Le temps est le luxe ultime. Nous arrivons systématiquement en avance pour que vous ne soyez jamais en retard.</p>
          </div>
          
          <div class="value-card fade-in-section">
            <div class="value-number">03</div>
            <h3>Confort</h3>
            <p>Véhicules récents, entretien méticuleux, conduite souple et attentions à bord (eau, chargeurs, wifi).</p>
          </div>
          
          <div class="value-card fade-in-section">
            <div class="value-number">04</div>
            <h3>Expertise</h3>
            <p>Parfaite connaissance de la région, de ses raccourcis et de ses lieux d'exception (hôtels, lieux événementiels).</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FLEET SHOWCASE -->
    <section class="fleet-section">
      <div class="container">
         <div class="fleet-content fade-in-section">
            <div class="fleet-text">
               <h2>Une Flotte d'Exception</h2>
               <p>Que vous voyagiez seul ou en groupe, nous avons le véhicule adapté. De la berline Tesla écologique et silencieuse au Van Mercedes Classe V pour vos équipes.</p>
               <a href="/reservation" class="btn-primary">Réserver un véhicule</a>
            </div>
            <div class="fleet-visual">
               <img src="/assets/img/destinations/vtc-tesla-nice.webp" alt="Flotte véhicules VTC" />
            </div>
         </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* HERO */
  .about-hero {
    position: relative;
    height: 50vh;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/assets/img/hero/hero-business.webp');
    background-size: cover;
    background-position: center;
    filter: brightness(0.6);
    z-index: 1;
  }
  
  .hero-overlay {
      position: absolute;
      inset: 0;
      background: rgba(10,10,10,0.4);
      z-index: 2;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    max-width: 800px;
  }

  .about-hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    margin-bottom: 1rem;
    text-shadow: 0 4px 10px rgba(0,0,0,0.3);
    color: white;
  }
  
  .about-hero .lead {
      font-size: 1.25rem;
      color: #e0e0e0;
      font-weight: 300;
  }

  /* MISSION SECTION */
  .mission-section {
    padding: 6rem 0;
    background: white;
  }

  .mission-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .mission-text .eyebrow {
    color: #d4af37;
    font-size: 0.9rem;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
    font-weight: 600;
    display: block;
    margin-bottom: 1rem;
  }

  .mission-text h2 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
    color: #1a1a1a;
    line-height: 1.2;
  }

  .mission-text p {
    color: #555;
    margin-bottom: 1.5rem;
    line-height: 1.8;
    font-size: 1.05rem;
  }
  
  .signature {
      margin-top: 2rem;
      border-left: 3px solid #d4af37;
      padding-left: 1rem;
  }
  
  .founder-name {
      font-family: 'Playfair Display', serif; /* Si dispo, sinon fallback */
      font-size: 1.25rem;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 0.25rem !important;
  }
  
  .founder-title {
      font-size: 0.9rem !important;
      color: #888 !important;
      margin-bottom: 0 !important;
  }

  .mission-image img {
    width: 100%;
    max-height: 500px;
    object-fit: cover;
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.1);
  }

  /* VALUES SECTION */
  .values-section {
    padding: 6rem 0;
    background: #fcfcfc;
  }
  
  .section-header { margin-bottom: 4rem; }
  .section-header h2 { font-size: 2.5rem; color: #1a1a1a; margin-bottom: 1rem; }
  .divider { width: 60px; height: 3px; background: #d4af37; margin: 0 auto; }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .value-card {
    background: white;
    padding: 2rem;
    border-radius: 16px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.03);
    border: 1px solid rgba(0,0,0,0.03);
    transition: transform 0.3s;
    position: relative;
    overflow: hidden;
  }

  .value-card:hover {
    transform: translateY(-5px);
    border-color: rgba(212, 175, 55, 0.3);
  }

  .value-number {
    font-size: 3rem;
    font-weight: 900;
    color: rgba(212, 175, 55, 0.15);
    position: absolute;
    top: 10px;
    right: 20px;
  }

  .value-card h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: #1a1a1a;
    position: relative;
  }

  .value-card p {
    font-size: 0.95rem;
    color: #666;
    line-height: 1.6;
    position: relative;
  }
  
  /* FLEET SECTION */
  .fleet-section {
      padding: 6rem 0;
      background: #111;
      color: white;
      text-align: center;
  }
  
  .fleet-content {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3rem;
  }
  
  .fleet-text h2 { font-size: 2.5rem; margin-bottom: 1.5rem; color: #d4af37; }
  .fleet-text p { font-size: 1.1rem; color: #ccc; margin-bottom: 2rem; max-width: 600px; margin: 0 auto 2rem; }
  
  .btn-primary {
      background: #d4af37;
      color: black;
      padding: 1rem 2rem;
      border-radius: 50px;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.3s;
      display: inline-block;
  }
  .btn-primary:hover { background: white; transform: translateY(-3px); }
  
  .fleet-visual img {
      width: 100%;
      max-width: 800px;
      border-radius: 12px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  }

  /* RESPONSIVE */
  @media (max-width: 992px) {
    .mission-grid { grid-template-columns: 1fr; }
    .values-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 576px) {
    .values-grid { grid-template-columns: 1fr; }
    .about-hero h1 { font-size: 2.5rem; }
  }
</style>
