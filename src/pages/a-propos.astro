---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { reviewStats, featuredReviews } from '../data/reviews';

const title = "À Propos d'ECOFUNDRIVE | Excellence VTC Côte d'Azur";
const description = "Découvrez ECOFUNDRIVE, votre partenaire de confiance pour le transport privé sur la Côte d'Azur. Ponctualité, discrétion et excellence depuis 2022.";
const keywords = [
  'qui sommes nous ecofundrive',
  'valeurs VTC Nice',
  'chauffeur privé confiance',
  'histoire ecofundrive',
  'service premium VTC'
];

const schema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "mainEntity": {
    "@type": "Organization",
    "name": "ECOFUNDRIVE",
    "description": "Service de voiture de transport avec chauffeur (VTC) premium sur la Côte d'Azur.",
    "foundingDate": "2022",
    "areaServed": {
      "@type": "Place",
      "name": "French Riviera"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": reviewStats.averageRating,
      "reviewCount": reviewStats.totalReviews
    }
  }
};
---

<BaseLayout
  title={title}
  description={description}
  currentPage="a-propos"
  canonical="/a-propos"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "À Propos", url: "/a-propos" }
  ]}
  schema={schema}
>
  <PageHero 
    title="L'Art du Service"
    subtitle="Plus qu'un simple trajet, nous vous offrons une expérience de mobilité exclusive, fondée sur l'exigence et le détail."
    backgroundImage="/assets/img/hero/hero-business.webp"
    badge="DEPUIS 2022 • PREMIUM • CONFIANCE"
    reviewCount={`${reviewStats.totalReviews} Avis Vérifiés`}
    rating={`${reviewStats.averageRating}`}
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Notre Vision de l'Excellence"
      image="/assets/img/hero/hero-business.webp"
      alt="Chauffeur ouvrant la porte"
      imageSide="right"
      ctaText="Découvrir nos Services"
      ctaLink="/services"
    >
      <p class="fade-in-section">
        <strong>ECOFUNDRIVE</strong> est née d'un constat simple : sur la Côte d'Azur, terre d'élégance mondiale, le transport se doit d'être irréprochable.
      </p>
      <p class="fade-in-section">
        Nous avons banni l'aléatoire. Pas de retard, pas de véhicules mal entretenus, pas de facturation surprise. Nous avons construit notre réputation sur une <strong>fiabilité absolue</strong> et une qualité de service constante, que ce soit pour un simple transfert aéroport ou pour la logistique complexe d'un événement international.
      </p>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Nos Piliers de Qualité</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">🔒</span><h3>Discrétion</h3><p>Le silence est d'or. Votre vie privée et vos conversations à bord restent strictement confidentielles.</p></div>
          <div class="service-card"><span class="service-icon">⏱️</span><h3>Ponctualité</h3><p>Le temps est le luxe ultime. Nous arrivons systématiquement 15 minutes en avance. Jamais de stress.</p></div>
          <div class="service-card"><span class="service-icon">✨</span><h3>Confort</h3><p>Véhicules immaculés, bouteilles d'eau, chargeurs, Wi-Fi. Votre confort est notre obsession.</p></div>
          <div class="service-card"><span class="service-icon">🤝</span><h3>Sur-Mesure</h3><p>Chaque client est unique. Nous adaptons l'itinéraire, la musique et la température à vos préférences.</p></div>
        </div>
      </div>
    </section>

    <SectionImageText
      title="Une Flotte pour Chaque Besoin"
      image="/assets/img/destinations/vtc-tesla-nice.webp"
      alt="Flotte VTC Ecofundrive"
      imageSide="left"
      ctaText="Voir la Flotte"
      ctaLink="/services"
    >
      <p class="fade-in-section">
        Notre flotte est composée exclusivement de véhicules récents (moins de 3 ans) et haut de gamme.
      </p>
      <ul class="fade-in-section">
        <li><strong>Berline Éco/Premium :</strong> Tesla Model S, Mercedes Classe E. L'élégance discrète pour 1 à 3 passagers.</li>
        <li><strong>Van Prestige :</strong> Mercedes Classe V. Le salon roulant pour les groupes (jusqu'à 7 pax) et les familles avec bagages.</li>
      </ul>
      <p class="fade-in-section">
        Tous nos véhicules sont entretenus rigoureusement et nettoyés avant chaque course.
      </p>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Ils Nous Font Confiance</h2>
      <div class="text-center">
        <p class="lead mb-lg">Note moyenne de <strong>{reviewStats.averageRating}/5</strong> sur plus de {reviewStats.totalReviews} avis vérifiés.</p>
        <div class="grid-3-cols">
          {featuredReviews.slice(0, 3).map((review) => (
             <div class="card p-4 border rounded">
               <p class="italic">"{review.reviewBody}"</p>
               <p class="font-bold mt-2">- {review.author}</p>
             </div>
          ))}
        </div>
        <div class="mt-8">
           <a href="https://www.google.com/search?q=ecofundrive+avis" target="_blank" rel="noopener noreferrer" class="cta-link">Lire tous les avis Google →</a>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Rejoignez le Cercle de l'Excellence</h2>
        <p>Réservez votre prochain trajet et découvrez la différence.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver Maintenant</a>
          <a href="/contact" class="btn-outline">Nous Contacter</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #d4af37; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
  .italic { font-style: italic; color: #555; }
  .font-bold { font-weight: 700; color: #1a1a1a; }
  .cta-link { color: #d4af37; font-weight: 600; text-decoration: none; }
  .cta-link:hover { text-decoration: underline; }
  .mt-8 { margin-top: 2rem; }
</style>
