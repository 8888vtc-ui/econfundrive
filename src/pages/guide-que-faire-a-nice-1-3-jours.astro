---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "Que Faire à Nice en 1 à 3 Jours – Itinéraires & Transport | ECOFUNDRIVE";
const description = "Visitez Nice en 1, 2 ou 3 jours. Vieux-Nice, Promenade des Anglais, Colline du Château, excursions Èze & Monaco. Guide optimisé avec chauffeur VTC.";
const keywords = [
  'visiter Nice 1 jour',
  'itinéraire Nice 3 jours',
  'que faire Nice week-end',
  'VTC Nice tourisme',
  'excursion depuis Nice'
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": "https://www.ecofundrive.com/assets/img/destinations/vtc-nice.webp",
  "author": { "@type": "Organization", "name": "ECOFUNDRIVE" }
};
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="guide-que-faire-a-nice-1-3-jours"
  canonical="/guide-que-faire-a-nice-1-3-jours"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Guides", url: "/guides" },
    { name: "Visiter Nice", url: "/guide-que-faire-a-nice-1-3-jours" }
  ]}
  schema={schema}
>
  <PageHero 
    title="Visiter Nice : Le Guide"
    subtitle="De la Promenade des Anglais aux collines de Cimiez. Optimisez votre séjour de 1 à 3 jours sur la French Riviera."
    backgroundImage="/assets/img/destinations/vtc-nice.webp"
    badge="ITINÉRAIRES • CULTURE • DÉTENTE"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Jour 1 : L'Âme de Nissa la Bella"
      image="/assets/img/destinations/vtc-nice.webp"
      alt="Promenade des Anglais"
      imageSide="right"
      ctaText="Transfert Centre-Ville"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Matin :</strong> Plongez dans le <strong>Vieux-Nice</strong>. Perdez-vous dans les ruelles colorées, sentez les épices du marché du Cours Saleya et dégustez une socca chaude chez Thérésa.
      </p>
      <p class="fade-in-section">
        <strong>Après-midi :</strong> Grimpez à la Colline du Château pour la vue iconique sur la Baie des Anges. Redescendez flâner sur la mythique <strong>Promenade des Anglais</strong> au coucher du soleil.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Vieux-Nice</span>
        <span class="distance-badge">🌊 Promenade</span>
        <span class="distance-badge">🏰 Colline du Château</span>
      </div>
    </SectionImageText>

    <SectionImageText
      title="Jour 2 : Art, Culture & Shopping"
      image="/assets/img/fun-buzz/OIPint.jpg"
      alt="Musée Matisse Nice"
      imageSide="left"
      ctaText="VTC Musées"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Matin :</strong> Direction les hauteurs de <strong>Cimiez</strong>. Ce quartier aristocratique abrite les Arènes romaines et le superbe <strong>Musée Matisse</strong>.
      </p>
      <p class="fade-in-section">
        <strong>Après-midi :</strong> Shopping chic dans le Carré d'Or ou visite du Musée Marc Chagall près de la gare. Terminez par un verre sur le rooftop du Negresco.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">🎨 Matisse & Chagall</span>
        <span class="distance-badge">🏛️ Cimiez</span>
        <span class="distance-badge">🛍️ Carré d'Or</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Jour 3 : Excursions Privées</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">🏰</span><h3>Èze & Monaco</h3><p>Matinée médiévale à Èze, après-midi princier à Monte-Carlo.</p></div>
          <div class="service-card"><span class="service-icon">🍷</span><h3>Route des Vins</h3><p>Découverte du vignoble de Bellet sur les collines niçoises.</p></div>
          <div class="service-card"><span class="service-icon">⛵</span><h3>Cap Ferrat</h3><p>Visite de la Villa Ephrussi de Rothschild et balade côtière.</p></div>
          <div class="service-card"><span class="service-icon">🎨</span><h3>Saint-Paul</h3><p>Escapade artistique dans l'arrière-pays authentique.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Les Indispensables</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/fun-buzz/interieur.jpg" alt="Aéroport Nice" title="✈️ Arrivée à Nice" description="Réservez votre transfert aéroport à l'avance pour éviter la file des taxis." link="/reservation" />
        <CategoryCard image="/assets/img/destinations/destination-nice.webp" alt="Hôtels Nice" title="🏨 Où dormir ?" description="Nos recommandations : Negresco (Luxe), Radisson Blu (Vue), Beau Rivage (Centre)." link="/reservation" />
        <CategoryCard image="/assets/img/fun-buzz/interieur.jpg" alt="Soirée Nice" title="🍽️ Restaurants" description="Du étoilé Michelin au bistrot niçois. Demandez conseil à votre chauffeur." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Organisez votre Séjour à Nice</h2>
        <p>Un chauffeur privé pour vos transferts et excursions.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Guides Connexes</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/guide-villages-perches-cote-d-azur" class="text-dark hover-gold">Villages Perchés</a>
        <a href="/guide-monaco-en-une-journee" class="text-dark hover-gold">Monaco 1 Jour</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-eze" class="text-dark hover-gold">VTC Èze</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #00b0f0; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(0, 176, 240, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(0, 176, 240, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #00b0f0; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #00b0f0, #66d0f7); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #00b0f0; color: #00b0f0; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
