---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

import PricingRequest from '../components/PricingRequest.astro';
const title = "VTC Cap Ferrat – Chauffeur Privé Villa Ephrussi | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Saint-Jean-Cap-Ferrat. Villa Ephrussi de Rothschild, Grand Hôtel du Cap-Ferrat, villas de luxe. Service premium pour clientèle exigeante.";
const keywords = [
  'VTC Cap Ferrat',
  'chauffeur privé Cap Ferrat',
  'VTC Villa Ephrussi',
  'transfert Saint-Jean-Cap-Ferrat',
  'VTC Grand Hotel Cap Ferrat',
  'chauffeur presqu ile Cap Ferrat'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-cap-ferrat"
  canonical="/vtc-cap-ferrat"
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Cap Ferrat", url: "/vtc-cap-ferrat" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien coûte un VTC de Nice à Cap Ferrat ?","acceptedAnswer":{"@type":"Answer","text":"Nos tarifs sont personnalisés selon le véhicule choisi, l'horaire et le niveau de service. Contactez-nous pour un devis gratuit et sans engagement."}},{"@type":"Question","name":"Proposez-vous des transferts vers le Grand Hôtel du Cap-Ferrat ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous desservons régulièrement le Grand Hôtel du Cap-Ferrat Four Seasons ainsi que tous les hôtels et villas de la presqu'île."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tarifs & Devis</h2>
      <PricingRequest />
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Découvrez Cap Ferrat</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.png"
          alt="Villa Ephrussi Rothschild"
          title="Villa Ephrussi de Rothschild"
          description="Palais de style Renaissance italienne aux 9 jardins thématiques. Vue imprenable sur les deux baies de la presqu'île."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.png"
          alt="Grand Hotel Cap Ferrat"
          title="Grand Hôtel du Cap-Ferrat"
          description="Palace Four Seasons mythique, ses plages privées et son restaurant étoilé face à la mer."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-monaco.png"
          alt="Sentier Cap Ferrat"
          title="Le Sentier du Littoral"
          description="Promenade de 11 km autour de la presqu'île, entre criques cachées et vues spectaculaires."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-villefranche-sur-mer" class="text-dark hover-gold">VTC Villefranche</a>
        <a href="/vtc-beaulieu-sur-mer" class="text-dark hover-gold">VTC Beaulieu</a>
        <a href="/vtc-monaco" class="text-dark hover-gold">VTC Monaco</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
