---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Grasse – Chauffeur Privé Capitale du Parfum | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Grasse, capitale mondiale du parfum. Parfumeries Fragonard, Molinard, Galimard. Ateliers création, Route Napoléon. Transferts Cannes Premium.";
const keywords = [
  'VTC Grasse',
  'chauffeur privé Grasse',
  'VTC parfumeries Grasse',
  'transfert Cannes Grasse',
  'excursion parfums Côte Azur',
  'VTC Fragonard Molinard'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-grasse"
  canonical="/vtc-grasse"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Grasse", url: "/vtc-grasse" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Pourquoi Grasse est-elle la capitale du parfum ?","acceptedAnswer":{"@type":"Answer","text":"Depuis le XVIIe siècle, Grasse cultive des fleurs (jasmin, rose, tubéreuse) et maîtrise l'art de l'extraction des essences. Les maisons Fragonard, Molinard et Galimard y sont nées."}},{"@type":"Question","name":"Peut-on créer son propre parfum ?","acceptedAnswer":{"@type":"Answer","text":"Oui ! Plusieurs parfumeries proposent des ateliers où vous composez votre parfum unique guidé par un professionnel. Expérience inoubliable."}},{"@type":"Question","name":"Grasse est-elle proche de Cannes ?","acceptedAnswer":{"@type":"Answer","text":"Grasse est à 17 km de Cannes, soit environ 25 minutes en VTC. L'excursion parfaite depuis la Croisette."}}]}}
>
  <PageHero 
    title="VTC Grasse"
    subtitle="La capitale mondiale du parfum. Découvrez Fragonard, Molinard, Galimard et créez votre propre fragrance."
    backgroundImage="/assets/img/guides/villages-perches.webp"
    badge="PARFUMERIES • ATELIERS CRÉATION"
  />

  <main id="main-content" class="page-content">
    
    <!-- INTRO -->
    <SectionImageText
      title="Votre Chauffeur Privé à Grasse"
      image="/assets/img/services/service-business.webp"
      alt="Grasse capitale parfum vue panoramique"
      imageSide="right"
      ctaText="Réserver une excursion"
      ctaLink="/reservation"
    >
      <p>
        <strong>Grasse</strong> est la <strong>capitale mondiale du parfum</strong> depuis le XVIIe siècle. Cette ville perchée aux portes de la Provence abrite les maisons légendaires <strong>Fragonard, Molinard et Galimard</strong>, où les "nez" créent les fragrances les plus prestigieuses.
      </p>
      <p>
        ECOFUNDRIVE vous propose des excursions aux parfumeries avec possibilité de <strong>créer votre propre parfum</strong>, une expérience unique. Service attente inclus.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Cannes : 25 min</span>
        <span class="distance-badge">📍 Mougins : 15 min</span>
        <span class="distance-badge">📍 Nice : 45 min</span>
        <span class="distance-badge">📍 Aéroport : 50 min</span>
      </div>
    </SectionImageText>

    <!-- PARFUMERIES -->
    <section class="parfum-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">🌸 Les Grandes Parfumeries</h2>
        <div class="parfum-grid">
          <div class="parfum-card">
            <span class="parfum-icon">💐</span>
            <h3>Fragonard</h3>
            <p>La plus célèbre. Visite gratuite complète, musée du parfum et boutique. Atelier création possible.</p>
            <span class="parfum-tag">⭐ Incontournable</span>
          </div>
          <div class="parfum-card">
            <span class="parfum-icon">🧪</span>
            <h3>Galimard</h3>
            <p>Les meilleurs ateliers de création. Devenez apprenti parfumeur et repartez avec votre flacon unique.</p>
            <span class="parfum-tag">🎓 Ateliers</span>
          </div>
          <div class="parfum-card">
            <span class="parfum-icon">🌹</span>
            <h3>Molinard</h3>
            <p>Charme intimiste et authentique. Parfums rares et savoirs-faire traditionnels depuis 1849.</p>
            <span class="parfum-tag">♥️ Intimiste</span>
          </div>
        </div>
        <div class="text-center mt-lg">
          <a href="/reservation" class="btn-gold-dark">Réserver le circuit parfumeries</a>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Nos Services VTC à Grasse</h2>
      <div class="services-grid">
        <div class="service-card">
          <span class="service-icon">🌸</span>
          <h3>Circuit des Parfumeries</h3>
          <p>Visite Fragonard, Molinard et/ou Galimard avec temps d'attente. Atelier création possible.</p>
        </div>
        <div class="service-card">
          <span class="service-icon">🎬</span>
          <h3>Navettes Festival Cannes</h3>
          <p>Transferts Cannes ↔ Grasse pendant le Festival. Évasion parfumée depuis la Croisette.</p>
        </div>
        <div class="service-card">
          <span class="service-icon">🛤️</span>
          <h3>Route Napoléon</h3>
          <p>Départ de la Route Napoléon vers les Alpes. Circuit historique légendaire de 325 km.</p>
        </div>
        <div class="service-card">
          <span class="service-icon">✈️</span>
          <h3>Transferts Aéroport</h3>
          <p>Navettes aéroport Nice ↔ Grasse pour les voyageurs du Pays Grassois.</p>
        </div>
      </div>
    </section>

    <!-- HIGHLIGHTS -->
    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez Grasse</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/hero/hero-ete.webp"
          alt="Champs fleurs Grasse"
          title="🌷 Champs de Fleurs"
          description="Jasmin, rose de mai, tubéreuse... Les fleurs qui font la renommée mondiale des parfums de Grasse."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/about/vehicule-premium.webp"
          alt="Vieille ville Grasse"
          title="🏛️ Vieille Ville"
          description="Ruelles médiévales, cathédrale Notre-Dame-du-Puy, panoramas sur la Côte d'Azur."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/services/service-aeroport.webp"
          alt="Route Napoléon"
          title="🛤️ Route Napoléon"
          description="Le trajet de Napoléon de retour de l'Île d'Elbe en 1815. Paysages alpins spectaculaires."
          link="/reservation"
        />
      </div>
    </section>

    <!-- FAQ -->
    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Questions Fréquentes</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-question">Combien de temps pour visiter une parfumerie ?</h3>
          <div class="faq-answer">
            <p>Comptez <strong>1h à 1h30 par parfumerie</strong>. Pour un atelier de création de parfum, prévoyez 2h supplémentaires.</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Quelle parfumerie recommandez-vous ?</h3>
          <div class="faq-answer">
            <p><strong>Fragonard</strong> pour la visite complète. <strong>Galimard</strong> pour les ateliers. <strong>Molinard</strong> pour l'intimité. Ou les trois !</p>
          </div>
        </div>
        <div class="faq-item">
          <h3 class="faq-question">Peut-on créer son propre parfum ?</h3>
          <div class="faq-answer">
            <p>Oui ! <strong>Ateliers de création</strong> où vous composez votre parfum unique guidé par un professionnel. Réservation conseillée.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre Excursion Parfums</h2>
        <p>Découvrez les secrets des parfumeurs de Grasse avec votre chauffeur privé.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver l'excursion</a>
          <a href="https://wa.me/33616552811" class="btn-outline">Devis WhatsApp</a>
        </div>
        <p class="cta-price">À partir de <strong>90€</strong> depuis Cannes</p>
      </div>
    </section>

    <!-- NEARBY -->
    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-mougins" class="text-dark hover-gold">VTC Mougins</a>
        <a href="/vtc-cannes" class="text-dark hover-gold">VTC Cannes</a>
        <a href="/vtc-vence" class="text-dark hover-gold">VTC Vence</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-antibes" class="text-dark hover-gold">VTC Antibes</a>
        <a href="/vtc-saint-paul-de-vence" class="text-dark hover-gold">VTC Saint-Paul</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  
  .section-title {
    font-size: 2rem;
    color: #1a1a1a;
    position: relative;
  }
  
  .section-title::after {
    content: '';
    display: block;
    width: 60px;
    height: 3px;
    background: #d4af37;
    margin: 1rem auto 0;
  }
  
  /* DISTANCES */
  .distances {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  
  .distance-badge {
    background: rgba(212, 175, 55, 0.1);
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 500;
  }
  
  /* PARFUM SECTION */
  .parfum-section {
    background: linear-gradient(135deg, #0a0c17 0%, #1a1a2e 100%);
    margin: 3rem 0;
  }
  
  .parfum-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  
  @media (max-width: 768px) {
    .parfum-grid {
      grid-template-columns: 1fr;
    }
  }
  
  .parfum-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s;
    position: relative;
  }
  
  .parfum-card:hover {
    transform: translateY(-5px);
    border-color: #d4af37;
  }
  
  .parfum-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 1rem;
  }
  
  .parfum-card h3 {
    color: #d4af37;
    margin-bottom: 0.75rem;
  }
  
  .parfum-card p {
    color: #aaa;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  
  .parfum-tag {
    display: inline-block;
    background: rgba(212, 175, 55, 0.2);
    color: #d4af37;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  
  .btn-gold-dark {
    background: linear-gradient(135deg, #d4af37, #f0d78c);
    color: #000;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s;
  }
  
  .btn-gold-dark:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
  }
  
  /* SERVICES GRID */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  
  @media (max-width: 992px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 600px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
  
  .service-card {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
    box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    border: 1px solid #eee;
    transition: all 0.3s;
  }
  
  .service-card:hover {
    transform: translateY(-5px);
    border-color: rgba(212, 175, 55, 0.3);
  }
  
  .service-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 1rem;
  }
  
  .service-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    color: #1a1a1a;
  }
  
  .service-card p {
    color: #666;
    font-size: 0.9rem;
    margin: 0;
  }
  
  /* CTA */
  .cta-premium {
    background: linear-gradient(135deg, #0a0c17 0%, #1a1a2e 100%);
    border-radius: 20px;
    padding: 4rem 2rem;
    text-align: center;
    color: white;
    position: relative;
  }
  
  .cta-premium::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, #d4af37, transparent);
  }
  
  .cta-premium h2 {
    color: white;
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  
  .cta-premium p {
    color: #aaa;
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto 2rem;
  }
  
  .cta-price {
    margin-top: 1.5rem;
    color: #d4af37 !important;
    font-size: 1.1rem !important;
  }
  
  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .btn-gold {
    background: linear-gradient(135deg, #d4af37, #f0d78c);
    color: #000;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s;
  }
  
  .btn-gold:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
  }
  
  .btn-outline {
    border: 2px solid #d4af37;
    color: #d4af37;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
  }
  
  .btn-outline:hover {
    background: #d4af37;
    color: #000;
  }
</style>
