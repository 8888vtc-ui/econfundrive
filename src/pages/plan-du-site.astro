---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Plan du Site | ECOFUNDRIVE VTC Côte d'Azur";
const description = "Plan du site ECOFUNDRIVE. Retrouvez toutes nos pages : services VTC, zones d'intervention, guides touristiques et informations pratiques.";

const sections = [
  {
    title: "Pages Principales",
    links: [
      { name: "Accueil", url: "/" },
      { name: "Réserver un VTC", url: "/reservation" },
      { name: "Nos Services", url: "/services" },
      { name: "Tarifs", url: "/tarifs" },
      { name: "A Propos", url: "/a-propos" },
      { name: "Avis Clients", url: "/avis-clients" },
      { name: "Contact", url: "/contact" }
    ]
  },
  {
    title: "Nos Zones d'Intervention",
    links: [
      { name: "VTC Nice", url: "/vtc-nice" },
      { name: "VTC Cannes", url: "/vtc-cannes" },
      { name: "VTC Monaco", url: "/vtc-monaco" },
      { name: "VTC Antibes", url: "/vtc-antibes" },
      { name: "VTC Saint-Tropez", url: "/vtc-saint-tropez" },
      { name: "VTC Sophia-Antipolis", url: "/vtc-sophia-antipolis" },
      { name: "VTC Fréjus / Saint-Raphaël", url: "/vtc-frejus-saint-raphael" },
      { name: "VTC Villeneuve-Loubet", url: "/vtc-villeneuve-loubet" },
      { name: "VTC Menton", url: "/vtc-menton" },
      { name: "VTC Grasse", url: "/vtc-grasse" },
      { name: "VTC Èze", url: "/vtc-eze" },
      { name: "VTC Cap Ferrat", url: "/vtc-cap-ferrat" },
      { name: "VTC Beaulieu-sur-Mer", url: "/vtc-beaulieu-sur-mer" },
      { name: "VTC Villefranche-sur-Mer", url: "/vtc-villefranche-sur-mer" },
      { name: "VTC Cagnes-sur-Mer", url: "/vtc-cagnes-sur-mer" },
      { name: "VTC Saint-Laurent-du-Var", url: "/vtc-saint-laurent-du-var" },
      { name: "VTC Vence", url: "/vtc-vence" },
      { name: "VTC Saint-Paul-de-Vence", url: "/vtc-saint-paul-de-vence" },
      { name: "VTC Mougins", url: "/vtc-mougins" },
      { name: "VTC Mandelieu-la-Napoule", url: "/vtc-mandelieu-la-napoule" },
      { name: "VTC Roquebrune-Cap-Martin", url: "/vtc-roquebrune-cap-martin" },
      { name: "VTC La Turbie", url: "/vtc-la-turbie" },
      { name: "VTC Vallauris Golfe-Juan", url: "/vtc-vallauris-golfe-juan" },
      { name: "VTC Juan-les-Pins", url: "/vtc-juan-les-pins" },
      { name: "VTC Biot", url: "/vtc-biot" }
    ]
  },
  {
    title: "Transferts Aéroports",
    links: [
      { name: "VTC Aéroport Nice Prix", url: "/vtc-aeroport-nice-prix" },
      { name: "VTC ou Taxi Aéroport Nice ?", url: "/guide-vtc-ou-taxi-aeroport-nice" },
      { name: "Transfert Nice - Monaco", url: "/transfert-nice-aeroport-monaco" },
      { name: "Transfert Nice - Cannes", url: "/transfert-nice-aeroport-cannes" },
      { name: "Transfert Nice - Saint-Tropez", url: "/transfert-nice-aeroport-saint-tropez" },
      { name: "Transfert Cannes - Saint-Tropez", url: "/transfert-cannes-saint-tropez" },
      { name: "Comparatif VTC vs Taxi vs Uber", url: "/comparatif-vtc-taxi-uber-nice" }
    ]
  },
  {
    title: "Événements & Salons",
    links: [
      { name: "VTC Festival de Cannes", url: "/guide-vtc-festival-cannes" },
      { name: "VTC MIPIM Cannes 2025", url: "/vtc-mipim-cannes" },
      { name: "VTC Carnaval de Nice 2025", url: "/vtc-carnaval-nice" },
      { name: "VTC Grand Prix Monaco", url: "/guide-grand-prix-monaco-deplacements" },
      { name: "VTC Congrès Cannes", url: "/guide-congres-cannes-deplacements" }
    ]
  },
  {
    title: "Guides & Conseils",
    links: [
      { name: "Tous nos guides", url: "/guides" },
      { name: "Guide : Que faire à Nice ?", url: "/guide-que-faire-a-nice-1-3-jours" },
      { name: "Guide : Que faire à Cannes ?", url: "/guide-que-faire-a-cannes" },
      { name: "Guide : Monaco en 1 jour", url: "/guide-monaco-en-une-journee" },
      { name: "Guide : Saint-Tropez", url: "/guide-decouvrir-saint-tropez-golfe" },
      { name: "Guide : Villages Perchés", url: "/guide-villages-perches-cote-d-azur" },
      { name: "Choisir son VTC", url: "/guide-choisir-vtc-cote-azur" }
    ]
  }
];
---

<BaseLayout title={title} description={description} canonical="/plan-du-site">
  <main id="main-content" class="container py-xl">
    <h1 class="text-center mb-xl">Plan du Site</h1>
    
    <div class="grid-2-cols">
      {sections.map(section => (
        <div class="mb-lg">
          <h2 class="h3 mb-md text-gold">{section.title}</h2>
          <ul class="list-unstyled">
            {section.links.map(link => (
              <li class="mb-sm">
                <a href={link.url} class="text-dark hover-gold font-medium">
                  → {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </main>
</BaseLayout>
