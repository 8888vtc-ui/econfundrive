---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Saint-Paul-de-Vence – Chauffeur Privé Village d'Art | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Saint-Paul-de-Vence. Village d'artistes, Fondation Maeght, galeries d'art, hôtels de charme. Transferts depuis Nice et Cannes. Service premium.";
const keywords = [
  'VTC Saint-Paul-de-Vence',
  'chauffeur privé Saint-Paul',
  'VTC Fondation Maeght',
  'transfert Saint-Paul-de-Vence',
  'chauffeur village artistes'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-saint-paul-de-vence"
  canonical="/vtc-saint-paul-de-vence"
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Saint-Paul-de-Vence", url: "/vtc-saint-paul-de-vence" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien coûte un VTC de Nice à Saint-Paul-de-Vence ?","acceptedAnswer":{"@type":"Answer","text":"Le transfert Nice → Saint-Paul-de-Vence coûte environ 45-55€. Le village est situé à 20 km de Nice dans l'arrière-pays."}},{"@type":"Question","name":"Proposez-vous des transferts pour les mariages à Saint-Paul-de-Vence ?","acceptedAnswer":{"@type":"Answer","text":"Oui, Saint-Paul-de-Vence est une destination prisée pour les mariages. Nous proposons des services VTC premium avec véhicules décorés sur demande."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    <SectionImageText
      title="Votre Chauffeur Privé à Saint-Paul-de-Vence"
      image="/assets/img/destinations/destination-nice.png"
      alt="VTC chauffeur privé Saint-Paul-de-Vence"
      imageSide="right"
      ctaText="Réserver votre VTC"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        <strong>Saint-Paul-de-Vence</strong> est l'un des plus beaux villages perchés de France, véritable joyau de la Côte d'Azur. Ce village médiéval fortifié a séduit les plus grands artistes du XXe siècle : Picasso, Matisse, Chagall, et bien d'autres y ont séjourné et travaillé.
      </p>
      <p class="fade-in-section">
        Avec la <strong>Fondation Maeght</strong>, l'une des plus importantes collections d'art moderne d'Europe, ses galeries d'art, ses restaurants gastronomiques et ses hôtels de charme, Saint-Paul-de-Vence est une destination incontournable.
      </p>
      <p class="fade-in-section">
        ECOFUNDRIVE vous propose un <strong>service VTC premium à Saint-Paul-de-Vence</strong> : transferts depuis Nice ou l'aéroport, circuits touristiques, ou service mariage haut de gamme.
      </p>
      <ul class="fade-in-section">
        <li>Transferts aéroport Nice - Saint-Paul (25-35 min)</li>
        <li>Visite de la Fondation Maeght</li>
        <li>Circuit villages perchés (Vence, Tourrettes, Gourdon)</li>
        <li>Service VTC mariage à Saint-Paul-de-Vence</li>
        <li>Dîner à La Colombe d'Or (restaurant mythique)</li>
      </ul>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tarifs VTC Saint-Paul-de-Vence</h2>
      <table class="tarif-table">
        <thead>
          <tr><th>Destination</th><th>Distance</th><th>Durée</th><th>Tarif estimé</th></tr>
        </thead>
        <tbody>
          <tr><td>Aéroport Nice → Saint-Paul-de-Vence</td><td>22 km</td><td>25-35 min</td><td>50€</td></tr>
          <tr><td>Nice Centre → Saint-Paul</td><td>18 km</td><td>20-30 min</td><td>45€</td></tr>
          <tr><td>Cannes → Saint-Paul</td><td>25 km</td><td>30-40 min</td><td>60€</td></tr>
          <tr><td>Monaco → Saint-Paul</td><td>35 km</td><td>40-50 min</td><td>85€</td></tr>
          <tr><td>Saint-Paul → Vence</td><td>5 km</td><td>10 min</td><td>20€</td></tr>
          <tr><td>Circuit Villages Perchés (journée)</td><td>-</td><td>8h</td><td>450€</td></tr>
        </tbody>
      </table>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Découvrez Saint-Paul-de-Vence</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/destination-nice.png"
          alt="Fondation Maeght"
          title="Fondation Maeght"
          description="L'un des plus importants musées d'art moderne d'Europe, avec des œuvres de Miró, Giacometti, Chagall et bien d'autres."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-nice.png"
          alt="Village Saint-Paul"
          title="Le Village Médiéval"
          description="Ruelles pavées, remparts du XVIe siècle, places ombragées et vue panoramique sur la Méditerranée."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-nice.png"
          alt="La Colombe d'Or"
          title="La Colombe d'Or"
          description="Restaurant légendaire où Picasso et Matisse payaient leurs repas avec des tableaux. Collection d'art exceptionnelle."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-vence" class="text-dark hover-gold">VTC Vence</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-cagnes-sur-mer" class="text-dark hover-gold">VTC Cagnes-sur-Mer</a>
        <a href="/guide-villages-perches-cote-d-azur" class="text-dark hover-gold">Villages Perchés</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .tarif-table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  .tarif-table th, .tarif-table td { padding: 0.75rem; text-align: left; border-bottom: 1px solid #eee; }
  .tarif-table th { background: #f5f5f5; font-weight: 600; }
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
