---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Saint-Paul-de-Vence – Chauffeur Privé Village d'Art | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Saint-Paul-de-Vence. Village d'art, Fondation Maeght, galeries, restaurants. Entre Nice et Cannes. Service premium.";
const keywords = ['VTC Saint-Paul-de-Vence', 'chauffeur privé village art', 'transfert Fondation Maeght', 'VTC galeries Saint-Paul'];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-saint-paul-de-vence"
  canonical="/vtc-saint-paul-de-vence"
  keywords={keywords}
  breadcrumbItems={[{ name: "Accueil", url: "/" }, { name: "Services", url: "/services" }, { name: "VTC Saint-Paul-de-Vence", url: "/vtc-saint-paul-de-vence" }]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Pourquoi Saint-Paul-de-Vence est-elle célèbre ?","acceptedAnswer":{"@type":"Answer","text":"Village médiéval devenu capitale de l'art moderne. Fondation Maeght, 70+ galeries, La Colombe d'Or fréquentée par Picasso, Chagall, Matisse."}},{"@type":"Question","name":"Est-ce praticable avec poussette ?","acceptedAnswer":{"@type":"Answer","text":"Le village est piétonnier avec pavés. Le stationnement est à l'extérieur. Notre VTC vous dépose au plus près de l'entrée."}}]}}
>
  <PageHero title="VTC Saint-Paul-de-Vence" subtitle="Le village des artistes. Fondation Maeght, 70+ galeries, ruelles médiévales et vue panoramique." backgroundImage="/assets/img/guides/villages-perches.webp" badge="VILLAGE D'ART • FONDATION MAEGHT" />

  <main id="main-content" class="page-content">
    <SectionImageText title="Le Village des Artistes" image="/assets/img/fun-buzz/OIPblack.jpg" alt="VTC Saint-Paul-de-Vence" imageSide="right" ctaText="Réserver un transfert" ctaLink="/reservation">
      <p class="fade-in-section"><strong>Saint-Paul-de-Vence</strong> est le village d'art le plus célèbre de la Côte d'Azur. Picasso, Chagall, Matisse, Prévert... Les artistes ont fait de ce village perché leur refuge. La <strong>Fondation Maeght</strong> est l'un des plus importants musées d'art moderne d'Europe.</p>
      <p class="fade-in-section">Le stationnement étant à l'extérieur du village, un VTC est idéal : nous vous déposons au plus près et revenons vous chercher.</p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Nice : 25 min</span>
        <span class="distance-badge">📍 Cannes : 30 min</span>
        <span class="distance-badge">📍 Vence : 5 min</span>
      </div>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez Saint-Paul</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/fun-buzz/DB2022AU00771_web_1600.jpg" alt="Fondation Maeght" title="🖼️ Fondation Maeght" description="Miró, Giacometti, Chagall... L'un des plus importants musées d'art moderne d'Europe." link="/reservation" />
        <CategoryCard image="/assets/img/guides/villages-perches.webp" alt="Ruelles Saint-Paul" title="🏘️ Ruelles Médiévales" description="Remparts, fontaines, 70+ galeries d'art. Un village-musée à ciel ouvert." link="/reservation" />
        <CategoryCard image="/assets/img/fun-buzz/OIP.jpg" alt="Colombe d'Or" title="🕊️ La Colombe d'Or" description="Auberge légendaire où les artistes payaient en tableaux. Collection exceptionnelle." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC à Saint-Paul</h2>
        <p>Art, histoire et panoramas. Profitez du village sans contrainte de parking.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-vence" class="text-dark hover-gold">VTC Vence</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-cagnes-sur-mer" class="text-dark hover-gold">VTC Cagnes</a>
        <a href="/vtc-grasse" class="text-dark hover-gold">VTC Grasse</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #00b0f0; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(0, 176, 240, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; font-size: 2rem; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #00b0f0, #66d0f7); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #00b0f0; color: #00b0f0; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
