---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

import PricingRequest from '../components/PricingRequest.astro';
const title = "VTC Saint-Paul-de-Vence – Chauffeur Privé Village d'Art | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à Saint-Paul-de-Vence. Village d'artistes, Fondation Maeght, galeries d'art, hôtels de charme. Transferts depuis Nice et Cannes. Service premium.";
const keywords = [
  'VTC Saint-Paul-de-Vence',
  'chauffeur privé Saint-Paul',
  'VTC Fondation Maeght',
  'transfert Saint-Paul-de-Vence',
  'chauffeur village artistes'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-saint-paul-de-vence"
  canonical="/vtc-saint-paul-de-vence"
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC Saint-Paul-de-Vence", url: "/vtc-saint-paul-de-vence" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien coûte un VTC de Nice à Saint-Paul-de-Vence ?","acceptedAnswer":{"@type":"Answer","text":"Nos tarifs sont personnalisés selon le véhicule choisi, l'horaire et le niveau de service. Contactez-nous pour un devis gratuit et sans engagement."}},{"@type":"Question","name":"Proposez-vous des transferts pour les mariages à Saint-Paul-de-Vence ?","acceptedAnswer":{"@type":"Answer","text":"Oui, Saint-Paul-de-Vence est une destination prisée pour les mariages. Nous proposons des services VTC premium avec véhicules décorés sur demande."}}]}}
>
  <main id="main-content">
    <div class="container py-lg">
      <h1 class="text-center mb-lg">{title}</h1>
      <p class="lead text-center mb-xl">{description}</p>
    </div>

    
    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Tarifs & Devis</h2>
      <PricingRequest />
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="text-center mb-lg">Découvrez Saint-Paul-de-Vence</h2>
      <div class="grid-3-cols">
        <CategoryCard
          image="/assets/img/destinations/destination-nice.png"
          alt="Fondation Maeght"
          title="Fondation Maeght"
          description="L'un des plus importants musées d'art moderne d'Europe, avec des œuvres de Miró, Giacometti, Chagall et bien d'autres."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-nice.png"
          alt="Village Saint-Paul"
          title="Le Village Médiéval"
          description="Ruelles pavées, remparts du XVIe siècle, places ombragées et vue panoramique sur la Méditerranée."
          link="/reservation"
        />
        <CategoryCard
          image="/assets/img/destinations/destination-nice.png"
          alt="La Colombe d'Or"
          title="La Colombe d'Or"
          description="Restaurant légendaire où Picasso et Matisse payaient leurs repas avec des tableaux. Collection d'art exceptionnelle."
          link="/reservation"
        />
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-vence" class="text-dark hover-gold">VTC Vence</a>
        <a href="/vtc-nice" class="text-dark hover-gold">VTC Nice</a>
        <a href="/vtc-cagnes-sur-mer" class="text-dark hover-gold">VTC Cagnes-sur-Mer</a>
        <a href="/guide-villages-perches-cote-d-azur" class="text-dark hover-gold">Villages Perchés</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
</style>
