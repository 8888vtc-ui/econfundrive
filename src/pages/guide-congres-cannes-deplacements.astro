---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "Transport Congrès Cannes VTC – MIPIM, Festival, Lions | ECOFUNDRIVE";
const description = "Chauffeur privé pour congrès à Cannes : MIPIM, Festival du Film, Cannes Lions. Transferts aéroport Nice, navettes et mise à disposition business.";
const keywords = [
  'VTC congrès Cannes',
  'chauffeur MIPIM Cannes',
  'transport Festival Cannes',
  'VTC Cannes Lions',
  'chauffeur privé business Cannes'
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": "https://www.ecofundrive.com/assets/img/services/service-business.webp",
  "author": { "@type": "Organization", "name": "ECOFUNDRIVE" }
};
---

<BaseLayout
  title={title}
  description={description}
  currentPage="guide-congres-cannes-deplacements"
  canonical="/guide-congres-cannes-deplacements"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Guides", url: "/guides" },
    { name: "Congrès à Cannes", url: "/guide-congres-cannes-deplacements" }
  ]}
  schema={schema}
>
  <PageHero 
    title="Cannes Business & Congrès"
    subtitle="MIPIM, Festival, Lions, ILTM... Votre partenaire transport pour tous les événements majeurs de la Croisette."
    backgroundImage="/assets/img/services/service-business.webp"
    badge="BUSINESS • CONGRÈS • VIP"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="L'Excellence Business"
      image="/assets/img/services/service-business.webp"
      alt="Chauffeur privé business class"
      imageSide="right"
      ctaText="Réserver un Chauffeur"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        À Cannes, le temps est précieux. Lors d'un congrès, chaque minute compte entre deux rendez-vous. Ne perdez pas de temps à chercher un taxi ou une place de parking.
      </p>
      <p class="fade-in-section">
        Nos chauffeurs professionnels maîtrisent parfaitement les accès au <strong>Palais des Festivals</strong>. À bord de nos Berlines S-Class ou Vans Mercedes, travaillez en toute sérénité (Wi-Fi, chargeurs, confidentialité) ou détendez-vous entre deux meetings.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">Briefing Chauffeur</span>
        <span class="distance-badge">Facturation Pro</span>
        <span class="distance-badge">Flotte Événementielle</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Calendrier des Congrès</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">🏗️</span><h3>MIPIM (Mars)</h3><p>Le RDV mondial de l'immobilier. Navettes villas Mougins ↔ Palais.</p></div>
          <div class="service-card"><span class="service-icon">🎬</span><h3>Festival de Cannes (Mai)</h3><p>Mise à disposition 24h/24 pour montées des marches et soirées.</p></div>
          <div class="service-card"><span class="service-icon">🦁</span><h3>Cannes Lions (Juin)</h3><p>Transport créatif. Navettes entre plages, hôtels et conférences.</p></div>
          <div class="service-card"><span class="service-icon">⛵</span><h3>Yachting Festival (Sept)</h3><p>Transferts VIP pour les acheteurs et exposants du salon nautique.</p></div>
        </div>
      </div>
    </section>

    <SectionImageText
      title="La Mise à Disposition"
      image="/assets/img/destinations/cannes-palais-festivals.webp"
      alt="Palais des Festivals Cannes"
      imageSide="left"
      ctaText="Devis à la journée"
      ctaLink="/contact"
    >
      <p class="fade-in-section">
        Pour une flexibilité totale, optez pour la <strong>mise à disposition</strong>. Votre chauffeur vous est dédié à la demi-journée, à la journée ou pour toute la durée du congrès.
      </p>
      <p class="fade-in-section">
        Il vous attend devant chaque lieu, garde vos affaires en sécurité et s'adapte à vos changements de programme de dernière minute. C'est l'atout productivité indispensable.
      </p>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Services Complémentaires</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/hero/hero-aeroport-nice.webp" alt="Aéroport Nice" title="✈️ Transfert Aéroport" description="Accueil pancarte à Nice (NCE) ou Cannes Mandelieu (CEQ). Suivi de vol en temps réel." link="/reservation" />
        <CategoryCard image="/assets/img/destinations/destination-monaco.png" alt="Dîners d'Affaires" title="🍽️ Dîners d'Affaires" description="Transport vers les restaurants étoilés de la région pour vos repas clients." link="/reservation" />
        <CategoryCard image="/assets/img/services/service-business.png" alt="Roadshows" title="📈 Roadshows" description="Organisation logistique complexe pour vos tournées de présentation." link="/contact" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Optimisez votre Congrès</h2>
        <p>Réservez votre logistique transport à l'avance.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="/contact" class="btn-outline">Devis Entreprise</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Voir Aussi</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-cannes" class="text-dark hover-gold">VTC Cannes</a>
        <a href="/vtc-entreprise-cote-azur" class="text-dark hover-gold">Offre Entreprise</a>
        <a href="/transfert-nice-aeroport-cannes" class="text-dark hover-gold">Nice → Cannes</a>
        <a href="/vtc-mipim-cannes" class="text-dark hover-gold">Spécial MIPIM</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(212, 175, 55, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #d4af37; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(212, 175, 55, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #d4af37; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #d4af37, #f0d78c); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #d4af37; color: #d4af37; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
