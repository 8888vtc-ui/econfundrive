---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC Longue Distance Nice - Lyon, Milan, Genève | ECOFUNDRIVE";
const description = "Transferts VTC longue distance depuis Nice. Liaisons confort business vers Lyon, Milan, Genève, Marseille. Prix fixes, véhicule premium, chauffeur dédié.";
const keywords = [
  'VTC longue distance Nice',
  'chauffeur Nice Milan',
  'transfert Nice Lyon VTC',
  'VTC Nice Genève',
  'taxi longue distance Nice'
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Transfert Longue Distance VTC",
  "provider": { "@type": "Organization", "name": "ECOFUNDRIVE" },
  "areaServed": ["France", "Italy", "Switzerland", "Monaco"],
  "description": "Service de chauffeur privé pour trajets interurbains et internationaux."
};
---

<BaseLayout
  title={title}
  description={description}
  currentPage="guide-vtc-longue-distance"
  canonical="/guide-vtc-longue-distance"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Guides", url: "/guides" },
    { name: "Longue Distance", url: "/guide-vtc-longue-distance" }
  ]}
  schema={schema}
>
  <PageHero 
    title="Voyages Longue Distance"
    subtitle="Lyon, Milan, Genève... Parcourez l'Europe dans le confort absolu de nos véhicules premium. Une alternative first-class au train et à l'avion."
    backgroundImage="/assets/img/fun-buzz/OIPint.jpg"
    badge="FRANCE • ITALIE • SUISSE"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Pourquoi le VTC Longue Distance ?"
      image="/assets/img/fun-buzz/OIPint.jpg"
      alt="Voyage affaire van fun premium"
      imageSide="right"
      ctaText="Calculer mon Tarif"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        Oubliez les grèves, les retards de train, les contrôles de sécurité interminables et la foule des aéroports. Le <strong>VTC longue distance</strong> est la solution ultime pour voyager sereinement.
      </p>
      <p class="fade-in-section">
        Votre chauffeur vous récupère à votre porte et vous dépose à destination sans rupture de charge. Profitez du trajet pour travailler (Wi-Fi à bord) ou vous reposer. Vous restez maître de votre emploi du temps : pause café quand vous voulez, ajustement de l'itinéraire, pas d'horaire imposé.
      </p>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Trajets Phares & Tarifs Indicatifs</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">🇮🇹</span><h3>Nice → Milan</h3><p>~300 km / 3h30. Pour la Fashion Week ou les affaires. Traversée scénique des Alpes.<br><small>Dès 450€</small></p></div>
          <div class="service-card"><span class="service-icon">🇫🇷</span><h3>Nice → Lyon</h3><p>~470 km / 4h30. Connexion TGV ou business. Départ matinal recommandé.<br><small>Dès 550€</small></p></div>
          <div class="service-card"><span class="service-icon">🇨🇭</span><h3>Nice → Genève</h3><p>~550 km / 5h30. Centre financier. Voyagez en classe affaires sur la route.<br><small>Dès 650€</small></p></div>
          <div class="service-card"><span class="service-icon">⚓</span><h3>Nice → Marseille</h3><p>~200 km / 2h15. Rendez-vous régional ou aéroport Marignane.<br><small>Dès 280€</small></p></div>
        </div>
      </div>
    </section>

    <SectionImageText
      title="Confort & Services à Bord"
      image="/assets/img/fun-buzz/681263469_10241088269927762_2493126442291772736_n.jpg"
      alt="Intérieur véhicule premium"
      imageSide="left"
      ctaText="Voir nos Véhicules"
      ctaLink="/services"
    >
      <p class="fade-in-section">
        Nos véhicules sont conçus pour les longs trajets. Van ID Buzzs Van VW ID Buzz/S ou Volkswagen ID Buzz pour le silence, Vans Classe V pour l'espace.
      </p>
      <ul class="fade-in-section">
        <li>Connexion Wi-Fi 4G/5G pour rester connecté.</li>
        <li>Prises USB et chargeurs pour vos appareils.</li>
        <li>Bouteilles d'eau minérale à disposition.</li>
        <li>Sièges cuir confortables et climatisation multi-zone.</li>
        <li>Grand coffre pour tous vos bagages (Van recommandé si >3 valises).</li>
      </ul>
    </SectionImageText>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Prêt pour le Grand Voyage ?</h2>
        <p>Demandez un devis forfaitaire immédiat pour votre destination.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Devis Gratuit</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Autres Services</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/services" class="text-dark hover-gold">Mise à Disposition</a>
        <a href="/vtc-aeroport-nice-prix" class="text-dark hover-gold">Transfert Aéroport</a>
        <a href="/guide-vtc-ski-auron-isola" class="text-dark hover-gold">Transfert Ski</a>
        <a href="/contact" class="text-dark hover-gold">Nous Contacter</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #00b0f0; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(0, 176, 240, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(0, 176, 240, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #00b0f0; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .service-card small { display: block; margin-top: 0.5rem; color: #fff; font-weight: 700; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #00b0f0, #66d0f7); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #00b0f0; color: #00b0f0; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
