---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionImageText from '../components/SectionImageText.astro';
import CategoryCard from '../components/CategoryCard.astro';

const title = "VTC La Turbie – Chauffeur Privé Trophée des Alpes | ECOFUNDRIVE";
const description = "Chauffeur privé VTC à La Turbie. Trophée des Alpes, vue panoramique Monaco, Grande Corniche. Circuit légendaire. Transferts premium 24/7.";
const keywords = [
  'VTC La Turbie',
  'chauffeur privé La Turbie',
  'VTC Trophée des Alpes',
  'transfert Monaco La Turbie',
  'VTC Grande Corniche'
];
---

<BaseLayout 
  title={title}
  description={description}
  currentPage="vtc-la-turbie"
  canonical="/vtc-la-turbie"
  keywords={keywords}
  breadcrumbItems={[
    { name: "Accueil", url: "/" },
    { name: "Services", url: "/services" },
    { name: "VTC La Turbie", url: "/vtc-la-turbie" }
  ]}
  schema={{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Pourquoi visiter La Turbie ?","acceptedAnswer":{"@type":"Answer","text":"Pour le Trophée des Alpes, monument romain unique, et la vue spectaculaire sur Monaco."}},{"@type":"Question","name":"C'est la route de Grace Kelly ?","acceptedAnswer":{"@type":"Answer","text":"Oui, la Grande Corniche qui traverse La Turbie est célèbre pour ses paysages de cinéma."}}]}}
>
  <PageHero 
    title="VTC La Turbie"
    subtitle="Le balcon de Monaco. Trophée d'Auguste, village médiéval et la légendaire Grande Corniche."
    backgroundImage="/assets/img/destinations/destination-monaco.webp"
    badge="GRANDE CORNICHE • TROPHÉE ROMAIN"
  />

  <main id="main-content" class="page-content">
    
    <SectionImageText
      title="Sur la Grande Corniche"
      image="/assets/img/destinations/destination-monaco.webp"
      alt="VTC La Turbie"
      imageSide="right"
      ctaText="Réserver un transfert"
      ctaLink="/reservation"
    >
      <p class="fade-in-section">
        Perchée à 450m au-dessus de <strong>Monaco</strong>, La Turbie offre l'un des plus beaux panoramas de la Côte d'Azur. Son <strong>Trophée des Alpes</strong>, monument romain vieux de 2000 ans, est un vestige unique.
      </p>
      <p class="fade-in-section">
        ECOFUNDRIVE vous emmène sur la <strong>Grande Corniche</strong> pour un circuit inoubliable avec vue plongeante sur la mer, ou pour un dîner romantique face aux lumières de Monte-Carlo.
      </p>
      <div class="distances fade-in-section">
        <span class="distance-badge">📍 Monaco : 15 min</span>
        <span class="distance-badge">📍 Èze : 10 min</span>
        <span class="distance-badge">📍 Nice : 25 min</span>
      </div>
    </SectionImageText>

    <section class="services-section">
      <div class="container py-xl fade-in-section">
        <h2 class="section-title text-center mb-xl" style="color: white;">Services La Turbie</h2>
        <div class="services-grid">
          <div class="service-card"><span class="service-icon">🏛️</span><h3>Trophée Romain</h3><p>Visite du monument d'Auguste avec attente chauffeur.</p></div>
          <div class="service-card"><span class="service-icon">🛣️</span><h3>Grande Corniche</h3><p>Circuit panoramique légendaire Nice-Monaco.</p></div>
          <div class="service-card"><span class="service-icon">🍽️</span><h3>Dîner Vue Mer</h3><p>Transfert vers les restaurants panoramiques.</p></div>
          <div class="service-card"><span class="service-icon">⚽</span><h3>Centre Entraînement</h3><p>Accès au centre de l'AS Monaco à La Turbie.</p></div>
        </div>
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <h2 class="section-title text-center mb-xl">Découvrez La Turbie</h2>
      <div class="grid-3-cols">
        <CategoryCard image="/assets/img/destinations/destination-monaco.webp" alt="Trophée des Alpes" title="🏛️ Trophée des Alpes" description="Impressionnant monument romain (6 av. J.-C.) célébrant la victoire d'Auguste. Musée et parc." link="/reservation" />
        <CategoryCard image="/assets/img/fun-buzz/OIPhh.jpg" alt="Vue Monaco" title="👀 Vue Monaco" description="Le point de vue 'Tête de Chien' offre la vue la plus spectaculaire sur la Principauté." link="/reservation" />
        <CategoryCard image="/assets/img/destinations/destination-nice.webp" alt="Grande Corniche" title="🛣️ Grande Corniche" description="La route mythique du cinéma ('La Main au Collet'). Un balcon sur la Méditerranée." link="/reservation" />
      </div>
    </section>

    <section class="container py-xl fade-in-section">
      <div class="cta-premium">
        <h2>Réservez votre VTC à La Turbie</h2>
        <p>Histoire romaine, paysages de cinéma ou soirée à Monaco.</p>
        <div class="cta-buttons">
          <a href="/reservation" class="btn-gold">Réserver</a>
          <a href="https://wa.me/33616552811" class="btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="container py-lg bg-gold-light rounded-lg fade-in-section">
      <h3 class="h4 mb-md text-center">Destinations VTC à proximité</h3>
      <div class="grid-4-cols-responsive text-sm text-center">
        <a href="/vtc-monaco" class="text-dark hover-gold">VTC Monaco</a>
        <a href="/vtc-eze" class="text-dark hover-gold">VTC Èze</a>
        <a href="/vtc-menton" class="text-dark hover-gold">VTC Menton</a>
        <a href="/vtc-beaulieu-sur-mer" class="text-dark hover-gold">VTC Beaulieu</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .bg-gold-light { background: rgba(0, 176, 240, 0.1); }
  .section-title { font-size: 2rem; color: #1a1a1a; position: relative; }
  .section-title::after { content: ''; display: block; width: 60px; height: 3px; background: #00b0f0; margin: 1rem auto 0; }
  .distances { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .distance-badge { background: rgba(0, 176, 240, 0.1); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; }
  .services-section { background: linear-gradient(135deg, #0a0c17, #1a1a2e); margin: 3rem 0; }
  .services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }
  .service-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(0, 176, 240, 0.3); border-radius: 16px; padding: 2rem; text-align: center; }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .service-card h3 { color: #00b0f0; margin-bottom: 0.75rem; }
  .service-card p { color: #aaa; font-size: 0.9rem; margin: 0; }
  .cta-premium { background: linear-gradient(135deg, #0a0c17, #1a1a2e); border-radius: 20px; padding: 4rem 2rem; text-align: center; color: white; }
  .cta-premium h2 { color: white; margin-bottom: 1rem; }
  .cta-premium p { color: #aaa; margin: 0 auto 2rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-gold { background: linear-gradient(135deg, #00b0f0, #66d0f7); color: #000; padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; }
  .btn-outline { border: 2px solid #00b0f0; color: #00b0f0; padding: 1rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
